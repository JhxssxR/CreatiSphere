<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CreatiSphere.Views.Creator.CreatorMessagesPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid ColumnDefinitions="240, 320, *">

        <!-- ===== CREATOR SIDEBAR ===== -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" BackgroundColor="#111827">
            
            <!-- Brand Logo -->
            <VerticalStackLayout Grid.Row="0" Padding="24,32" Spacing="4">
                <HorizontalStackLayout Spacing="12">
                    <Border BackgroundColor="#0D9488" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 8">
                        <Label Text="◈" TextColor="White" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="CreatiSphere" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="CREATOR PORTAL" TextColor="#4B5563" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" Margin="44,0,0,0" />
            </VerticalStackLayout>

            <!-- Nav Items -->
            <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="12,0">
                
                <!-- Dashboard -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDashboardTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M3,13h8V3H3V13z M3,21h8v-6H3V21z M13,21h8V11h-8V21z M13,3v6h8V3H13z" Fill="#9CA3AF" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Dashboard" TextColor="#9CA3AF" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Asset Library -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAssetLibraryTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,6h-8l-2-2H4C2.9,4,2,4.9,2,6v12c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V8C22,6.9,21.1,6,20,6z" Fill="#9CA3AF" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Asset Library" TextColor="#9CA3AF" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Commissions -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCommissionsTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M10,17L5,12l1.41-1.41L10,14.17l7.59-7.59L19,8L10,17z" Fill="#9CA3AF" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Commissions" TextColor="#9CA3AF" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Catalog Manager -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCatalogManagerTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M12,1L3,5v6c0,5.55,3.84,10.74,9,12c5.16-1.26,9-6.45,9-12V5L12,1z" Fill="#9CA3AF" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Catalog Manager" TextColor="#9CA3AF" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Messages (Active) -->
                <Border BackgroundColor="#1F2937" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,2H4C2.9,2,2,2.9,2,4v18l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z" Fill="#0D9488" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Messages" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <BoxView HeightRequest="40" Color="Transparent" />

                <!-- Upload New Art Button -->
                <Button Text="Upload New Art" Clicked="OnUploadNewArtClicked" BackgroundColor="#0D9488" TextColor="White" CornerRadius="8" HeightRequest="44" FontAttributes="Bold" Margin="4,0">
                    <Button.ImageSource>
                        <FontImageSource Glyph="+" FontFamily="FontAwesome" Size="16" />
                    </Button.ImageSource>
                </Button>

            </VerticalStackLayout>

            <!-- Bottom Items -->
            <VerticalStackLayout Grid.Row="2" Padding="12,24" Spacing="4">
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z" Fill="#9CA3AF" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Settings" TextColor="#9CA3AF" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignOutTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M17,7l-1.41,1.41L18.17,11H8v2h10.17l-2.58,2.58L17,17l5-5L17,7z M4,5h8V3H4C2.9,3,2,3.9,2,5v14c0,1.1,0.9,2,2,2h8v-2H4V5z" Fill="#9CA3AF" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Sign Out" TextColor="#9CA3AF" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Creator Profile -->
                <Grid Padding="12,20,12,0" ColumnDefinitions="Auto, *, Auto">
                    <Border HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="#0D9488">
                        <Label x:Name="ProfileInitialsLabel" Text="CR" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0">
                        <Label x:Name="ProfileNameLabel" Text="Creator Account" TextColor="White" FontSize="12" FontAttributes="Bold" />
                        <Label x:Name="ProfileRoleLabel" Text="Creator" TextColor="#6B7280" FontSize="10" />
                    </VerticalStackLayout>
                    <Path Grid.Column="2" Data="M12,8c1.1,0,2-0.9,2-2s-0.9-2-2-2s-2,0.9-2,2S10.9,8,12,8z M12,10c-1.1,0-2,0.9-2,2s0.9,2,2,2s2-0.9,2-2S13.1,10,12,10z M12,16 c-1.1,0-2,0.9-2,2s0.9,2,2,2s2-0.9,2-2S13.1,16,12,16z" Fill="#6B7280" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Grid>

        <!-- ===== MIDDLE COLUMN: CONVERSATIONS LIST ===== -->
        <Border Grid.Column="1" StrokeThickness="0,0,1,0" Stroke="#E2E8F0" BackgroundColor="White" Padding="0">
            <Grid RowDefinitions="Auto, *">
                <VerticalStackLayout Grid.Row="0" Padding="24,32" Spacing="24">
                    <Label Text="Conversations" TextColor="#0F172A" FontSize="24" FontAttributes="Bold" />
                    
                    <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" Padding="16,0" HeightRequest="48">
                        <Grid ColumnDefinitions="20, *">
                            <Path Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16 c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5 S11.99,14,9.5,14z" Fill="#94A3B8" Aspect="Uniform" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="Search chats..." PlaceholderColor="#94A3B8" TextColor="#0F172A" FontSize="14" Margin="12,0,0,0" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Conversation List -->
                <ScrollView Grid.Row="1">
                    <VerticalStackLayout>
                        <!-- Active conversation item -->
                        <Border x:Name="ConversationItem" BackgroundColor="#F0FDFA" StrokeThickness="0" Padding="20,16" IsVisible="False">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnConversationTapped" /></Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border HeightRequest="44" WidthRequest="44" StrokeShape="RoundRectangle 22" BackgroundColor="#6366F1" StrokeThickness="0">
                                    <Label Text="AH" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" Padding="12,0,0,0" VerticalOptions="Center">
                                    <Label Text="Alex Henderson" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                                    <Label x:Name="LastMessagePreview" Text="Tap to view messages..." TextColor="#64748B" FontSize="12" LineBreakMode="TailTruncation" MaximumWidthRequest="180" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center" HorizontalOptions="End">
                                    <Label x:Name="LastMessageTime" Text="" TextColor="#94A3B8" FontSize="10" HorizontalOptions="End" />
                                    <Border x:Name="UnreadBadge" BackgroundColor="#0D9488" StrokeShape="RoundRectangle 10" StrokeThickness="0" HeightRequest="20" WidthRequest="20" HorizontalOptions="End" IsVisible="False">
                                        <Label x:Name="UnreadCount" Text="1" TextColor="White" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                        <BoxView HeightRequest="1" Color="#E2E8F0" />
                        
                        <!-- Empty state (shown when no messages) -->
                        <VerticalStackLayout x:Name="EmptyChatState" VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Opacity="0.8" Padding="0,80">
                            <Border BackgroundColor="#F0FDFA" HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 24" HorizontalOptions="Center">
                                <Path Data="M20,2H4C2.9,2,2,2.9,2,4v18l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z M20,16H5.17L4,17.17V4h16V16z M7,9h10v2H7V9z M7,12h7v2H7V12z" 
                                      Fill="#0D9488" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="NO ACTIVE CHATS" TextColor="#64748B" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" HorizontalOptions="Center" />
                                <Label Text="Your messaging history will appear here&#10;once a customer contacts you." 
                                       TextColor="#94A3B8" FontSize="11" HorizontalTextAlignment="Center" HorizontalOptions="Center" LineHeight="1.4" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>

        <!-- ===== RIGHT COLUMN: CHAT AREA / EMPTY STATE ===== -->
        <Grid Grid.Column="2" RowDefinitions="*, Auto" BackgroundColor="#F8FAFC">
            
            <!-- Chat UI -->
            <Grid Grid.Row="0" RowDefinitions="Auto, *, Auto">
                <!-- Chat Header -->
                <Border Grid.Row="0" StrokeThickness="0,0,0,1" Stroke="#E2E8F0" BackgroundColor="White" Padding="24,16">
                    <HorizontalStackLayout Spacing="16">
                        <Border HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 24" BackgroundColor="#0D9488">
                            <Label Text="AH" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Alex Henderson" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" />
                            <Label Text="Active now" TextColor="#10B981" FontSize="12" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <!-- Chat History -->
                <CollectionView Grid.Row="1" x:Name="ChatCollectionView" Margin="0,16" ItemsUpdatingScrollMode="KeepLastItemInView">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="24,8">
                                <Border HorizontalOptions="{Binding Alignment}" 
                                        BackgroundColor="{Binding BackgroundColor}" 
                                        StrokeThickness="0" 
                                        StrokeShape="RoundRectangle 16" 
                                        Padding="16,12" 
                                        MaximumWidthRequest="500">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Text}" TextColor="{Binding TextColor}" FontSize="15" />
                                        <Label Text="{Binding Timestamp, StringFormat='{0:t}'}" 
                                               TextColor="{Binding TextColor}" 
                                               Opacity="0.7" 
                                               FontSize="11" 
                                               HorizontalOptions="End" 
                                               Margin="0,4,0,0"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Message Input -->
                <Border Grid.Row="2" BackgroundColor="White" StrokeThickness="1,0,0,0" Stroke="#E2E8F0" Padding="24,16,24,24">
                    <Grid ColumnDefinitions="*, Auto">
                        <Border BackgroundColor="#F1F5F9" StrokeThickness="0" StrokeShape="RoundRectangle 24" Padding="16,4">
                            <Entry x:Name="MessageEntry" Placeholder="Type a message..." BackgroundColor="Transparent" TextColor="#0F172A" Completed="OnSendMessageTapped" />
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="#0D9488" HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 24" StrokeThickness="0" Margin="16,0,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSendMessageTapped" />
                            </Border.GestureRecognizers>
                            <Path Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" Fill="White" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Page Footer -->
            <Border Grid.Row="1" StrokeThickness="0,1,0,0" Stroke="#E2E8F0" BackgroundColor="White" Padding="24,16">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="© 2024 CreatiSphere. All rights reserved." TextColor="#64748B" FontSize="12" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="24" VerticalOptions="Center">
                        <Label Text="Terms" TextColor="#64748B" FontSize="12" />
                        <Label Text="Privacy" TextColor="#64748B" FontSize="12" />
                        <Label Text="Support" TextColor="#64748B" FontSize="12" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
