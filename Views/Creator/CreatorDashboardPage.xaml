<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CreatiSphere.Views.Creator.CreatorDashboardPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid ColumnDefinitions="240, *">

        <!-- ===== CREATOR SIDEBAR ===== -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" BackgroundColor="#111827">
            
            <!-- Brand Logo -->
            <VerticalStackLayout Grid.Row="0" Padding="24,32" Spacing="4">
                <HorizontalStackLayout Spacing="12">
                    <Border BackgroundColor="#0D9488" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 8">
                        <Label Text="◈" TextColor="White" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="CreatiSphere" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="CREATOR PORTAL" TextColor="#4B5563" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" Margin="44,0,0,0" />
            </VerticalStackLayout>

            <!-- Nav Items -->
            <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="12,0">
                
                <!-- Dashboard (Active) -->
                <Border BackgroundColor="#1F2937" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M3,13h8V3H3V13z M3,21h8v-6H3V21z M13,21h8V11h-8V21z M13,3v6h8V3H13z" Fill="#0D9488" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Dashboard" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Asset Library -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAssetLibraryTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,6h-8l-2-2H4C2.9,4,2,4.9,2,6v12c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V8C22,6.9,21.1,6,20,6z" Fill="#9CA3AF" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Asset Library" TextColor="#9CA3AF" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Commissions -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCommissionsTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M10,17L5,12l1.41-1.41L10,14.17l7.59-7.59L19,8L10,17z" Fill="#9CA3AF" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Commissions" TextColor="#9CA3AF" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Catalog Manager -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCatalogManagerTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M12,1L3,5v6c0,5.55,3.84,10.74,9,12c5.16-1.26,9-6.45,9-12V5L12,1z" Fill="#9CA3AF" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Catalog Manager" TextColor="#9CA3AF" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Messages -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMessagesTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,2H4C2.9,2,2,2.9,2,4v18l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z" Fill="#9CA3AF" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Messages" TextColor="#9CA3AF" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <BoxView HeightRequest="40" Color="Transparent" />

                <!-- Upload New Art Button -->
                <Button Text="Upload New Art" Clicked="OnQuickUploadClicked" BackgroundColor="#0D9488" TextColor="White" CornerRadius="8" HeightRequest="44" FontAttributes="Bold" Margin="4,0">
                    <Button.ImageSource>
                        <FontImageSource Glyph="+" FontFamily="FontAwesome" Size="16" />
                    </Button.ImageSource>
                </Button>

            </VerticalStackLayout>

            <!-- Bottom Items -->
            <VerticalStackLayout Grid.Row="2" Padding="12,24" Spacing="4">
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z" Fill="#9CA3AF" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Settings" TextColor="#9CA3AF" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignOutTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M17,7l-1.41,1.41L18.17,11H8v2h10.17l-2.58,2.58L17,17l5-5L17,7z M4,5h8V3H4C2.9,3,2,3.9,2,5v14c0,1.1,0.9,2,2,2h8v-2H4V5z" Fill="#9CA3AF" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Sign Out" TextColor="#9CA3AF" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Creator Profile -->
                <Grid Padding="12,20,12,0" ColumnDefinitions="Auto, *, Auto">
                    <Border HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="#0D9488">
                        <Label x:Name="SidebarProfileInitialsLabel" Text="CR" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0">
                        <Label x:Name="ProfileNameLabel" Text="Creator Account" TextColor="White" FontSize="12" FontAttributes="Bold" />
                        <Label x:Name="ProfileRoleLabel" Text="Creator" TextColor="#6B7280" FontSize="10" />
                    </VerticalStackLayout>
                    <Path Grid.Column="2" Data="M12,8c1.1,0,2-0.9,2-2s-0.9-2-2-2s-2,0.9-2,2S10.9,8,12,8z M12,10c-1.1,0-2,0.9-2,2s0.9,2,2,2s2-0.9,2-2S13.1,10,12,10z M12,16 c-1.1,0-2,0.9-2,2s0.9,2,2,2s2-0.9,2-2S13.1,16,12,16z" Fill="#6B7280" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Grid>

        <!-- ===== MAIN CONTENT ===== -->
        <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="40" Spacing="32">
                
                <!-- Header with Search -->
                <Grid ColumnDefinitions="*, Auto">
                    <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" Padding="16,0" HeightRequest="44" MaximumWidthRequest="400" HorizontalOptions="Start">
                        <Grid ColumnDefinitions="20, *">
                            <Path Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16 c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5 S11.99,14,9.5,14z" Fill="#94A3B8" Aspect="Uniform" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="Search orders, assets..." PlaceholderColor="#94A3B8" TextColor="#0F172A" FontSize="13" Margin="12,0,0,0" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <HorizontalStackLayout Grid.Column="1" Spacing="20" VerticalOptions="Center">
                        <Grid>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNotificationsTapped" />
                            </Grid.GestureRecognizers>
                            <Path Data="M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-0.83-0.67-1.5-1.5-1.5 s-1.5,0.67-1.5,1.5v0.68C7.64,5.36,6,7.92,6,11v5l-2,2v1h16v-1L18,16z" Fill="#64748B" Aspect="Uniform" HeightRequest="20" WidthRequest="20" />
                        </Grid>
                        <Path Data="M20,2H4C2.9,2,2,2.9,2,4v18l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z" Fill="#64748B" Aspect="Uniform" HeightRequest="20" WidthRequest="20" />
                        <Border HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="#0D9488">
                            <Label x:Name="HeaderProfileInitialsLabel" Text="CR" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>
                <!-- Performance & Quick Upload Row -->
                <Grid ColumnDefinitions="2*, *" ColumnSpacing="24">
                    
                    <!-- Performance Chart Card -->
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="24">
                        <Grid RowDefinitions="Auto, *">
                            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,24">
                                <VerticalStackLayout>
                                    <Label Text="Sales Performance" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" />
                                    <Label Text="Asset revenue vs Commission fees" TextColor="#64748B" FontSize="12" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 8" Padding="12,6">
                                    <Label Text="Last 30 Days ▾" TextColor="#475569" FontSize="11" FontAttributes="Bold" />
                                </Border>
                            </Grid>
                            
                            <!-- Dynamic Chart from Database -->
                            <HorizontalStackLayout x:Name="SalesChartContainer" Grid.Row="1" Spacing="16" HorizontalOptions="Center" VerticalOptions="End">
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Quick Upload Card -->
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#064E3B" Padding="24">
                        <VerticalStackLayout Spacing="20">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Quick Upload" TextColor="White" FontSize="18" FontAttributes="Bold" />
                                <Label Text="Instantly list your latest creation to the Asset Library." TextColor="#A7F3D0" FontSize="12" LineHeight="1.4" />
                            </VerticalStackLayout>
                            
                            <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 12" Stroke="#0D9488" StrokeThickness="2" StrokeDashArray="4,2" HeightRequest="140" Padding="20">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnQuickUploadClicked" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center" Spacing="12">
                                    <Path Data="M19.35,10.04C18.67,6.59,15.64,4,12,4C9.11,4,6.6,5.64,5.35,8.04C2.34,8.36,0,10.91,0,14c0,3.31,2.69,6,6,6h13c2.76,0,5-2.24,5-5 C24,12.36,21.95,10.22,19.35,10.04z M14,13v4h-4v-4H7l5-5l5,5H14z" Fill="White" Aspect="Uniform" HeightRequest="32" WidthRequest="32" HorizontalOptions="Center" />
                                    <Label Text="Drag &amp; Drop Artwork" TextColor="White" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" />
                                    <Label Text="PNG, JPG, or SVG up to 50MB" TextColor="#A7F3D0" FontSize="11" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>

                            <Button Text="Browse Files" Clicked="OnQuickUploadClicked" BackgroundColor="White" TextColor="#064E3B" CornerRadius="8" HeightRequest="44" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Recent Custom Orders Table -->
                <VerticalStackLayout Spacing="20">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Recent Custom Orders" TextColor="#0F172A" FontSize="20" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="View All Commissions →" TextColor="#0D9488" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>

                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="0">
                        <VerticalStackLayout>
                            <!-- Table Header -->
                            <Grid ColumnDefinitions="2*, 1.5*, 1.2*, *, *, Auto" Padding="24,16" BackgroundColor="#F8FAFC">
                                <Label Text="PROJECT" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                                <Label Grid.Column="1" Text="CLIENT" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                                <Label Grid.Column="2" Text="DUE DATE" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                                <Label Grid.Column="3" Text="BUDGET" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                                <Label Grid.Column="4" Text="STATUS" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            </Grid>
                            
                        <CollectionView x:Name="CommissionsCollectionView">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="2*, 1.5*, 1.2*, *, *, Auto" Padding="24,20">
                                            <HorizontalStackLayout Spacing="12">
                                                <Border HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 4" BackgroundColor="#F1F5F9" StrokeThickness="0">
                                                    <Image Source="{Binding ImagePath}" Aspect="AspectFill" />
                                                </Border>
                                                <VerticalStackLayout VerticalOptions="Center">
                                                    <Label Text="{Binding Title}" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" />
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding ClientName}" TextColor="#475569" FontSize="13" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding Date}" TextColor="#475569" FontSize="13" VerticalOptions="Center" />
                                            <Label Grid.Column="3" Text="{Binding Price, StringFormat='₱{0:F2}'}" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Border Grid.Column="4" Padding="12,4" StrokeShape="RoundRectangle 12" StrokeThickness="0" HorizontalOptions="Start">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BackgroundColor" Value="#F1F5F9" />
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Briefing">
                                                                <Setter Property="BackgroundColor" Value="#EFF6FF" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Concept">
                                                                <Setter Property="BackgroundColor" Value="#FEF3C7" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Refining">
                                                                <Setter Property="BackgroundColor" Value="#F3E8FF" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Delivery">
                                                                <Setter Property="BackgroundColor" Value="#ECFDF5" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Label Text="{Binding Status}" FontSize="10" FontAttributes="Bold">
                                                    <Label.Style>
                                                        <Style TargetType="Label">
                                                            <Setter Property="TextColor" Value="#64748B" />
                                                            <Style.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Briefing">
                                                                    <Setter Property="TextColor" Value="#2563EB" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Concept">
                                                                    <Setter Property="TextColor" Value="#D97706" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Refining">
                                                                    <Setter Property="TextColor" Value="#7C3AED" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Delivery">
                                                                    <Setter Property="TextColor" Value="#059669" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Label.Style>
                                                </Label>
                                            </Border>
                                            <Label Grid.Column="5" Text="⋮" TextColor="#94A3B8" FontSize="18" VerticalOptions="Center" />
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="#F1F5F9" Margin="24,0" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Recent Revenue Transactions -->
                <VerticalStackLayout Spacing="20">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout>
                            <Label Text="Recent Revenue Transactions" TextColor="#0F172A" FontSize="20" FontAttributes="Bold" />
                            <Label Text="Real-time sales data from your database" TextColor="#64748B" FontSize="12" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1" BackgroundColor="#F0FDFA" StrokeShape="RoundRectangle 8" Padding="12,6" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <Path Data="M11.8,10.9c-2.27-0.59-3-1.2-3-2.15c0-1.09,1.01-1.85,2.7-1.85c1.78,0,2.44,0.85,2.5,2.1h2.21 c-0.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94,0.42-3.5,1.68-3.5,3.61c0,2.31,1.91,3.46,4.7,4.13c2.5,0.6,3,1.48,3,2.41 c0,0.69-0.49,1.79-2.7,1.79c-2.06,0-2.87-0.92-2.98-2.1h-2.2c0.12,2.19,1.76,3.42,3.68,3.83V21h3v-2.15 c1.95-0.37,3.5-1.5,3.5-3.55C16.5,12.46,14.07,11.49,11.8,10.9z" Fill="#0D9488" Aspect="Uniform" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                                <Label x:Name="TotalRevenueLabel" Text="₱0.00" TextColor="#0D9488" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="0">
                        <VerticalStackLayout>
                            <!-- Table Header -->
                            <Grid ColumnDefinitions="2*, 1.5*, *, *, Auto" Padding="24,16" BackgroundColor="#F8FAFC">
                                <Label Text="CUSTOMER" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                                <Label Grid.Column="1" Text="DATE" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                                <Label Grid.Column="2" Text="AMOUNT" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                                <Label Grid.Column="3" Text="STATUS" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            </Grid>

                            <CollectionView x:Name="TransactionsCollectionView">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout>
                                            <Grid ColumnDefinitions="2*, 1.5*, *, *, Auto" Padding="24,16">
                                                <HorizontalStackLayout Spacing="12">
                                                    <Border HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" BackgroundColor="#F0FDFA" StrokeThickness="0">
                                                        <Label Text="{Binding Initials}" TextColor="#0D9488" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                                    </Border>
                                                    <VerticalStackLayout VerticalOptions="Center">
                                                        <Label Text="{Binding CustomerName}" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" />
                                                        <Label Text="{Binding TransactionID}" TextColor="#94A3B8" FontSize="10" />
                                                    </VerticalStackLayout>
                                                </HorizontalStackLayout>
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                    <Label Text="{Binding DateDisplay}" TextColor="#475569" FontSize="12" />
                                                    <Label Text="{Binding TimeDisplay}" TextColor="#94A3B8" FontSize="10" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="2" Text="{Binding AmountDisplay}" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                                <Border Grid.Column="3" Padding="12,4" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{Binding StatusBg}" HorizontalOptions="Start" VerticalOptions="Center">
                                                    <Label Text="{Binding Status}" FontSize="10" FontAttributes="Bold" TextColor="{Binding StatusColor}" />
                                                </Border>
                                            </Grid>
                                            <BoxView HeightRequest="1" Color="#F1F5F9" Margin="24,0" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <VerticalStackLayout Padding="40" HorizontalOptions="Center">
                                        <Label Text="No transactions recorded yet" TextColor="#94A3B8" FontSize="14" HorizontalOptions="Center" />
                                        <Label Text="Transactions will appear here when customers make purchases" TextColor="#CBD5E1" FontSize="12" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="20">
                    <Label Text="Catalog Highlights" TextColor="#0F172A" FontSize="20" FontAttributes="Bold" />
                    
                    <CollectionView x:Name="PortfolioCollectionView">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="20" VerticalItemSpacing="20" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White">
                                    <VerticalStackLayout Padding="20" Spacing="16">
                                        <Border HeightRequest="140" StrokeShape="RoundRectangle 8" BackgroundColor="#F1F5F9" StrokeThickness="0">
                                            <Image Source="{Binding ImagePath}" Aspect="AspectFill" />
                                        </Border>
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding Title}" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                                            <Label Text="{Binding Sales, StringFormat='{0} Sales this week'}" TextColor="#64748B" FontSize="11" />
                                        </VerticalStackLayout>
                                        <Label Text="{Binding Price, StringFormat='₱{0:F2}'}" TextColor="#0D9488" FontSize="15" FontAttributes="Bold" HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Creator Portal Footer -->
                <Border StrokeThickness="1,0,0,0" Stroke="#E2E8F0" Padding="0,40,0,0" Margin="0,40,0,0">
                    <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto" RowSpacing="24">
                        <VerticalStackLayout Grid.Column="0" Spacing="12">
                            <Label Text="CreatiSphere" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" FontFamily="Georgia" />
                            <Label Text="Empowering creators to showcase their&#10;art to the world through a premium,&#10;curated canvas." TextColor="#64748B" FontSize="13" LineHeight="1.5" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="12">
                            <Label Text="PLATFORM" TextColor="#0F172A" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label Text="Marketplace" TextColor="#64748B" FontSize="13" />
                            <Label Text="Seller Guide" TextColor="#64748B" FontSize="13" />
                            <Label Text="Payouts" TextColor="#64748B" FontSize="13" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="12">
                            <Label Text="SUPPORT" TextColor="#0F172A" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label Text="Help Center" TextColor="#64748B" FontSize="13" />
                            <Label Text="API Docs" TextColor="#64748B" FontSize="13" />
                            <Label Text="Terms of Service" TextColor="#64748B" FontSize="13" />
                        </VerticalStackLayout>

                        <BoxView Grid.Row="1" Grid.ColumnSpan="3" HeightRequest="1" Color="#F1F5F9" />
                        
                        <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="*, Auto" Padding="0,20">
                            <Label Text="© 2026 CreatiSphere Inc. All rights reserved." TextColor="#94A3B8" FontSize="11" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="24">
                                <Label Text="Privacy Policy" TextColor="#94A3B8" FontSize="11" />
                                <Label Text="Cookie Settings" TextColor="#94A3B8" FontSize="11" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== QUICK UPLOAD MODAL OVERLAY ===== -->
        <Grid x:Name="QuickUploadModal" Grid.ColumnSpan="2" BackgroundColor="#800F172A" IsVisible="False" HorizontalOptions="Fill" VerticalOptions="Fill">
            <!-- Modal card container -->
            <Border StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White" WidthRequest="460" HorizontalOptions="Center" VerticalOptions="Center" Padding="32">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,10" Radius="30" Opacity="0.15" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="24">
                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Upload Asset Details" TextColor="#0F172A" FontSize="20" FontAttributes="Bold" />
                            <Label Text="Complete the details to list your asset" TextColor="#64748B" FontSize="13" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="✕" FontSize="16" FontAttributes="Bold" BackgroundColor="Transparent" TextColor="#64748B" Clicked="OnCancelQuickUploadClicked" HeightRequest="36" WidthRequest="36" Padding="0" CornerRadius="18" />
                    </Grid>

                    <!-- Image Preview / File Chooser -->
                    <Border HeightRequest="120" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8FAFC" Padding="12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnQuickChooseImageClicked" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *">
                            <Border HeightRequest="96" WidthRequest="96" StrokeShape="RoundRectangle 6" BackgroundColor="#E2E8F0" StrokeThickness="0">
                                <Image x:Name="QuickUploadPreviewImage" Source="nebula_dreamscape.png" Aspect="AspectFill" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="16,0,0,0" Spacing="4">
                                <Label x:Name="QuickFileNameLabel" Text="no_file_selected.png" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                <Label Text="Click to choose a different image" TextColor="#0D9488" FontSize="12" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Input Fields -->
                    <VerticalStackLayout Spacing="16">
                        <!-- Title Entry -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Asset Title" TextColor="#334155" FontSize="12" FontAttributes="Bold" />
                            <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#CBD5E1" BackgroundColor="White" Padding="12,4" HeightRequest="44">
                                <Entry x:Name="QuickAssetTitleEntry" Placeholder="e.g. Celestial Horizon" TextColor="#0F172A" FontSize="14" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                            <!-- Type Entry -->
                            <VerticalStackLayout Spacing="6">
                                <Label Text="File Type" TextColor="#334155" FontSize="12" FontAttributes="Bold" />
                                <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#CBD5E1" BackgroundColor="White" Padding="12,4" HeightRequest="44">
                                    <Entry x:Name="QuickAssetTypeEntry" Placeholder="e.g. PNG" TextColor="#0F172A" FontSize="14" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Price Entry -->
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="Price (₱)" TextColor="#334155" FontSize="12" FontAttributes="Bold" />
                                <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#CBD5E1" BackgroundColor="White" Padding="12,4" HeightRequest="44">
                                    <Entry x:Name="QuickAssetPriceEntry" Placeholder="0.00" Keyboard="Numeric" TextColor="#0F172A" FontSize="14" VerticalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="16" Margin="0,8,0,0">
                        <Button Text="Cancel" Clicked="OnCancelQuickUploadClicked" BackgroundColor="#F1F5F9" TextColor="#475569" CornerRadius="8" HeightRequest="44" FontAttributes="Bold" />
                        <Button Text="Upload Asset" Clicked="OnSaveQuickUploadClicked" BackgroundColor="#0D9488" TextColor="White" CornerRadius="8" HeightRequest="44" FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
        <!-- Notifications Modal -->
        <Grid x:Name="NotificationsOverlay" Grid.ColumnSpan="2" BackgroundColor="#20000000" IsVisible="False">
            <BoxView BackgroundColor="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseNotificationsTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#E2E8F0"
                    HorizontalOptions="End" VerticalOptions="Start" WidthRequest="380" Margin="0,70,30,0" Padding="0">
                <VerticalStackLayout>
                    <Grid Padding="20,16" BackgroundColor="#F8FAFC">
                        <Label Text="Notifications" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Text="✕" TextColor="#64748B" FontSize="16" HorizontalOptions="End" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseNotificationsTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#E2E8F0" />
                    <ScrollView MaximumHeightRequest="320">
                        <VerticalStackLayout x:Name="NotificationsContainer" Spacing="0">
                            <!-- Sample Notification Item -->
                            <Grid Padding="20,16" ColumnDefinitions="Auto, *, Auto">
                                <Border HeightRequest="8" WidthRequest="8" StrokeShape="RoundRectangle 4" BackgroundColor="#3B82F6" VerticalOptions="Start" Margin="0,6,12,0" StrokeThickness="0" />
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="New Commission Request" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                                    <Label Text="Alex Morgan requested a custom asset." TextColor="#475569" FontSize="13" />
                                    <Label Text="2 mins ago" TextColor="#94A3B8" FontSize="11" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Start">
                                    <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="8,4">
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMarkAsReadTapped" /></Border.GestureRecognizers>
                                        <Label Text="Read" TextColor="#64748B" FontSize="11" FontAttributes="Bold" />
                                    </Border>
                                    <Border BackgroundColor="#FEE2E2" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="8,4">
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDeleteNotificationTapped" /></Border.GestureRecognizers>
                                        <Label Text="Del" TextColor="#EF4444" FontSize="11" FontAttributes="Bold" />
                                    </Border>
                                </HorizontalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#F1F5F9" />
                        </VerticalStackLayout>
                    </ScrollView>
                    <BoxView HeightRequest="1" Color="#E2E8F0" />
                    <Button Text="Clear All" BackgroundColor="Transparent" TextColor="#EF4444" FontSize="13" FontAttributes="Bold" HeightRequest="44" CornerRadius="0" Clicked="OnClearAllNotificationsClicked" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
