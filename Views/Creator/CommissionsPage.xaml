<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:CreatiSphere.Converters"
             x:Class="CreatiSphere.Views.Creator.CommissionsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToInitialsConverter x:Key="StringToInitialsConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="240, *">

        <!-- ===== CREATOR SIDEBAR (Standardized) ===== -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" BackgroundColor="#111827">
            <!-- Brand Logo -->
            <VerticalStackLayout Grid.Row="0" Padding="24,32" Spacing="4">
                <HorizontalStackLayout Spacing="12">
                    <Border BackgroundColor="#0D9488" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 8">
                        <Label Text="◈" TextColor="White" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="CreatiSphere" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="CREATOR PORTAL" TextColor="#4B5563" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" Margin="44,0,0,0" />
            </VerticalStackLayout>

            <!-- Nav Items -->
            <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="12,0">
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDashboardTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M3,13h8V3H3V13z M3,21h8v-6H3V21z M13,21h8V11h-8V21z M13,3v6h8V3H13z" Fill="#9CA3AF" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Dashboard" TextColor="#9CA3AF" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnAssetLibraryTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,6h-8l-2-2H4C2.9,4,2,4.9,2,6v12c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V8C22,6.9,21.1,6,20,6z" Fill="#9CA3AF" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Asset Library" TextColor="#9CA3AF" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <Border BackgroundColor="#1F2937" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M10,17L5,12l1.41-1.41L10,14.17l7.59-7.59L19,8L10,17z" Fill="#0D9488" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Commissions" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCatalogManagerTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M12,1L3,5v6c0,5.55,3.84,10.74,9,12c5.16-1.26,9-6.45,9-12V5L12,1z" Fill="#9CA3AF" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Catalog Manager" TextColor="#9CA3AF" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <BoxView HeightRequest="40" Color="Transparent" />
                <Button Text="Upload New Art" BackgroundColor="#0D9488" TextColor="White" CornerRadius="8" HeightRequest="44" FontAttributes="Bold" Margin="4,0">
                    <Button.ImageSource><FontImageSource Glyph="+" FontFamily="FontAwesome" Size="16" /></Button.ImageSource>
                </Button>
            </VerticalStackLayout>

            <!-- User Profile Bottom -->
            <VerticalStackLayout Grid.Row="2" Padding="12,24" Spacing="4">
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z" Fill="#9CA3AF" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Settings" TextColor="#9CA3AF" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignOutTapped" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M17,7l-1.41,1.41L18.17,11H8v2h10.17l-2.58,2.58L17,17l5-5L17,7z M4,5h8V3H4C2.9,3,2,3.9,2,5v14c0,1.1,0.9,2,2,2h8v-2H4V5z" Fill="#9CA3AF" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Sign Out" TextColor="#9CA3AF" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <Grid Padding="12,20,12,0" ColumnDefinitions="Auto, *, Auto">
                    <Border HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="0"><Image Source="creator_avatar.png" Aspect="AspectFill" /></Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0">
                        <Label Text="Alex Rivera" TextColor="White" FontSize="12" FontAttributes="Bold" /><Label Text="Pro Creator" TextColor="#6B7280" FontSize="10" />
                    </VerticalStackLayout>
                    <Path Grid.Column="2" Data="M12,8c1.1,0,2-0.9,2-2s-0.9-2-2-2s-2,0.9-2,2S10.9,8,12,8z M12,10c-1.1,0-2,0.9-2,2s0.9,2,2,2s2-0.9,2-2S13.1,10,12,10z M12,16 c-1.1,0-2,0.9-2,2s0.9,2,2,2s2-0.9,2-2S13.1,16,12,16z" Fill="#6B7280" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Grid>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *">
            <!-- Top Bar -->
            <Grid Grid.Row="0" Padding="40,32" ColumnDefinitions="*, Auto">
                <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" Padding="16,0" HeightRequest="44" MaximumWidthRequest="400" HorizontalOptions="Start">
                    <Grid ColumnDefinitions="20, *">
                        <Path Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16 c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5 S11.99,14,9.5,14z" Fill="#94A3B8" Aspect="Uniform" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Placeholder="Search commissions or clients..." PlaceholderColor="#94A3B8" TextColor="#0F172A" FontSize="13" Margin="12,0,0,0" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <HorizontalStackLayout Grid.Column="1" Spacing="20" VerticalOptions="Center">
                    <Path Data="M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-0.83-0.67-1.5-1.5-1.5 s-1.5,0.67-1.5,1.5v0.68C7.64,5.36,6,7.92,6,11v5l-2,2v1h16v-1L18,16z" Fill="#64748B" Aspect="Uniform" HeightRequest="20" WidthRequest="20" />
                    <Path Data="M20,2H4C2.9,2,2,2.9,2,4v18l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z" Fill="#64748B" Aspect="Uniform" HeightRequest="20" WidthRequest="20" />
                    <Border HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 16" BackgroundColor="#E2E8F0" StrokeThickness="0" />
                </HorizontalStackLayout>
            </Grid>

            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Padding="40,0,40,40" Spacing="32">
                    
                    <!-- Header -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Commission Fulfillment" TextColor="#0F172A" FontSize="32" FontAttributes="Bold" />
                        <Label Text="Manage your custom requests and keep your clients updated." TextColor="#64748B" FontSize="15" />
                    </VerticalStackLayout>

                    <!-- Filter Tabs -->
                    <HorizontalStackLayout Spacing="16">
                        <Border BackgroundColor="#065F46" StrokeShape="RoundRectangle 20" Padding="16,8">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="All Commissions" TextColor="White" FontSize="13" FontAttributes="Bold" />
                                <Border BackgroundColor="#047857" StrokeShape="RoundRectangle 10" Padding="6,2"><Label Text="12" TextColor="White" FontSize="9" FontAttributes="Bold" /></Border>
                            </HorizontalStackLayout>
                        </Border>
                        <Border BackgroundColor="#E2E8F0" StrokeShape="RoundRectangle 20" Padding="16,8">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="New" TextColor="#475569" FontSize="13" FontAttributes="Bold" />
                                <Border BackgroundColor="#CBD5E1" StrokeShape="RoundRectangle 10" Padding="6,2"><Label Text="3" TextColor="#475569" FontSize="9" FontAttributes="Bold" /></Border>
                            </HorizontalStackLayout>
                        </Border>
                        <Border BackgroundColor="#E2E8F0" StrokeShape="RoundRectangle 20" Padding="16,8">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="In Progress" TextColor="#475569" FontSize="13" FontAttributes="Bold" />
                                <Border BackgroundColor="#CBD5E1" StrokeShape="RoundRectangle 10" Padding="6,2"><Label Text="5" TextColor="#475569" FontSize="9" FontAttributes="Bold" /></Border>
                            </HorizontalStackLayout>
                        </Border>
                        <Border BackgroundColor="#E2E8F0" StrokeShape="RoundRectangle 20" Padding="16,8">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Awaiting Feedback" TextColor="#475569" FontSize="13" FontAttributes="Bold" />
                                <Border BackgroundColor="#CBD5E1" StrokeShape="RoundRectangle 10" Padding="6,2"><Label Text="2" TextColor="#475569" FontSize="9" FontAttributes="Bold" /></Border>
                            </HorizontalStackLayout>
                        </Border>
                        <Border BackgroundColor="#E2E8F0" StrokeShape="RoundRectangle 20" Padding="16,8">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="Delivered" TextColor="#475569" FontSize="13" FontAttributes="Bold" />
                                <Border BackgroundColor="#CBD5E1" StrokeShape="RoundRectangle 10" Padding="6,2"><Label Text="2" TextColor="#475569" FontSize="9" FontAttributes="Bold" /></Border>
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Main Commission Dashboard Row -->
                    <Grid ColumnDefinitions="2*, *" ColumnSpacing="24">
                        
                        <!-- List Column -->
                        <VerticalStackLayout Grid.Column="0" Spacing="24">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Active Commissions" TextColor="#0F172A" FontSize="20" FontAttributes="Bold" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                    <Path Data="M3,18h6v-2H3V18z M3,6v2h18V6H3z M3,13h12v-2H3V13z" Fill="#64748B" Aspect="Uniform" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                                    <Label Text="Sort by Deadline" TextColor="#64748B" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>

                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White">
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="2*, *, *, *, Auto" Padding="20,16" BackgroundColor="#F8FAFC">
                                        <Label Text="CLIENT &amp; PROJECT" TextColor="#64748B" FontSize="10" FontAttributes="Bold" />
                                        <Label Grid.Column="1" Text="DEADLINE" TextColor="#64748B" FontSize="10" FontAttributes="Bold" />
                                        <Label Grid.Column="2" Text="PRICE" TextColor="#64748B" FontSize="10" FontAttributes="Bold" />
                                        <Label Grid.Column="3" Text="STATUS" TextColor="#64748B" FontSize="10" FontAttributes="Bold" />
                                    </Grid>

                                    <!-- Dynamic Rows -->
                                    <VerticalStackLayout x:Name="CommissionsListContainer" BindableLayout.ItemsSource="{Binding .}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <VerticalStackLayout>
                                                    <Grid ColumnDefinitions="2*, *, *, *, Auto" Padding="20">
                                                        <HorizontalStackLayout Spacing="12">
                                                            <Border HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 16" BackgroundColor="#E2E8F0" StrokeThickness="0">
                                                                <Label Text="{Binding ClientName, Converter={StaticResource StringToInitialsConverter}}" HorizontalOptions="Center" VerticalOptions="Center" FontSize="12" FontAttributes="Bold" TextColor="#0D9488" />
                                                            </Border>
                                                            <VerticalStackLayout VerticalOptions="Center">
                                                                <Label Text="{Binding ClientName}" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" />
                                                                <Label Text="{Binding Title}" TextColor="#64748B" FontSize="11" FontAttributes="Italic" />
                                                            </VerticalStackLayout>
                                                        </HorizontalStackLayout>
                                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                            <Label Text="{Binding Date}" TextColor="#475569" FontSize="12" />
                                                            <Label Text="Active" TextColor="#64748B" FontSize="10" />
                                                        </VerticalStackLayout>
                                                        <Label Grid.Column="2" Text="{Binding Price, StringFormat='${0:N0}'}" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                                        <Border Grid.Column="3" StrokeShape="RoundRectangle 12" Padding="10,4" HorizontalOptions="Start">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BackgroundColor" Value="#DBEAFE" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Delivery">
                                                                            <Setter Property="BackgroundColor" Value="#DCFCE7" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Label Text="{Binding Status}" FontSize="9" FontAttributes="Bold">
                                                                <Label.Style>
                                                                    <Style TargetType="Label">
                                                                        <Setter Property="TextColor" Value="#3B82F6" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Delivery">
                                                                                <Setter Property="TextColor" Value="#15803D" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Label.Style>
                                                            </Label>
                                                        </Border>
                                                        <HorizontalStackLayout Grid.Column="4" Spacing="12" VerticalOptions="Center">
                                                            <Path Data="M20,4H4C2.9,4,2,4.9,2,6v12c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V6C22,4.9,21.1,4,20,4z M18,8l-6,4L6,8V6l6,4l6,-4V8z" Fill="#64748B" Aspect="Uniform" HeightRequest="16" WidthRequest="16" />
                                                            <Border BackgroundColor="#0D9488" StrokeShape="RoundRectangle 4" Padding="8,4">
                                                                <Border.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="OnUpdateStatusClicked" CommandParameter="{Binding .}" />
                                                                </Border.GestureRecognizers>
                                                                <Label Text="Update" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                                            </Border>
                                                        </HorizontalStackLayout>
                                                    </Grid>
                                                    <BoxView HeightRequest="1" Color="#E2E8F0" />
                                                </VerticalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <Label Text="View All 12 Commissions" TextColor="#0D9488" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" Margin="0,16" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Preview Column -->
                        <VerticalStackLayout Grid.Column="1" Spacing="24">
                            <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="24">
                                <VerticalStackLayout Spacing="24">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="SELECTED PREVIEW" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                                        <Path Grid.Column="1" Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M13,17h-2v-2h2V17z M13,13h-2V7h2V13z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="16" WidthRequest="16" />
                                    </Grid>

                                    <Border HeightRequest="200" StrokeShape="RoundRectangle 12" BackgroundColor="#F8FAFC" StrokeThickness="0" />

                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="&quot;Celestial Garden Mural&quot;" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" />
                                        <Label Text="Commission for Elena Vance" TextColor="#0D9488" FontSize="13" FontAttributes="Bold" />
                                    </VerticalStackLayout>

                                    <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 12" Padding="20">
                                        <VerticalStackLayout Spacing="12">
                                            <Label Text="THE CLIENT BRIEF" TextColor="#475569" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" />
                                            <Label Text="&quot;I'm looking for a large-scale digital mural that combines cosmic nebula textures with lush, bioluminescent flora. The mood should be ethereal and calming, using deep teals and soft pinks...&quot;" 
                                                   TextColor="#334155" FontSize="13" LineHeight="1.5" FontAttributes="Italic" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <Grid ColumnDefinitions="*, *">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="DIMENSIONS" TextColor="#94A3B8" FontSize="9" FontAttributes="Bold" />
                                            <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 8" Padding="12,8">
                                                <Label Text="4000 × 6000 px" TextColor="#0F172A" FontSize="12" FontAttributes="Bold" />
                                            </Border>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4" Margin="12,0,0,0">
                                            <Label Text="FORMAT" TextColor="#94A3B8" FontSize="9" FontAttributes="Bold" />
                                            <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 8" Padding="12,8">
                                                <Label Text="TIFF / PSD" TextColor="#0F172A" FontSize="12" FontAttributes="Bold" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                        <Button Text="Send Update" BackgroundColor="#065F46" TextColor="White" CornerRadius="8" HeightRequest="44" FontAttributes="Bold" />
                                        <Border Grid.Column="1" BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" HeightRequest="44" WidthRequest="44">
                                            <Label Text="•••" TextColor="#0F172A" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,0,0,8" />
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#2D2D2D" Padding="24">
                                <VerticalStackLayout Spacing="16">
                                    <Label Text="EARNING PROJECTION" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="$4,250" TextColor="White" FontSize="28" FontAttributes="Bold" />
                                        <Label Text="~12%" TextColor="#10B981" FontSize="12" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <Label Text="Estimated revenue from all active commissions upon completion." TextColor="#94A3B8" FontSize="11" LineHeight="1.4" />
                                    
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Text="Progress Toward Monthly Goal" TextColor="#94A3B8" FontSize="10" />
                                            <Label Grid.Column="1" Text="85%" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                        </Grid>
                                        <Border HeightRequest="6" BackgroundColor="#404040" StrokeShape="RoundRectangle 3" StrokeThickness="0">
                                            <BoxView Color="#0D9488" HorizontalOptions="Start" WidthRequest="180" />
                                        </Border>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>

                    </Grid>

                    <!-- Upcoming Milestones -->
                    <VerticalStackLayout Spacing="20">
                        <Label Text="Upcoming Milestones" TextColor="#0F172A" FontSize="20" FontAttributes="Bold" />
                        
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="20">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="20">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Border BackgroundColor="#EEF2FF" HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                                        <Path Data="M3,17.25V21h3.75L17.81,9.94l-3.75-3.75L3,17.25z" Fill="#4F46E5" Aspect="Uniform" HeightRequest="16" WidthRequest="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Margin="16,0" Spacing="4">
                                        <Label Text="Sketch Review" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
