<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CreatiSphere.Views.Customer.TrackOrdersPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid ColumnDefinitions="220, *">

        <!-- ===== LEFT SIDEBAR ===== -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" BackgroundColor="#1A2332">

            <!-- Logo -->
            <HorizontalStackLayout Grid.Row="0" Padding="24,36,24,32" Spacing="12" VerticalOptions="Center">
                <Border BackgroundColor="#0D9488" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 10">
                    <Label Text="◈" TextColor="White" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="CreatiSphere" TextColor="White" FontSize="18" FontAttributes="Bold" FontFamily="Georgia" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Nav Items -->
            <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="12,0">

                <!-- Dashboard -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDashboardTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M3,13h8V3H3V13z M3,21h8v-6H3V21z M13,21h8V11h-8V21z M13,3v6h8V3H13z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Dashboard" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Explore -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExploreTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M12,2C8.13,2,5,5.13,5,9c0,5.25,7,13,7,13s7-7.75,7-13C19,5.13,15.87,2,12,2z M12,11.5c-1.38,0-2.5-1.12-2.5-2.5s1.12-2.5,2.5-2.5s2.5,1.12,2.5,2.5S13.38,11.5,12,11.5z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Explore" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Custom Orders -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCustomOrdersTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M17,13h-4v4h-2v-4H7v-2h4V7h2v4h4V13z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Custom Orders" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Track Orders (Active) -->
                <Border BackgroundColor="#0D9488" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,8h-3V4H3C1.9,4,1,4.9,1,6v11h2c0,1.66,1.34,3,3,3s3-1.34,3-3h6c0,1.66,1.34,3,3,3s3-1.34,3-3h2v-5L20,8z M6,18.5c-0.83,0-1.5-0.67-1.5-1.5S5.17,15.5,6,15.5S7.5,16.17,7.5,17S6.83,18.5,6,18.5z M19,9.5l1.96,2.5H17V9.5H19z M18,18.5c-0.83,0-1.5-0.67-1.5-1.5s0.67-1.5,1.5-1.5s1.5,0.67,1.5,1.5S18.83,18.5,18,18.5z"
                              Fill="White" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Track Orders" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Messages -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMessagesTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,2H4C2.9,2,2,2.9,2,4v18l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Messages" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Feedback -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFeedbackTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,2H4C2.9,2,2.01,2.9,2.01,4L2,22l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z M13,11h-2V5h2V11z M13,15h-2v-2h2V15z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Feedback" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Rewards -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRewardsTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M12,1L3,5v6c0,5.55,3.84,10.74,9,12c5.16-1.26,9-6.45,9-12V5L12,1z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Rewards" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>

            <!-- User Profile & Sign Out at Bottom -->
            <VerticalStackLayout Grid.Row="2" Padding="12,24" Spacing="4">
                <!-- User Profile -->
                <Grid Padding="8,12" ColumnDefinitions="Auto,*,Auto">
                    <Border HeightRequest="38" WidthRequest="38" StrokeShape="RoundRectangle 19" StrokeThickness="0" BackgroundColor="#0D9488">
                        <Label x:Name="ProfileInitialsLabel" Text="AH" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" Padding="10,0,0,0" VerticalOptions="Center">
                        <Label x:Name="ProfileNameLabel" Text="Alex Henderson" TextColor="White" FontSize="13" FontAttributes="Bold"/>
                        <Label x:Name="ProfileRoleLabel" Text="Artisanal Collector" TextColor="#64748B" FontSize="11"/>
                    </VerticalStackLayout>
                    <Path Grid.Column="2" Data="M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.1-1.6-5.6-4.5-6.3V4c0-0.8-0.7-1.5-1.5-1.5S10.5,3.2,10.5,4v0.7C7.6,5.4,6,7.9,6,11v5l-2,2v1h16v-1L18,16z"
                          Fill="#64748B" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                </Grid>

                <BoxView HeightRequest="1" Color="#2D3748" Margin="16,8" />

                <!-- Sign Out -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignOutTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M17,7l-1.41,1.41L18.17,11H8v2h10.17l-2.58,2.58L17,17l5-5L17,7z M4,5h8V3H4C2.9,3,2,3.9,2,5v14c0,1.1,0.9,2,2,2h8v-2H4V5z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Sign Out" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>

        </Grid>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *">
            <!-- Top Nav -->
            <Grid Grid.Row="0" Padding="32,24" BackgroundColor="White">
                <HorizontalStackLayout Spacing="24" HorizontalOptions="End" VerticalOptions="Center">
                    <Path Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" Fill="#64748B" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                    <Path Data="M11 18h2v-2h-2v2zm1-16C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-2.21 0-4 1.79-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.75-3 5h2c0-2.25 3-2.5 3-5 0-2.21-1.79-4-4-4z" Fill="#64748B" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="0" BackgroundColor="#F8FAFC">
                    
                    <!-- Header Section -->
                    <VerticalStackLayout Padding="48,40,48,32" Spacing="16">
                        <Label Text="Your Creative Journey" TextColor="#0F172A" FontSize="36" FontAttributes="Bold" />
                        <Label Text="Follow the evolution of your custom projects from the first brushstroke to the&#10;final masterpiece." TextColor="#64748B" FontSize="16" LineHeight="1.5" />
                    </VerticalStackLayout>

                    <!-- Main Content Wrapper -->
                    <VerticalStackLayout Padding="48,0,48,48" Spacing="24">
                        
                        <!-- Tabs -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#E2E8F0" Padding="4">
                                <HorizontalStackLayout Spacing="4">
                                    <Border BackgroundColor="White" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="24,8">
                                        <Label Text="Active" TextColor="#0D9488" FontSize="14" FontAttributes="Bold" />
                                    </Border>
                                    <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="24,8">
                                        <Label Text="Completed" TextColor="#64748B" FontSize="14" />
                                    </Border>
                                    <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 6" StrokeThickness="0" Padding="24,8">
                                        <Label Text="Drafts" TextColor="#64748B" FontSize="14" />
                                    </Border>
                                </HorizontalStackLayout>
                            </Border>
                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Path Data="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z" Fill="#64748B" Aspect="Uniform" HeightRequest="16" WidthRequest="16" />
                                <Label Text="Filter by Service" TextColor="#64748B" FontSize="14" />
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Commissions List -->
                        <VerticalStackLayout x:Name="CommissionsContainer" BindableLayout.ItemsSource="{Binding .}" Spacing="24">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White">
                                        <VerticalStackLayout>
                                            <Grid Padding="32" ColumnDefinitions="Auto, *, Auto">
                                                <Border WidthRequest="64" HeightRequest="64" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="#F1F5F9" VerticalOptions="Start">
                                                    <Label Text="◈" TextColor="#0D9488" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" Spacing="6" Padding="16,0,0,0">
                                                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                                        <Label Text="{Binding OrderID, StringFormat='#{0}'}" TextColor="#0F172A" FontSize="20" FontAttributes="Bold" />
                                                        <Border BackgroundColor="#CCFBF1" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12,4">
                                                            <Label Text="{Binding Status}" TextColor="#0D9488" FontSize="12" FontAttributes="Bold" />
                                                        </Border>
                                                    </HorizontalStackLayout>
                                                    <Label Text="{Binding Title}" TextColor="#475569" FontSize="14" FontAttributes="Bold" />
                                                    <Label Text="{Binding Date, StringFormat='Date Placed: {0}'}" TextColor="#64748B" FontSize="13" />
                                                </VerticalStackLayout>
                                                <HorizontalStackLayout Grid.Column="2" Spacing="12" VerticalOptions="Start">
                                                    <Button Text="Message Artist" BackgroundColor="Transparent" TextColor="#0F172A" BorderColor="#CBD5E1" BorderWidth="1" CornerRadius="6" Padding="16,10" FontAttributes="Bold" />
                                                    <Button Text="View Details" BackgroundColor="#0D9488" TextColor="White" CornerRadius="6" Padding="16,10" FontAttributes="Bold" Clicked="OnViewDetailsClicked" CommandParameter="{Binding .}" />
                                                </HorizontalStackLayout>
                                            </Grid>

                                            <!-- Progress Tracker (Simplified for Dynamic) -->
                                            <Grid Padding="32,0,32,32">
                                                <BoxView HeightRequest="2" Color="#E2E8F0" VerticalOptions="Center" Margin="30,0,30,12" />
                                                <Grid ColumnDefinitions="*,*,*,*">
                                                    <!-- Briefing Step -->
                                                    <VerticalStackLayout Grid.Column="0" Spacing="12" HorizontalOptions="Center">
                                                        <Border HeightRequest="24" WidthRequest="24" StrokeShape="RoundRectangle 12" StrokeThickness="0" HorizontalOptions="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BackgroundColor" Value="#F1F5F9" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Briefing"><Setter Property="BackgroundColor" Value="#0D9488" /></DataTrigger>
                                                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Concept"><Setter Property="BackgroundColor" Value="#0D9488" /></DataTrigger>
                                                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Refining"><Setter Property="BackgroundColor" Value="#0D9488" /></DataTrigger>
                                                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Delivery"><Setter Property="BackgroundColor" Value="#0D9488" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Path Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" HorizontalOptions="Center">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Fill" Value="#94A3B8" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger TargetType="Path" Binding="{Binding Status}" Value="Briefing"><Setter Property="Fill" Value="White" /></DataTrigger>
                                                                            <DataTrigger TargetType="Path" Binding="{Binding Status}" Value="Concept"><Setter Property="Fill" Value="White" /></DataTrigger>
                                                                            <DataTrigger TargetType="Path" Binding="{Binding Status}" Value="Refining"><Setter Property="Fill" Value="White" /></DataTrigger>
                                                                            <DataTrigger TargetType="Path" Binding="{Binding Status}" Value="Delivery"><Setter Property="Fill" Value="White" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Border>
                                                        <Label Text="Briefing" HorizontalOptions="Center">
                                                            <Label.Style>
                                                                <Style TargetType="Label">
                                                                    <Setter Property="TextColor" Value="#64748B" />
                                                                    <Setter Property="FontAttributes" Value="None" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Briefing">
                                                                            <Setter Property="TextColor" Value="#0D9488" />
                                                                            <Setter Property="FontAttributes" Value="Bold" />
                                                                        </DataTrigger>
                                                                        <!-- Keep highlighted if past this step -->
                                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Concept"><Setter Property="TextColor" Value="#0D9488" /></DataTrigger>
                                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Refining"><Setter Property="TextColor" Value="#0D9488" /></DataTrigger>
                                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Delivery"><Setter Property="TextColor" Value="#0D9488" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Label.Style>
                                                        </Label>
                                                    </VerticalStackLayout>

                                                    <!-- Concept Step -->
                                                    <VerticalStackLayout Grid.Column="1" Spacing="12" HorizontalOptions="Center">
                                                        <Border HeightRequest="24" WidthRequest="24" StrokeShape="RoundRectangle 12" StrokeThickness="0" HorizontalOptions="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BackgroundColor" Value="#F1F5F9" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Concept"><Setter Property="BackgroundColor" Value="#0D9488" /></DataTrigger>
                                                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Refining"><Setter Property="BackgroundColor" Value="#0D9488" /></DataTrigger>
                                                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Delivery"><Setter Property="BackgroundColor" Value="#0D9488" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" HorizontalOptions="Center">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Fill" Value="#94A3B8" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger TargetType="Path" Binding="{Binding Status}" Value="Concept"><Setter Property="Fill" Value="White" /></DataTrigger>
                                                                            <DataTrigger TargetType="Path" Binding="{Binding Status}" Value="Refining"><Setter Property="Fill" Value="White" /></DataTrigger>
                                                                            <DataTrigger TargetType="Path" Binding="{Binding Status}" Value="Delivery"><Setter Property="Fill" Value="White" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Border>
                                                        <Label Text="Concept" HorizontalOptions="Center">
                                                            <Label.Style>
                                                                <Style TargetType="Label">
                                                                    <Setter Property="TextColor" Value="#64748B" />
                                                                    <Setter Property="FontAttributes" Value="None" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Concept">
                                                                            <Setter Property="TextColor" Value="#0D9488" />
                                                                            <Setter Property="FontAttributes" Value="Bold" />
                                                                        </DataTrigger>
                                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Refining"><Setter Property="TextColor" Value="#0D9488" /></DataTrigger>
                                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Delivery"><Setter Property="TextColor" Value="#0D9488" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Label.Style>
                                                        </Label>
                                                    </VerticalStackLayout>

                                                    <!-- Refining Step -->
                                                    <VerticalStackLayout Grid.Column="2" Spacing="12" HorizontalOptions="Center">
                                                        <Border HeightRequest="24" WidthRequest="24" StrokeShape="RoundRectangle 12" StrokeThickness="0" HorizontalOptions="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BackgroundColor" Value="#F1F5F9" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Refining"><Setter Property="BackgroundColor" Value="#0D9488" /></DataTrigger>
                                                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Delivery"><Setter Property="BackgroundColor" Value="#0D9488" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" HorizontalOptions="Center">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Fill" Value="#94A3B8" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger TargetType="Path" Binding="{Binding Status}" Value="Refining"><Setter Property="Fill" Value="White" /></DataTrigger>
                                                                            <DataTrigger TargetType="Path" Binding="{Binding Status}" Value="Delivery"><Setter Property="Fill" Value="White" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Border>
                                                        <Label Text="Refining" HorizontalOptions="Center">
                                                            <Label.Style>
                                                                <Style TargetType="Label">
                                                                    <Setter Property="TextColor" Value="#64748B" />
                                                                    <Setter Property="FontAttributes" Value="None" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Refining">
                                                                            <Setter Property="TextColor" Value="#0D9488" />
                                                                            <Setter Property="FontAttributes" Value="Bold" />
                                                                        </DataTrigger>
                                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Delivery"><Setter Property="TextColor" Value="#0D9488" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Label.Style>
                                                        </Label>
                                                    </VerticalStackLayout>

                                                    <!-- Delivery Step -->
                                                    <VerticalStackLayout Grid.Column="3" Spacing="12" HorizontalOptions="Center">
                                                        <Border HeightRequest="24" WidthRequest="24" StrokeShape="RoundRectangle 12" StrokeThickness="0" HorizontalOptions="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BackgroundColor" Value="#F1F5F9" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Delivery"><Setter Property="BackgroundColor" Value="#0D9488" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Path Data="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4z" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" HorizontalOptions="Center">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Fill" Value="#94A3B8" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger TargetType="Path" Binding="{Binding Status}" Value="Delivery"><Setter Property="Fill" Value="White" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Border>
                                                        <Label Text="Delivery" HorizontalOptions="Center">
                                                            <Label.Style>
                                                                <Style TargetType="Label">
                                                                    <Setter Property="TextColor" Value="#64748B" />
                                                                    <Setter Property="FontAttributes" Value="None" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Delivery">
                                                                            <Setter Property="TextColor" Value="#0D9488" />
                                                                            <Setter Property="FontAttributes" Value="Bold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Label.Style>
                                                        </Label>
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Grid>

                                            <!-- Footer -->
                                            <Border StrokeShape="RoundRectangle 0" StrokeThickness="0" BackgroundColor="#F8FAFC" Padding="32,16">
                                                <BoxView HeightRequest="1" Color="#E2E8F0" VerticalOptions="Start" Margin="-32,-16,-32,0" />
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <Label Text="Order secured by CreatiSphere Protection." TextColor="#64748B" FontSize="13" />
                                                    <Label Grid.Column="1" Text="Full History" TextColor="#0D9488" FontSize="13" FontAttributes="Bold" />
                                                </Grid>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Bottom Banner -->
                        <Border StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="#0D9488" Padding="0" HeightRequest="200" Margin="0,16,0,0">
                            <Grid ColumnDefinitions="*, *">
                                <VerticalStackLayout Padding="40" Spacing="16" VerticalOptions="Center">
                                    <Label Text="Need something new?" TextColor="White" FontSize="24" FontAttributes="Bold" />
                                    <Label Text="Discover new artists who match your creative&#10;aesthetic while your current projects are being&#10;crafted." TextColor="#CCFBF1" FontSize="15" LineHeight="1.5" />
                                    <Button Text="Explore Marketplace" BackgroundColor="White" TextColor="#0D9488" CornerRadius="20" Padding="20,10" FontAttributes="Bold" HorizontalOptions="Start" Margin="0,8,0,0" Clicked="OnExploreTapped" />
                                </VerticalStackLayout>
                                <!-- The image overflow on the right -->
                                <Image Grid.Column="1" Source="redesign_bg.png" Aspect="AspectFill" HorizontalOptions="End" />
                            </Grid>
                        </Border>

                        <!-- Guarantee Badge -->
                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8FAFC" Padding="32,24" Margin="0,0,0,24">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" Fill="#0D9488" Aspect="Uniform" HeightRequest="32" WidthRequest="32" VerticalOptions="Center" Margin="0,0,24,0" />
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="CreatiSphere Guarantee" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" />
                                    <Label Text="All custom orders are covered by our secure payment and artist&#10;verification system. Your creativity, protected." TextColor="#64748B" FontSize="14" LineHeight="1.5" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                                    <Label Text="Learn more" TextColor="#065F46" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Text="→" TextColor="#065F46" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>

                    </VerticalStackLayout>

                    <!-- Footer -->
                    <Grid Padding="48,40" ColumnDefinitions="*,Auto" BackgroundColor="#F8FAFC">
                        <BoxView HeightRequest="1" Color="#E2E8F0" VerticalOptions="Start" Margin="-48,-40,-48,0" Grid.ColumnSpan="2" />
                        <Label Text="© 2024 CreatiSphere. All rights reserved." TextColor="#64748B" FontSize="13" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="24">
                            <Label Text="Terms" TextColor="#64748B" FontSize="13" />
                            <Label Text="Privacy" TextColor="#64748B" FontSize="13" />
                            <Label Text="Support" TextColor="#64748B" FontSize="13" />
                        </HorizontalStackLayout>
                    </Grid>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- ===== ORDER DETAILS MODAL ===== -->
        <Grid x:Name="OrderDetailsModal" Grid.ColumnSpan="2" BackgroundColor="#80000000" IsVisible="False">
            <Border VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="600" StrokeShape="RoundRectangle 24" BackgroundColor="White" Padding="0" StrokeThickness="0">
                <VerticalStackLayout>
                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="*, Auto" Padding="32,24" BackgroundColor="#F8FAFC">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Order Details" TextColor="#0F172A" FontSize="20" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding OrderID, StringFormat='#{0}'}" TextColor="#64748B" FontSize="13" />
                                <BoxView WidthRequest="4" HeightRequest="4" CornerRadius="2" Color="#CBD5E1" VerticalOptions="Center" />
                                <Label Text="{Binding Date}" TextColor="#64748B" FontSize="13" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" BackgroundColor="#F1F5F9" StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseModalTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="✕" TextColor="#64748B" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <ScrollView MaximumHeightRequest="500">
                        <VerticalStackLayout Padding="32" Spacing="24">
                            <!-- Status Info -->
                            <Border BackgroundColor="#F0FDF4" Stroke="#DCFCE7" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="20">
                                <HorizontalStackLayout Spacing="16">
                                    <Border BackgroundColor="#16A34A" HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 24">
                                        <Path Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" Fill="White" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Status, StringFormat='Project Stage: {0}'}" TextColor="#166534" FontSize="16" FontAttributes="Bold" />
                                        <Label Text="Your project is being handled by our expert creator." TextColor="#166534" FontSize="13" Opacity="0.8" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Project Overview -->
                            <VerticalStackLayout Spacing="12">
                                <Label Text="PROJECT OVERVIEW" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                                <Label Text="{Binding Title}" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" />
                                <Label Text="This custom commission is a unique collaboration between you and our master artist. We ensure every detail matches your creative vision while maintaining our high standards of quality." TextColor="#475569" FontSize="14" LineHeight="1.5" />
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#E2E8F0" />

                            <!-- Order Summary -->
                            <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="12">
                                <Label Grid.Row="0" Grid.Column="0" Text="Commission Base Price" TextColor="#64748B" FontSize="14" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Price, StringFormat='${0:N2}'}" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />

                                <Label Grid.Row="1" Grid.Column="0" Text="Service Fee (5%)" TextColor="#64748B" FontSize="14" />
                                <Label Grid.Row="1" Grid.Column="1" Text="$25.00" TextColor="#0F172A" FontSize="14" />

                                <Label Grid.Row="2" Grid.Column="0" Text="Total Amount Paid" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding Price, StringFormat='${0:N2}'}" TextColor="#0D9488" FontSize="20" FontAttributes="Bold" />
                            </Grid>

                            <!-- Action Buttons -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="16" Margin="0,16,0,0">
                                <Button Grid.Column="0" Text="Download Receipt" BackgroundColor="White" TextColor="#0F172A" BorderColor="#E2E8F0" BorderWidth="1" CornerRadius="12" Padding="0,12" FontAttributes="Bold" />
                                <Button Grid.Column="1" Text="Contact Support" BackgroundColor="#F1F5F9" TextColor="#475569" CornerRadius="12" Padding="0,12" FontAttributes="Bold" />
                            </Grid>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Modal Footer -->
                    <Border BackgroundColor="#F8FAFC" Padding="32,20" StrokeShape="RoundRectangle 0" StrokeThickness="0">
                        <BoxView HeightRequest="1" Color="#E2E8F0" VerticalOptions="Start" Margin="-32,-20,-32,0" />
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z" Fill="#0D9488" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" />
                            <Label Text="Secured by CreatiSphere Protection" TextColor="#64748B" FontSize="12" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
