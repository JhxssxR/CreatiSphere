<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CreatiSphere.Views.Customer.FeedbackPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid ColumnDefinitions="220, *">

        <!-- ===== LEFT SIDEBAR ===== -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" BackgroundColor="#1A2332">

            <!-- Logo -->
            <HorizontalStackLayout Grid.Row="0" Padding="24,36,24,32" Spacing="12" VerticalOptions="Center">
                <Border BackgroundColor="#0D9488" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 10">
                    <Label Text="◈" TextColor="White" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="CreatiSphere" TextColor="White" FontSize="18" FontAttributes="Bold" FontFamily="Georgia" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Nav Items -->
            <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="12,0">

                <!-- Dashboard -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDashboardTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M3,13h8V3H3V13z M3,21h8v-6H3V21z M13,21h8V11h-8V21z M13,3v6h8V3H13z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Dashboard" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Explore -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExploreTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M12,2C8.13,2,5,5.13,5,9c0,5.25,7,13,7,13s7-7.75,7-13C19,5.13,15.87,2,12,2z M12,11.5c-1.38,0-2.5-1.12-2.5-2.5s1.12-2.5,2.5-2.5s2.5,1.12,2.5,2.5S13.38,11.5,12,11.5z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Explore" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Custom Orders -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCustomOrdersTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M17,13h-4v4h-2v-4H7v-2h4V7h2v4h4V13z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Custom Orders" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Track Orders -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTrackOrdersTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,8h-3V4H3C1.9,4,1,4.9,1,6v11h2c0,1.66,1.34,3,3,3s3-1.34,3-3h6c0,1.66,1.34,3,3,3s3-1.34,3-3h2v-5L20,8z M6,18.5c-0.83,0-1.5-0.67-1.5-1.5S5.17,15.5,6,15.5S7.5,16.17,7.5,17S6.83,18.5,6,18.5z M19,9.5l1.96,2.5H17V9.5H19z M18,18.5c-0.83,0-1.5-0.67-1.5-1.5s0.67-1.5,1.5-1.5s1.5,0.67,1.5,1.5S18.83,18.5,18,18.5z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Track Orders" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Messages -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMessagesTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,2H4C2.9,2,2,2.9,2,4v18l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Messages" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Feedback (Active) -->
                <Border BackgroundColor="#0D9488" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,2H4C2.9,2,2.01,2.9,2.01,4L2,22l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z M13,11h-2V5h2V11z M13,15h-2v-2h2V15z"
                              Fill="White" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Feedback" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Rewards -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRewardsTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M12,1L3,5v6c0,5.55,3.84,10.74,9,12c5.16-1.26,9-6.45,9-12V5L12,1z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Rewards" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>

            <!-- User Profile & Sign Out at Bottom -->
            <VerticalStackLayout Grid.Row="2" Padding="12,24" Spacing="4">
                <!-- User Profile -->
                <Grid Padding="8,12" ColumnDefinitions="Auto,*,Auto">
                    <Border HeightRequest="38" WidthRequest="38" StrokeShape="RoundRectangle 19" StrokeThickness="0" BackgroundColor="#0D9488">
                        <Label x:Name="ProfileInitialsLabel" Text="AH" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" Padding="10,0,0,0" VerticalOptions="Center">
                        <Label x:Name="ProfileNameLabel" Text="Alex Henderson" TextColor="White" FontSize="13" FontAttributes="Bold"/>
                        <Label x:Name="ProfileRoleLabel" Text="Artisanal Collector" TextColor="#64748B" FontSize="11"/>
                    </VerticalStackLayout>
                    <Path Grid.Column="2" Data="M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.1-1.6-5.6-4.5-6.3V4c0-0.8-0.7-1.5-1.5-1.5S10.5,3.2,10.5,4v0.7C7.6,5.4,6,7.9,6,11v5l-2,2v1h16v-1L18,16z"
                          Fill="#64748B" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                </Grid>

                <BoxView HeightRequest="1" Color="#2D3748" Margin="16,8" />

                <!-- Sign Out -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignOutTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M17,7l-1.41,1.41L18.17,11H8v2h10.17l-2.58,2.58L17,17l5-5L17,7z M4,5h8V3H4C2.9,3,2,3.9,2,5v14c0,1.1,0.9,2,2,2h8v-2H4V5z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Sign Out" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>

        </Grid>

        <!-- ===== MAIN CONTENT ===== -->
        <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="48,60" Spacing="48" HorizontalOptions="Center" MaximumWidthRequest="1000">
                
                <!-- Page Header -->
                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Label Text="Celebrate the Creation" TextColor="#0D9488" FontSize="48" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="Your masterpiece is ready! Share your thoughts and help us perfect&#10;the craft for your next unique request." 
                           TextColor="#475569" FontSize="18" LineHeight="1.5" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Feedback Row -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="32">
                    
                    <!-- Left: Masterpiece Preview -->
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="20">
                        <VerticalStackLayout Spacing="24">
                            <Grid ColumnDefinitions="Auto, *">
                                <Border BackgroundColor="#F0FDFA" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="12,4">
                                    <Label Text="FINALIZED MASTERPIECE" TextColor="#0D9488" FontSize="11" FontAttributes="Bold" />
                                </Border>
                                <Label Grid.Column="1" Text="ID: #CRT-9502" TextColor="#64748B" FontSize="11" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>

                            <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" HeightRequest="450">
                                <Image Source="finalized_art.png" Aspect="AspectFill" />
                            </Border>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="Ethereal Symmetry #01" TextColor="#0F172A" FontSize="24" FontAttributes="Bold" />
                                <Label Text="A unique custom piece blending geometric precision&#10;with organic fluid textures." 
                                       TextColor="#64748B" FontSize="15" LineHeight="1.5" />
                            </VerticalStackLayout>

                            <BoxView HeightRequest="1" Color="#F1F5F9" />

                            <HorizontalStackLayout Spacing="12">
                                <Grid>
                                    <Border HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                                        <Image Source="artist_avatar_1.png" Aspect="AspectFill" />
                                    </Border>
                                    <Border HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="White" Margin="16,0,0,0">
                                        <Image Source="artist_avatar_2.png" Aspect="AspectFill" />
                                    </Border>
                                </Grid>
                                <Label Text="Created by CreatiSphere Team" TextColor="#475569" FontSize="13" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Right: Feedback Form -->
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F1F5F9" Padding="40">
                        <VerticalStackLayout Spacing="32">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Share Your Feedback" TextColor="#0F172A" FontSize="24" FontAttributes="Bold" />
                                <Label Text="Your input helps us improve and rewards you with&#10;loyalty points." 
                                       TextColor="#64748B" FontSize="15" LineHeight="1.5" />
                            </VerticalStackLayout>

                            <!-- Star Rating -->
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Rate the Quality" TextColor="#475569" FontSize="13" FontAttributes="Bold" />
                                <HorizontalStackLayout Spacing="12">
                                    <Label Text="★" TextColor="#0D9488" FontSize="28" />
                                    <Label Text="★" TextColor="#0D9488" FontSize="28" />
                                    <Label Text="★" TextColor="#0D9488" FontSize="28" />
                                    <Label Text="★" TextColor="#0D9488" FontSize="28" />
                                    <Label Text="☆" TextColor="#94A3B8" FontSize="28" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- Text Area -->
                            <VerticalStackLayout Spacing="12">
                                <Label Text="Tell us more" TextColor="#475569" FontSize="13" FontAttributes="Bold" />
                                <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#CBD5E1" BackgroundColor="White" Padding="16" HeightRequest="180">
                                    <Editor Placeholder="What did you love about this piece? Anything we could improve?" 
                                            TextColor="#0F172A" FontSize="14" PlaceholderColor="#94A3B8" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Points Info -->
                            <Border BackgroundColor="#E2E8F0" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="20">
                                <HorizontalStackLayout Spacing="16">
                                    <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M17,13h-4v4h-2v-4H7v-2h4V7h2v4h4V13z"
                                          Fill="#0D9488" Aspect="Uniform" HeightRequest="24" WidthRequest="24" VerticalOptions="Center" />
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="Earn 50 Points" TextColor="#0D9488" FontSize="14" FontAttributes="Bold" />
                                        <Label Text="Redeemable for discounts on future custom orders." TextColor="#64748B" FontSize="12" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Submit Button -->
                            <Button Text="Submit Feedback" BackgroundColor="#0D9488" TextColor="White" CornerRadius="8" HeightRequest="56" FontAttributes="Bold" FontSize="16">
                                <Button.ImageSource>
                                    <FontImageSource Glyph="➤" FontFamily="FontAwesome" Size="18" />
                                </Button.ImageSource>
                            </Button>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
