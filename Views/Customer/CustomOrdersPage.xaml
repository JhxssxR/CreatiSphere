<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CreatiSphere.Views.Customer.CustomOrdersPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid ColumnDefinitions="220, *">

        <!-- ===== LEFT SIDEBAR ===== -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" BackgroundColor="#1A2332">

            <!-- Logo -->
            <HorizontalStackLayout Grid.Row="0" Padding="24,36,24,32" Spacing="12" VerticalOptions="Center">
                <Border BackgroundColor="#0D9488" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 10">
                    <Label Text="◈" TextColor="White" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="CreatiSphere" TextColor="White" FontSize="18" FontAttributes="Bold" FontFamily="Georgia" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Nav Items -->
            <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="12,0">

                <!-- Dashboard -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDashboardTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M3,13h8V3H3V13z M3,21h8v-6H3V21z M13,21h8V11h-8V21z M13,3v6h8V3H13V3z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Dashboard" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Explore -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExploreTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M12,2C8.13,2,5,5.13,5,9c0,5.25,7,13,7,13s7-7.75,7-13C19,5.13,15.87,2,12,2z M12,11.5c-1.38,0-2.5-1.12-2.5-2.5s1.12-2.5,2.5-2.5s2.5,1.12,2.5,2.5S13.38,11.5,12,11.5z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Explore" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Custom Orders (Active) -->
                <Border BackgroundColor="#0D9488" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M17,13h-4v4h-2v-4H7v-2h4V7h2v4h4V13z"
                              Fill="White" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Custom Orders" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Track Orders -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTrackOrdersTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,8h-3V4H3C1.9,4,1,4.9,1,6v11h2c0,1.66,1.34,3,3,3s3-1.34,3-3h6c0,1.66,1.34,3,3,3s3-1.34,3-3h2v-5L20,8z M6,18.5c-0.83,0-1.5-0.67-1.5-1.5S5.17,15.5,6,15.5S7.5,16.17,7.5,17S6.83,18.5,6,18.5z M19,9.5l1.96,2.5H17V9.5H19z M18,18.5c-0.83,0-1.5-0.67-1.5-1.5s0.67-1.5,1.5-1.5s1.5,0.67,1.5,1.5S18.83,18.5,18,18.5z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Track Orders" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Messages -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMessagesTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,2H4C2.9,2,2,2.9,2,4v18l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Messages" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- My Commissions -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z" 
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="My Commissions" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Revenue -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M21,7.28V5c0-1.1-0.9-2-2-2H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2v-2.28c0.59-0.35,1-0.98,1-1.72V9 C22,8.26,21.59,7.63,21,7.28z M20,9v6h-7V9H20z M5,19V5h14v2h-6c-1.1,0-2,0.9-2,2v6c0,1.1,0.9,2,2,2h6V19H5z" 
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Revenue" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Support -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M11,18h2v-2h-2V18z M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M12,20c-4.41,0-8-3.59-8-8 s3.59-8,8-8s8,3.59,8,8S16.41,20,12,20z M12,6c-2.21,0-4,1.79-4,4h2c0-1.1,0.9-2,2-2s2,0.9,2,2c0,2-3,1.75-3,5h2c0-2.25,3-2.5,3-5 C16,7.79,14.21,6,12,6z" 
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Support" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- User Profile & Sign Out -->
            <VerticalStackLayout Grid.Row="2" Padding="12,24" Spacing="4">
                <!-- User Profile -->
                <Grid Padding="8,12" ColumnDefinitions="Auto,*,Auto">
                    <Border HeightRequest="38" WidthRequest="38" StrokeShape="RoundRectangle 19" StrokeThickness="0" BackgroundColor="#0D9488">
                        <Label x:Name="ProfileInitialsLabel" Text="AM" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" Padding="10,0,0,0" VerticalOptions="Center">
                        <Label x:Name="ProfileNameLabel" Text="Alex Morgan" TextColor="White" FontSize="13" FontAttributes="Bold"/>
                        <Label x:Name="ProfileRoleLabel" Text="Standard Partner" TextColor="#64748B" FontSize="11"/>
                    </VerticalStackLayout>
                    <Path Grid.Column="2" Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" 
                          Fill="#64748B" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                </Grid>

                <BoxView HeightRequest="1" Color="#2D3748" Margin="16,8" />

                <!-- Sign Out -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignOutTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M17,7l-1.41,1.41L18.17,11H8v2h10.17l-2.58,2.58L17,17l5-5L17,7z M4,5h8V3H4C2.9,3,2,3.9,2,5v14c0,1.1,0.9,2,2,2h8v-2H4V5z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Sign Out" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *">
            <!-- Top Nav -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Padding="32,24" BackgroundColor="White">
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <Label x:Name="NavBreadcrumb1" Text="Custom Orders" TextColor="#64748B" FontSize="14" VerticalOptions="Center" />
                    <BoxView WidthRequest="1" HeightRequest="16" Color="#E2E8F0" VerticalOptions="Center" />
                    <Border x:Name="NavBreadcrumbPill" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="Transparent" Padding="12,6" VerticalOptions="Center">
                        <Label x:Name="NavBreadcrumb2" Text="New Commission" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>

                <!-- Search Bar (Step 2 style) -->
                <Border Grid.Column="1" HorizontalOptions="Center" WidthRequest="320" HeightRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8FAFC">
                    <Grid ColumnDefinitions="Auto, *">
                        <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="16" WidthRequest="16" Margin="16,0,8,0" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Placeholder="Search for assets..." PlaceholderColor="#94A3B8" TextColor="#0F172A" FontSize="13" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <HorizontalStackLayout Grid.Column="2" Spacing="24" VerticalOptions="Center">
                    <Path Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z" Fill="#64748B" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                    <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,3.75c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,6.29C8.66,6.53,8.12,6.85,7.63,7.23L5.24,6.27c-0.22-0.08-0.47,0-0.59,0.22L2.74,9.81 c-0.12,0.21-0.08,0.47,0.12,0.61l2.03,1.58C4.84,12.3,4.8,12.63,4.8,12.94s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" Fill="#64748B" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                    <Border HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="#F1F5F9">
                        <Label Text="AM" TextColor="#0D9488" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="0" BackgroundColor="#F8FAFC">
                    <VerticalStackLayout x:Name="Step1Content">
                        <!-- Header Section -->
                        <VerticalStackLayout Padding="48,40,48,20" Spacing="16">
                            <Label Text="Commission Your Vision" TextColor="#0F172A" FontSize="36" FontAttributes="Bold" />
                            <Label Text="Partner with our master creators to bring your bespoke artistic concepts to&#10;life through a curated consultation process." TextColor="#64748B" FontSize="16" LineHeight="1.5" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, 340" ColumnSpacing="32" Padding="48,20,48,48">
                            
                            <!-- Left Column (Form) -->
                            <VerticalStackLayout Grid.Column="0" Spacing="32">
                                <!-- Stepper -->
                                <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="40,32">
                                    <Grid ColumnDefinitions="*,*,*,*">
                                        <BoxView Grid.ColumnSpan="4" HeightRequest="2" Color="#E2E8F0" VerticalOptions="Center" Margin="60,0,60,28" />
                                        <BoxView Grid.ColumnSpan="1" HeightRequest="2" Color="#0D9488" VerticalOptions="Center" Margin="60,0,0,28" HorizontalOptions="Start" WidthRequest="80"/>
                                        
                                        <!-- Step 1 (Active) -->
                                        <VerticalStackLayout Grid.Column="0" Spacing="12" HorizontalOptions="Center">
                                            <Border HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="#0D9488">
                                                <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z" Fill="White" Aspect="Uniform" HeightRequest="14" WidthRequest="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <Label Text="The Brief" TextColor="#0D9488" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                        
                                        <!-- Step 2 -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="12" HorizontalOptions="Center">
                                            <Border HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="#F1F5F9">
                                                <Path Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C13.66,22 15,20.66 15,19C15,18.23 14.71,17.53 14.24,17C13.78,16.48 13.5,15.81 13.5,15C13.5,13.34 14.84,12 16.5,12H19C20.66,12 22,10.66 22,9C22,5.13 17.52,2 12,2ZM6.5,12C5.67,12 5,11.33 5,10.5C5,9.67 5.67,9 6.5,9C7.33,9 8,9.67 8,10.5C8,11.33 7.33,12 6.5,12ZM9.5,8C8.67,8 8,7.33 8,6.5C8,5.67 8.67,5 9.5,5C10.33,5 11,5.67 11,6.5C11,7.33 10.33,8 9.5,8ZM14.5,8C13.67,8 13,7.33 13,6.5C13,5.67 13.67,5 14.5,5C15.33,5 16,5.67 16,6.5C16,7.33 15.33,8 14.5,8ZM17.5,12C16.67,12 16,11.33 16,10.5C16,9.67 16.67,9 17.5,9C18.33,9 19,9.67 19,10.5C19,11.33 18.33,12 17.5,12Z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="16" WidthRequest="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <Label Text="Aesthetics" TextColor="#64748B" FontSize="13" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                        
                                        <!-- Step 3 -->
                                        <VerticalStackLayout Grid.Column="2" Spacing="12" HorizontalOptions="Center">
                                            <Border HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="#F1F5F9">
                                                <Path Data="M14,2H6C4.9,2 4,2.9 4,4V20C4,21.1 4.9,22 6,22H18C19.1,22 20,21.1 20,20V8L14,2ZM18,20H6V4H13V9H18V20Z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="16" WidthRequest="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <Label Text="Review" TextColor="#64748B" FontSize="13" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                        
                                        <!-- Step 4 -->
                                        <VerticalStackLayout Grid.Column="3" Spacing="12" HorizontalOptions="Center">
                                            <Border HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="#F1F5F9">
                                                <Path Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="16" WidthRequest="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <Label Text="Payment" TextColor="#64748B" FontSize="13" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>

                                <!-- Form Box 1 -->
                                <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="40">
                                    <VerticalStackLayout Spacing="32">
                                        <HorizontalStackLayout Spacing="16">
                                            <BoxView WidthRequest="4" Color="#0D9488" CornerRadius="2" />
                                            <Label Text="The Creative Brief" TextColor="#0F172A" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <!-- Project Title -->
                                        <VerticalStackLayout Spacing="12">
                                            <Label Text="Project Title" TextColor="#475569" FontSize="14" FontAttributes="Bold" />
                                            <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#CBD5E1" Padding="16,0" HeightRequest="52">
                                                <Entry x:Name="BriefTitleEntry" Placeholder="e.g., Minimalist Kinetic Sculpture for Main Lobby" PlaceholderColor="#94A3B8" TextColor="#0F172A" FontSize="15" />
                                            </Border>
                                        </VerticalStackLayout>

                                        <!-- Visionary Intent -->
                                        <VerticalStackLayout Spacing="12">
                                            <Label Text="Visionary Intent" TextColor="#475569" FontSize="14" FontAttributes="Bold" />
                                            <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#CBD5E1" Padding="16" HeightRequest="160">
                                                <Editor x:Name="BriefIntentEditor" Placeholder="Describe the atmosphere, purpose, and emotional core of your vision..." PlaceholderColor="#94A3B8" TextColor="#0F172A" FontSize="15" />
                                            </Border>
                                        </VerticalStackLayout>

                                        <!-- Dimensions & Budget -->
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="32">
                                            <VerticalStackLayout Spacing="12">
                                                <Label Text="Dimensions" TextColor="#475569" FontSize="14" FontAttributes="Bold" />
                                                <HorizontalStackLayout Spacing="12">
                                                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#CBD5E1" HeightRequest="52" WidthRequest="80">
                                                        <Entry x:Name="BriefWidthEntry" Placeholder="W" HorizontalTextAlignment="Center" FontSize="15" />
                                                    </Border>
                                                    <Label Text="×" TextColor="#64748B" FontSize="18" VerticalOptions="Center" />
                                                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#CBD5E1" HeightRequest="52" WidthRequest="80">
                                                        <Entry x:Name="BriefHeightEntry" Placeholder="H" HorizontalTextAlignment="Center" FontSize="15" />
                                                    </Border>
                                                    <Label Text="cm" TextColor="#64748B" FontSize="14" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Column="1" Spacing="12">
                                                <Label Text="Estimated Budget Range" TextColor="#475569" FontSize="14" FontAttributes="Bold" />
                                                <Grid ColumnDefinitions="*, Auto, *" ColumnSpacing="12">
                                                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#CBD5E1" Padding="16,0" HeightRequest="52">
                                                        <HorizontalStackLayout Spacing="4">
                                                            <Label Text="$" TextColor="#64748B" VerticalOptions="Center" FontSize="15" />
                                                            <Entry x:Name="BudgetMinEntry" Placeholder="Min" Keyboard="Numeric" TextColor="#0F172A" FontSize="15" VerticalOptions="Center" />
                                                        </HorizontalStackLayout>
                                                    </Border>
                                                    <Label Grid.Column="1" Text="to" TextColor="#64748B" VerticalOptions="Center" FontSize="14" />
