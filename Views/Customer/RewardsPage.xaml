<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CreatiSphere.Views.Customer.RewardsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid ColumnDefinitions="220, *">

        <!-- ===== LEFT SIDEBAR ===== -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" BackgroundColor="#1A2332">

            <!-- Logo -->
            <HorizontalStackLayout Grid.Row="0" Padding="24,36,24,32" Spacing="12" VerticalOptions="Center">
                <Border BackgroundColor="#0D9488" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 10">
                    <Label Text="◈" TextColor="White" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="CreatiSphere" TextColor="White" FontSize="18" FontAttributes="Bold" FontFamily="Georgia" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Nav Items -->
            <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="12,0">

                <!-- Dashboard -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDashboardTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M3,13h8V3H3V13z M3,21h8v-6H3V21z M13,21h8V11h-8V21z M13,3v6h8V3H13z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Dashboard" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Explore -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnExploreTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M12,2C8.13,2,5,5.13,5,9c0,5.25,7,13,7,13s7-7.75,7-13C19,5.13,15.87,2,12,2z M12,11.5c-1.38,0-2.5-1.12-2.5-2.5s1.12-2.5,2.5-2.5s2.5,1.12,2.5,2.5S13.38,11.5,12,11.5z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Explore" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Custom Orders -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCustomOrdersTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M17,13h-4v4h-2v-4H7v-2h4V7h2v4h4V13z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Custom Orders" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Track Orders -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTrackOrdersTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,8h-3V4H3C1.9,4,1,4.9,1,6v11h2c0,1.66,1.34,3,3,3s3-1.34,3-3h6c0,1.66,1.34,3,3,3s3-1.34,3-3h2v-5L20,8z M6,18.5c-0.83,0-1.5-0.67-1.5-1.5S5.17,15.5,6,15.5S7.5,16.17,7.5,17S6.83,18.5,6,18.5z M19,9.5l1.96,2.5H17V9.5H19z M18,18.5c-0.83,0-1.5-0.67-1.5-1.5s0.67-1.5,1.5-1.5s1.5,0.67,1.5,1.5S18.83,18.5,18,18.5z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Track Orders" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Messages -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMessagesTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,2H4C2.9,2,2,2.9,2,4v18l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Messages" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Feedback -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFeedbackTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,2H4C2.9,2,2.01,2.9,2.01,4L2,22l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z M13,11h-2V5h2V11z M13,15h-2v-2h2V15z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Feedback" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Rewards (Active) -->
                <Border BackgroundColor="#0D9488" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M12,1L3,5v6c0,5.55,3.84,10.74,9,12c5.16-1.26,9-6.45,9-12V5L12,1z"
                              Fill="White" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Rewards" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>

            <!-- User Profile & Sign Out at Bottom -->
            <VerticalStackLayout Grid.Row="2" Padding="12,24" Spacing="4">
                <!-- User Profile -->
                <Grid Padding="8,12" ColumnDefinitions="Auto,*,Auto">
                    <Border HeightRequest="38" WidthRequest="38" StrokeShape="RoundRectangle 19" StrokeThickness="0" BackgroundColor="#0D9488">
                        <Label x:Name="ProfileInitialsLabel" Text="AH" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" Padding="10,0,0,0" VerticalOptions="Center">
                        <Label x:Name="ProfileNameLabel" Text="Alex Henderson" TextColor="White" FontSize="13" FontAttributes="Bold"/>
                        <Label x:Name="ProfileRoleLabel" Text="Artisanal Collector" TextColor="#64748B" FontSize="11"/>
                    </VerticalStackLayout>
                    <Path Grid.Column="2" Data="M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.1-1.6-5.6-4.5-6.3V4c0-0.8-0.7-1.5-1.5-1.5S10.5,3.2,10.5,4v0.7C7.6,5.4,6,7.9,6,11v5l-2,2v1h16v-1L18,16z"
                          Fill="#64748B" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                </Grid>

                <BoxView HeightRequest="1" Color="#2D3748" Margin="16,8" />

                <!-- Sign Out -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignOutTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M17,7l-1.41,1.41L18.17,11H8v2h10.17l-2.58,2.58L17,17l5-5L17,7z M4,5h8V3H4C2.9,3,2,3.9,2,5v14c0,1.1,0.9,2,2,2h8v-2H4V5z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Sign Out" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>

        </Grid>

        <!-- ===== MAIN CONTENT ===== -->
        <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="48,40" Spacing="40">
                
                <!-- Loyalty Status Section -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="24">
                    
                    <!-- Balance Card -->
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="32">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="AVAILABLE BALANCE" TextColor="#64748B" FontSize="12" FontAttributes="Bold" CharacterSpacing="1"/>
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label x:Name="PointsBalanceLabel" Text="0" TextColor="#0F172A" FontSize="44" FontAttributes="Bold" />
                                <Label Text="pts" TextColor="#64748B" FontSize="20" VerticalOptions="End" Margin="0,0,0,8" />
                            </HorizontalStackLayout>
                            <Button Text="Redeem Now" BackgroundColor="#0D9488" TextColor="White" CornerRadius="8" Padding="24,14" FontAttributes="Bold" HorizontalOptions="Start" Margin="0,20,0,0" Clicked="OnRedeemNowClicked">
                                <Button.ImageSource>
                                    <FontImageSource Glyph="" FontFamily="FontAwesome" Size="16" />
                                </Button.ImageSource>
                            </Button>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Tier Card -->
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="32">
                        <Grid RowDefinitions="Auto, Auto, Auto, *">
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="CURRENT TIER" TextColor="#64748B" FontSize="12" FontAttributes="Bold" CharacterSpacing="1"/>
                                <Path Data="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z" Fill="#0D9488" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" HorizontalOptions="End" />
                            </HorizontalStackLayout>
                            
                            <Label x:Name="TierNameLabel" Grid.Row="1" Text="" TextColor="#0F172A" FontSize="28" FontAttributes="Bold" Margin="0,8,0,0" />
                            
                            <VerticalStackLayout Grid.Row="2" Spacing="8" Margin="0,24,0,0">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="Progress to Master Creator" TextColor="#0D9488" FontSize="13" FontAttributes="Bold" />
                                    <Label x:Name="PointsToGoLabel" Grid.Column="1" Text="" TextColor="#64748B" FontSize="13" />
                                </Grid>
                                <ProgressBar x:Name="TierProgressBar" Progress="0" ProgressColor="#0D9488" BackgroundColor="#F1F5F9" HeightRequest="8" />
                            </VerticalStackLayout>

                            <Label x:Name="TierMessageLabel" Grid.Row="3" Text="" TextColor="#64748B" FontSize="13" LineHeight="1.5" VerticalOptions="End" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Redeemable Rewards Section -->
                <VerticalStackLayout Spacing="24">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Redeemable Rewards" TextColor="#0F172A" FontSize="24" FontAttributes="Bold" FontFamily="Georgia" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <Label Text="View Catalog" TextColor="#0D9488" FontSize="14" FontAttributes="Bold" />
                            <Label Text="→" TextColor="#0D9488" FontSize="16" />
                        </HorizontalStackLayout>
                    </Grid>

                    <CollectionView x:Name="RewardsCollectionView">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="20" VerticalItemSpacing="20" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White">
                                    <VerticalStackLayout>
                                        <Grid HeightRequest="180">
                                            <BoxView>
                                                <BoxView.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#0F766E" Offset="0" />
                                                        <GradientStop Color="#22D3EE" Offset="1" />
                                                    </LinearGradientBrush>
                                                </BoxView.Background>
                                            </BoxView>
                                            <Label Text="{Binding Title}" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Grid>
                                        <VerticalStackLayout Padding="20" Spacing="12">
                                            <Border BackgroundColor="#F0FDFA" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12,4" HorizontalOptions="Start">
                                                <Label Text="{Binding PointsCost, StringFormat='{}{0:N0} pts'}" TextColor="#0D9488" FontSize="11" FontAttributes="Bold" />
                                            </Border>
                                            <Label Text="{Binding Title}" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" />
                                            <Label Text="{Binding Description}" TextColor="#64748B" FontSize="13" LineHeight="1.5" HeightRequest="40" />
                                            <Button Text="Redeem Reward" BackgroundColor="Transparent" TextColor="#0D9488" BorderColor="#0D9488" BorderWidth="1" CornerRadius="8" Padding="0,12" FontAttributes="Bold" Margin="0,12,0,0" Clicked="OnRedeemRewardClicked" CommandParameter="{Binding RewardId}" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Points History Section -->
                <VerticalStackLayout Spacing="24">
                    <HorizontalStackLayout Spacing="12">
                        <Path Data="M13,3c-4.97,0-9,4.03-9,9H1l3.89,3.89l0.07,0.14L9,12H6c0-3.87,3.13-7,7-7s7,3.13,7,7s-3.13,7-7,7c-1.93,0-3.68-0.79-4.94-2.06l-1.42,1.42C8.27,19.99,10.51,21,13,21c4.97,0,9-4.03,9-9S17.97,3,13,3z" Fill="#0F172A" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                        <Label Text="Points History" TextColor="#0F172A" FontSize="20" FontAttributes="Bold" FontFamily="Georgia" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="0">
                        <VerticalStackLayout>
                            <!-- Table Header -->
                            <Grid ColumnDefinitions="150, *, 120, 100" Padding="24,16" BackgroundColor="#F8FAFC">
                                <Label Text="DATE" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                                <Label Grid.Column="1" Text="DESCRIPTION" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                                <Label Grid.Column="2" Text="STATUS" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" HorizontalOptions="Center" />
                                <Label Grid.Column="3" Text="POINTS" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" HorizontalOptions="End" />
                            </Grid>
                            
                            <!-- Row 1 -->
                            <Grid ColumnDefinitions="150, *, 120, 100" Padding="24,20">
                                <Label Text="Oct 14, 2024" TextColor="#475569" FontSize="13" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Commissioned Mural - 'Urban Flow'" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                <Border Grid.Column="2" BackgroundColor="#F0FDFA" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12,4" HorizontalOptions="Center">
                                    <Label Text="Delivered" TextColor="#0D9488" FontSize="11" FontAttributes="Bold" />
                                </Border>
                                <Label Grid.Column="3" Text="+ 1,200" TextColor="#0D9488" FontSize="14" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#F1F5F9" Margin="24,0" />

                            <!-- Row 2 -->
                            <Grid ColumnDefinitions="150, *, 120, 100" Padding="24,20">
                                <Label Text="Oct 02, 2024" TextColor="#475569" FontSize="13" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Monthly Engagement Bonus" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                <Border Grid.Column="2" BackgroundColor="#F0FDFA" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12,4" HorizontalOptions="Center">
                                    <Label Text="Delivered" TextColor="#0D9488" FontSize="11" FontAttributes="Bold" />
                                </Border>
                                <Label Grid.Column="3" Text="+ 250" TextColor="#0D9488" FontSize="14" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#F1F5F9" Margin="24,0" />

                            <!-- Row 3 -->
                            <Grid ColumnDefinitions="150, *, 120, 100" Padding="24,20">
                                <Label Text="Sep 24, 2024" TextColor="#475569" FontSize="13" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Digital Asset Purchase" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                <Border Grid.Column="2" BackgroundColor="#F0FDFA" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12,4" HorizontalOptions="Center">
                                    <Label Text="Delivered" TextColor="#0D9488" FontSize="11" FontAttributes="Bold" />
                                </Border>
                                <Label Grid.Column="3" Text="+ 450" TextColor="#0D9488" FontSize="14" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#F1F5F9" Margin="24,0" />

                            <!-- Row 4 -->
                            <Grid ColumnDefinitions="150, *, 120, 100" Padding="24,20">
                                <Label Text="Sep 15, 2024" TextColor="#475569" FontSize="13" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Referral Bonus - 'Jane Doe'" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                <Border Grid.Column="2" BackgroundColor="#F0FDFA" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12,4" HorizontalOptions="Center">
                                    <Label Text="Delivered" TextColor="#0D9488" FontSize="11" FontAttributes="Bold" />
                                </Border>
                                <Label Grid.Column="3" Text="+ 500" TextColor="#0D9488" FontSize="14" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#F1F5F9" Margin="24,0" />

                            <!-- Row 5 -->
                            <Grid ColumnDefinitions="150, *, 120, 100" Padding="24,20">
                                <Label Text="Sep 01, 2024" TextColor="#475569" FontSize="13" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="Redeemed: 10% Discount Coupon" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                <Border Grid.Column="2" BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 12" StrokeThickness="0" Padding="12,4" HorizontalOptions="Center">
                                    <Label Text="Redeemed" TextColor="#64748B" FontSize="11" FontAttributes="Bold" />
                                </Border>
                                <Label Grid.Column="3" Text="- 1,000" TextColor="#EF4444" FontSize="14" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Center" />
                            </Grid>

                            <Button Text="Load More History" BackgroundColor="Transparent" TextColor="#64748B" Padding="0,16" FontSize="13" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Footer -->
                <Grid Padding="0,40,0,0" ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto">
                    <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                        <Label Text="CreatiSphere" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" FontFamily="Georgia" />
                    </HorizontalStackLayout>
                    
                    <HorizontalStackLayout Grid.Column="1" Spacing="24" HorizontalOptions="End" VerticalOptions="Center">
                        <Label Text="Terms of Service" TextColor="#64748B" FontSize="13" />
                        <Label Text="Privacy Policy" TextColor="#64748B" FontSize="13" />
                        <Label Text="Contact Support" TextColor="#64748B" FontSize="13" />
                        <Label Text="Help Center" TextColor="#64748B" FontSize="13" />
                        <Label Text="© 2024 CreatiSphere. All rights reserved." TextColor="#64748B" FontSize="13" Margin="24,0,0,0" />
                    </HorizontalStackLayout>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
