<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CreatiSphere.Views.Customer.MessagesPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid ColumnDefinitions="220, 320, *">

        <!-- ===== LEFT SIDEBAR (Standard) ===== -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" BackgroundColor="#1A2332">
            <!-- Logo -->
            <HorizontalStackLayout Grid.Row="0" Padding="24,36,24,32" Spacing="12" VerticalOptions="Center">
                <Border BackgroundColor="#0D9488" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 10">
                    <Label Text="◈" TextColor="White" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="CreatiSphere" TextColor="White" FontSize="18" FontAttributes="Bold" FontFamily="Georgia" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Nav Items -->
            <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="12,0">
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDashboardTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M3,13h8V3H3V13z M3,21h8v-6H3V21z M13,21h8V11h-8V21z M13,3v6h8V3H13z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Dashboard" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCustomOrdersTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M17,13h-4v4h-2v-4H7v-2h4V7h2v4h4V13z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Custom Orders" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTrackOrdersTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,8h-3V4H3C1.9,4,1,4.9,1,6v11h2c0,1.66,1.34,3,3,3s3-1.34,3-3h6c0,1.66,1.34,3,3,3s3-1.34,3-3h2v-5L20,8z M6,18.5c-0.83,0-1.5-0.67-1.5-1.5S5.17,15.5,6,15.5S7.5,16.17,7.5,17S6.83,18.5,6,18.5z M19,9.5l1.96,2.5H17V9.5H19z M18,18.5c-0.83,0-1.5-0.67-1.5-1.5s0.67-1.5,1.5-1.5s1.5,0.67,1.5,1.5S18.83,18.5,18,18.5z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Track Orders" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <Border BackgroundColor="#0D9488" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,2H4C2.9,2,2,2.9,2,4v18l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z" Fill="White" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Messages" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFeedbackTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,2H4C2.9,2,2.01,2.9,2.01,4L2,22l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z M13,11h-2V5h2V11z M13,15h-2v-2h2V15z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Feedback" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRewardsTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M12,1L3,5v6c0,5.55,3.84,10.74,9,12c5.16-1.26,9-6.45,9-12V5L12,1z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Rewards" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
            <!-- User Profile & Sign Out at Bottom -->
            <VerticalStackLayout Grid.Row="2" Padding="12,24" Spacing="4">
                <!-- User Profile -->
                <Grid Padding="8,12" ColumnDefinitions="Auto,*,Auto">
                    <Border HeightRequest="38" WidthRequest="38" StrokeShape="RoundRectangle 19" StrokeThickness="0" BackgroundColor="#0D9488">
                        <Label x:Name="ProfileInitialsLabel" Text="AH" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" Padding="10,0,0,0" VerticalOptions="Center">
                        <Label x:Name="ProfileNameLabel" Text="Alex Henderson" TextColor="White" FontSize="13" FontAttributes="Bold"/>
                        <Label x:Name="ProfileRoleLabel" Text="Artisanal Collector" TextColor="#64748B" FontSize="11"/>
                    </VerticalStackLayout>
                    <Path Grid.Column="2" Data="M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.1-1.6-5.6-4.5-6.3V4c0-0.8-0.7-1.5-1.5-1.5S10.5,3.2,10.5,4v0.7C7.6,5.4,6,7.9,6,11v5l-2,2v1h16v-1L18,16z"
                          Fill="#64748B" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                </Grid>
                <BoxView HeightRequest="1" Color="#2D3748" Margin="16,8" />
                <!-- Sign Out -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSignOutTapped"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M17,7l-1.41,1.41L18.17,11H8v2h10.17l-2.58,2.58L17,17l5-5L17,7z M4,5h8V3H4C2.9,3,2,3.9,2,5v14c0,1.1,0.9,2,2,2h8v-2H4V5z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Sign Out" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>

        <!-- ===== MIDDLE COLUMN: CONVERSATIONS LIST ===== -->
        <Border Grid.Column="1" StrokeThickness="0,0,1,0" Stroke="#E2E8F0" BackgroundColor="White" Padding="0">
            <Grid RowDefinitions="Auto, *">
                <VerticalStackLayout Grid.Row="0" Padding="24,32" Spacing="24">
                    <Label Text="Conversations" TextColor="#0F172A" FontSize="24" FontAttributes="Bold" />
                    
                    <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" Padding="16,0" HeightRequest="48">
                        <Grid ColumnDefinitions="20, *">
                            <Path Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16 c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5 S11.99,14,9.5,14z" Fill="#94A3B8" Aspect="Uniform" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="Search chats..." PlaceholderColor="#94A3B8" TextColor="#0F172A" FontSize="14" Margin="12,0,0,0" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Empty Conversation List State -->
                <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Opacity="0.8">
                    <Border BackgroundColor="#F0FDFA" HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 24">
                        <Path Data="M20,2H4C2.9,2,2,2.9,2,4v18l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z M20,16H5.17L4,17.17V4h16V16z M7,9h10v2H7V9z M7,12h7v2H7V12z" 
                              Fill="#0D9488" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="NO ACTIVE CHATS" TextColor="#64748B" FontSize="12" FontAttributes="Bold" CharacterSpacing="1" HorizontalOptions="Center" />
                        <Label Text="Your messaging history will appear here&#10;once you contact a creator." 
                               TextColor="#94A3B8" FontSize="11" HorizontalTextAlignment="Center" HorizontalOptions="Center" LineHeight="1.4" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- ===== RIGHT COLUMN: CHAT AREA / EMPTY STATE ===== -->
        <Grid Grid.Column="2" RowDefinitions="*, Auto" BackgroundColor="#F8FAFC">
            
            <!-- Main Empty State Dashboard -->
            <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" HorizontalOptions="Center" Spacing="48" Padding="40">
                
                <Grid HorizontalOptions="Center">
                    <Border BackgroundColor="#E6F4F1" HeightRequest="180" WidthRequest="180" StrokeShape="RoundRectangle 90" />
                    <Path Data="M20,4H4C2.9,4,2.01,4.9,2.01,6L2,18c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V6C22,4.9,21.1,4,20,4z M20,18H4V8l8,5l8,-5V18z M12,11L4,6h16L12,11z" 
                          Fill="#0D9488" Aspect="Uniform" HeightRequest="80" WidthRequest="80" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.6" />
                    
                    <!-- Floating Compose Icon -->
                    <Border BackgroundColor="White" HeightRequest="64" WidthRequest="64" StrokeShape="RoundRectangle 16" 
                            TranslationX="80" TranslationY="40" StrokeThickness="0">
                        <Border.Shadow><Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.1" /></Border.Shadow>
                        <Path Data="M3,17.25V21h3.75L17.81,9.94l-3.75-3.75L3,17.25z M20.71,7.04c0.39-0.39,0.39-1.02,0-1.41l-2.34-2.34c-0.39-0.39-1.02-0.39-1.41,0l-1.83,1.83l3.75,3.75L20.71,7.04z" 
                              Fill="#0D9488" Aspect="Uniform" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                    <Label Text="No messages yet" TextColor="#0F172A" FontSize="36" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="Start a conversation with a creator to begin your project.&#10;Collaboration is the first step toward bringing your vision&#10;to life." 
                           TextColor="#64748B" FontSize="16" LineHeight="1.5" HorizontalTextAlignment="Center" MaximumWidthRequest="500" />
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                    <Button Text="Explore Creators" BackgroundColor="#065F46" TextColor="White" CornerRadius="8" Padding="32,16" FontAttributes="Bold" />
                    <Button Text="Start a New Chat" BackgroundColor="Transparent" TextColor="#0F172A" BorderColor="#E2E8F0" BorderWidth="1" CornerRadius="8" Padding="32,16" FontAttributes="Bold" />
                </HorizontalStackLayout>

                <BoxView HeightRequest="1" Color="#E2E8F0" WidthRequest="420" Margin="0,20" />

                <!-- Features Footer -->
                <Grid ColumnDefinitions="*, *, *" WidthRequest="400" HorizontalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="8">
                        <Path Data="M12,1L3,5v6c0,5.55,3.84,10.74,9,12c5.16-1.26,9-6.45,9-12V5L12,1z M12,11.99h7c-0.53,4.12-3.28,7.79-7,8.94V12H5V6.3l7-3.11V11.99z" 
                              Fill="#0D9488" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" />
                        <Label Text="SECURE" TextColor="#64748B" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" CharacterSpacing="1" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Path Data="M12,2c-4.97,0-9,4.03-9,9s4.03,9,9,9s9-4.03,9-9S16.97,2,12,2z M12,18c-3.31,0-6-2.69-6-6s2.69-6,6-6s6,2.69,6,6 S15.31,18,12,18z M12.5,7H11v6l5.25,3.15l0.75-1.23L12.5,12.5V7z" 
                              Fill="#0D9488" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" />
                        <Label Text="24/7 HELP" TextColor="#64748B" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" CharacterSpacing="1" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="8">
                        <Path Data="M20.54,5.23l-1.39-1.68C18.88,3.21,18.47,3,18,3H6C5.53,3,5.12,3.21,4.85,3.55L3.46,5.23C3.17,5.57,3,6.01,3,6.5V19 c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V6.5C21,6.01,20.83,5.57,20.54,5.23z M6.24,5h11.52l0.83,1H5.41L6.24,5z M5,19V8h14v11H5z M8,11 h8v2H8V11z" 
                              Fill="#0D9488" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" />
                        <Label Text="ARCHIVE" TextColor="#64748B" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" CharacterSpacing="1" />
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>

            <!-- Bottom Page Footer -->
            <Border Grid.Row="1" StrokeThickness="0,1,0,0" Stroke="#E2E8F0" BackgroundColor="White" Padding="24,16">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="© 2024 CreatiSphere. All rights reserved." TextColor="#64748B" FontSize="12" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="24" VerticalOptions="Center">
                        <Label Text="Terms" TextColor="#64748B" FontSize="12" />
                        <Label Text="Privacy" TextColor="#64748B" FontSize="12" />
                        <Label Text="Support" TextColor="#64748B" FontSize="12" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
