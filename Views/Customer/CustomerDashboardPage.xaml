<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CreatiSphere.Views.Customer.CustomerDashboardPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid ColumnDefinitions="220, *">

        <!-- ===== LEFT SIDEBAR ===== -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" BackgroundColor="#1A2332">

            <!-- Logo -->
            <HorizontalStackLayout Grid.Row="0" Padding="24,36,24,32" Spacing="12" VerticalOptions="Center">
                <Border BackgroundColor="#0D9488" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 10">
                    <Label Text="◈" TextColor="White" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="CreatiSphere" TextColor="White" FontSize="18" FontAttributes="Bold" FontFamily="Georgia" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- Nav Items -->
            <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="12,0">

                <!-- Dashboard (Active) -->
                <Border BackgroundColor="#0D9488" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M3,13h8V3H3V13z M3,21h8v-6H3V21z M13,21h8V11h-8V21z M13,3v6h8V3H13z"
                              Fill="White" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Dashboard" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Explore -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBrowseTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M12,2C8.13,2,5,5.13,5,9c0,5.25,7,13,7,13s7-7.75,7-13C19,5.13,15.87,2,12,2z M12,11.5c-1.38,0-2.5-1.12-2.5-2.5s1.12-2.5,2.5-2.5s2.5,1.12,2.5,2.5S13.38,11.5,12,11.5z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Explore" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Custom Orders -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCustomOrdersTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M17,13h-4v4h-2v-4H7v-2h4V7h2v4h4V13z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Custom Orders" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Track Orders -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTrackOrdersTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,8h-3V4H3C1.9,4,1,4.9,1,6v11h2c0,1.66,1.34,3,3,3s3-1.34,3-3h6c0,1.66,1.34,3,3,3s3-1.34,3-3h2v-5L20,8z M6,18.5c-0.83,0-1.5-0.67-1.5-1.5S5.17,15.5,6,15.5S7.5,16.17,7.5,17S6.83,18.5,6,18.5z M19,9.5l1.96,2.5H17V9.5H19z M18,18.5c-0.83,0-1.5-0.67-1.5-1.5s0.67-1.5,1.5-1.5s1.5,0.67,1.5,1.5S18.83,18.5,18,18.5z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Track Orders" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Messages -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMessagesTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,2H4C2.9,2,2,2.9,2,4v18l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Messages" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Feedback -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFeedbackTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20,2H4C2.9,2,2.01,2.9,2.01,4L2,22l4-4h14c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z M13,11h-2V5h2V11z M13,15h-2v-2h2V15z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Feedback" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Rewards -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRewardsTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M12,1L3,5v6c0,5.55,3.84,10.74,9,12c5.16-1.26,9-6.45,9-12V5L12,1z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Rewards" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>



            </VerticalStackLayout>

            <!-- User Profile & Sign Out at Bottom -->
            <VerticalStackLayout Grid.Row="2" Padding="12,24" Spacing="4">
                <!-- User Profile -->
                <Grid Padding="8,12" ColumnDefinitions="Auto,*,Auto">
                    <Border HeightRequest="38" WidthRequest="38" StrokeShape="RoundRectangle 19" StrokeThickness="0" BackgroundColor="#0D9488">
                        <Label x:Name="ProfileInitialsLabel" Text="AH" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" Padding="10,0,0,0" VerticalOptions="Center">
                        <Label x:Name="ProfileNameLabel" Text="Alex Henderson" TextColor="White" FontSize="13" FontAttributes="Bold"/>
                        <Label x:Name="ProfileRoleLabel" Text="Artisanal Collector" TextColor="#64748B" FontSize="11"/>
                    </VerticalStackLayout>
                    <Path Grid.Column="2" Data="M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.1-1.6-5.6-4.5-6.3V4c0-0.8-0.7-1.5-1.5-1.5S10.5,3.2,10.5,4v0.7C7.6,5.4,6,7.9,6,11v5l-2,2v1h16v-1L18,16z"
                          Fill="#64748B" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                </Grid>

                <BoxView HeightRequest="1" Color="#2D3748" Margin="16,8" />

                <!-- Sign Out -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSignOutTapped"/>
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M17,7l-1.41,1.41L18.17,11H8v2h10.17l-2.58,2.58L17,17l5-5L17,7z M4,5h8V3H4C2.9,3,2,3.9,2,5v14c0,1.1,0.9,2,2,2h8v-2H4V5z"
                              Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Sign Out" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>

        </Grid>

        <!-- ===== MAIN CONTENT ===== -->
        <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Never" BackgroundColor="#F8FAFC">
            <VerticalStackLayout Spacing="0">

                <!-- Main Scrollable Body -->
                <VerticalStackLayout Padding="48,48,48,0" Spacing="40">
                    <!-- Welcome Hero -->
                    <Border StrokeShape="RoundRectangle 18" StrokeThickness="0" BackgroundColor="White">
                        <Grid HeightRequest="200">
                            <Image Source="redesign_bg.png" Aspect="AspectFill"/>
                            <BoxView Color="#0F172A" Opacity="0.35"/>
                            <Grid Padding="28" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="8">
                                    <Label x:Name="WelcomeLabel" Text="Welcome back." TextColor="White" FontSize="34" FontFamily="Georgia" FontAttributes="Italic"/>
                                    <Label x:Name="WelcomeSubtitleLabel" Text="" TextColor="#E2E8F0" FontSize="14" LineHeight="1.4" MaximumWidthRequest="520"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="1" HeightRequest="56" WidthRequest="56" StrokeShape="RoundRectangle 28" StrokeThickness="0" BackgroundColor="#0D9488" VerticalOptions="Start">
                                    <Image Source="avatar.png" Aspect="AspectFill"/>
                                </Border>
                                <HorizontalStackLayout Grid.Row="2" Spacing="16" Margin="0,18,0,0">
                                    <Border BackgroundColor="#0D9488" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="12,8">
                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                            <Image Source="artist1.png" HeightRequest="20" WidthRequest="20" Aspect="AspectFill"/>
                                            <Label x:Name="ActiveCommissionsCountLabel" Text="0" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                                            <Label Text="Active" TextColor="#CCFBF1" FontSize="12"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                    <Border BackgroundColor="#1E293B" StrokeShape="RoundRectangle 10" StrokeThickness="0" Padding="12,8">
                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                            <Image Source="artist2.png" HeightRequest="20" WidthRequest="20" Aspect="AspectFill"/>
                                            <Label x:Name="RecentUpdatesCountLabel" Text="0" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                                            <Label Text="Updates" TextColor="#CBD5F5" FontSize="12"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </HorizontalStackLayout>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Active Commissions + Rewards Row -->
                    <Grid ColumnDefinitions="*, 300" ColumnSpacing="32">

                        <!-- Left: Active Commissions -->
                        <VerticalStackLayout Spacing="20">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Active Commissions" TextColor="#0F172A" FontSize="20" FontFamily="Georgia" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="View All" TextColor="#0D9488" FontSize="14" VerticalOptions="Center">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTrackOrdersTapped"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                            <CollectionView x:Name="CommissionsCollectionView">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="16" VerticalItemSpacing="16" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White">
                                            <VerticalStackLayout>
                                                <Border StrokeThickness="0" HeightRequest="160" BackgroundColor="#E8EDF2">
                                                    <Image Source="{Binding ImagePath}" Aspect="AspectFill" HeightRequest="160"/>
                                                </Border>
                                                <VerticalStackLayout Padding="18,14" Spacing="10">
                                                    <Label Text="{Binding Title}" TextColor="#0F172A" FontSize="15" FontAttributes="Bold" LineBreakMode="WordWrap"/>
                                                    <Label Text="{Binding ArtistName, StringFormat='Artist: {0}'}" TextColor="#64748B" FontSize="12"/>
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <Label Text="{Binding Status, StringFormat='Production Stage: {0}'}" TextColor="#64748B" FontSize="12"/>
                                                        <Label Grid.Column="1" Text="{Binding Progress, StringFormat='{0}%'}" TextColor="#0D9488" FontSize="12" FontAttributes="Bold"/>
                                                    </Grid>
                                                    <Grid HeightRequest="6">
                                                        <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 3" StrokeThickness="0" HeightRequest="6"/>
                                                        <Border BackgroundColor="#0D9488" StrokeShape="RoundRectangle 3" StrokeThickness="0" HeightRequest="6" HorizontalOptions="Start" WidthRequest="{Binding ProgressBarWidth}"/>
                                                    </Grid>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                        <!-- Right: Rewards & Loyalty Card -->
                        <Border Grid.Column="1" BackgroundColor="#0D9488" Padding="28" StrokeShape="RoundRectangle 16" StrokeThickness="0" VerticalOptions="Start">
                            <VerticalStackLayout Spacing="28">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="REWARDS &amp; LOYALTY" TextColor="White" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.5" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="✪" TextColor="White" FontSize="22"/>
                                </Grid>

                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Current Balance" TextColor="#A7F3D0" FontSize="13"/>
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label x:Name="PointsLabel" Text="0" TextColor="White" FontSize="40" FontAttributes="Bold"/>
                                        <Label Text="pts" TextColor="#A7F3D0" FontSize="16" VerticalOptions="End" Margin="0,0,0,6"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Border BackgroundColor="#0A7A68" Padding="12,6" StrokeShape="RoundRectangle 14" StrokeThickness="0" HorizontalOptions="Start">
                                    <HorizontalStackLayout Spacing="8">
                                        <Ellipse WidthRequest="8" HeightRequest="8" Fill="#34D399" VerticalOptions="Center"/>
                                        <Label x:Name="TierLabel" Text="Artisanal Collector Tier" TextColor="#A7F3D0" FontSize="12" FontAttributes="Bold"/>
                                    </HorizontalStackLayout>
                                </Border>

                                <Button Text="Redeem Benefits" BackgroundColor="#CCFBF1" TextColor="#065F46"
                                        CornerRadius="8" Padding="0,14" FontAttributes="Bold" FontSize="14"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Bottom Row: Recent Activity + Featured Cards -->
                    <Grid ColumnDefinitions="*, 300" ColumnSpacing="32" Margin="0,0,0,48">

                        <!-- Recent Activity -->
                        <Border Padding="28" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White">
                            <VerticalStackLayout Spacing="22">
                                <Label Text="Recent Activity" TextColor="#0F172A" FontSize="20" FontFamily="Georgia" FontAttributes="Bold"/>

                                <CollectionView x:Name="ActivityCollectionView">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16" Margin="0,0,0,16">
                                                <Border BackgroundColor="#F0FDFA" HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                                                    <Path Data="M3,17.25V21h3.75L17.81,9.94l-3.75-3.75L3,17.25z" Fill="#0D9488" Aspect="Uniform" HeightRequest="15" WidthRequest="15" VerticalOptions="Center" HorizontalOptions="Center"/>
                                                </Border>
                                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                    <Label Text="{Binding Title}" TextColor="#0F172A" FontSize="14" FontAttributes="Bold"/>
                                                    <Label Text="{Binding Timestamp}" TextColor="#94A3B8" FontSize="12"/>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Featured Cards Stack -->
                        <CollectionView x:Name="HighlightsCollectionView" Grid.Column="1">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="16" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0" StrokeShape="RoundRectangle 12" StrokeThickness="0" HeightRequest="180">
                                        <Grid>
                                            <Image Source="{Binding ImagePath}" Aspect="AspectFill"/>
                                            <BoxView Color="#1A2332" Opacity="0.55"/>
                                            <VerticalStackLayout Padding="20" VerticalOptions="End" Spacing="6">
                                                <Label Text="{Binding Category}" TextColor="#6EE7B7" FontSize="11" FontAttributes="Bold" CharacterSpacing="0.5"/>
                                                <Label Text="{Binding Title}" TextColor="White" FontSize="17" FontAttributes="Bold" FontFamily="Georgia" LineBreakMode="WordWrap"/>
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="{Binding ActionText}" TextColor="White" FontSize="13"/>
                                                    <Label Text="→" TextColor="White" FontSize="15"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </Grid>
                </VerticalStackLayout>

                <!-- Footer -->
                <Grid Padding="48,40" ColumnDefinitions="Auto,*" BackgroundColor="#F1F5F9">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="CreatiSphere" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" FontFamily="Georgia"/>
                        <Label Text="© 2024 CreatiSphere. All rights reserved." TextColor="#94A3B8" FontSize="12"/>
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="28" HorizontalOptions="End" VerticalOptions="Center">
                        <Label Text="Terms of Service" TextColor="#64748B" FontSize="13"/>
                        <Label Text="Privacy Policy" TextColor="#64748B" FontSize="13"/>
                        <Label Text="Contact Support" TextColor="#64748B" FontSize="13"/>
                        <Label Text="Help Center" TextColor="#64748B" FontSize="13"/>
                    </HorizontalStackLayout>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
