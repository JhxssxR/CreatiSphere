<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CreatiSphere.Views.SuperAdmin.UsersPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Slate50}">

    <ContentPage.Resources>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1" />
                                <Setter Property="BackgroundColor" Value="White" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1.03" />
                                <Setter Property="BackgroundColor" Value="#F8FAFC" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="280, *">
        <!-- Sidebar -->
        <Grid Grid.Column="0" BackgroundColor="{StaticResource Slate900}" RowDefinitions="Auto, *, Auto">
            <!-- Logo Section -->
            <HorizontalStackLayout Spacing="16" Padding="24, 32" VerticalOptions="Center">
                <Border BackgroundColor="{StaticResource DashboardTeal}" 
                        HeightRequest="40" WidthRequest="40" 
                        StrokeShape="RoundRectangle 8" StrokeThickness="0">
                    <Label Text="◈" TextColor="White" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="CreatiSphere" TextColor="White" FontSize="18" FontAttributes="Bold" />
                    <Label Text="SUPER ADMIN CONSOLE" TextColor="{StaticResource Slate400}" FontSize="9" FontAttributes="Bold" CharacterSpacing="1" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- Navigation Menu -->
            <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="0, 16">
                <!-- Dashboard -->
                <Grid Padding="24, 12" ColumnDefinitions="24, *" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDashboardClicked" />
                    </Grid.GestureRecognizers>
                    <Path Data="M3,13h8V3H3V13z M3,21h8v-6H3V21z M13,21h8V11h-8V21z M13,3v6h8V3H13z" 
                          Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Dashboard" TextColor="{StaticResource Slate400}" FontSize="14" VerticalOptions="Center" Margin="12,0,0,0" />
                </Grid>

                <!-- MSME Directory -->
                <Grid Padding="24, 12" ColumnDefinitions="24, *" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMsmeDirectoryClicked" />
                    </Grid.GestureRecognizers>
                    <Path Data="M20,4H4v2h16V4z M22,13v2v5c0,1.1-0.9,2-2,2H4c-1.1,0-2-0.9-2-2v-5v-2c0-0.6,0.1-1.2,0.4-1.8l2.3-5.7C5,7.7,5.9,7,7,7h10 c1.1,0,2-0.7,2.3,1.5l2.3,5.7C21.9,11.8,22,12.4,22,13z M19,13H5l-1.6,4h17.2L19,13z" 
                          Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Manage MSMEs" TextColor="{StaticResource Slate400}" FontSize="14" VerticalOptions="Center" Margin="12,0,0,0" />
                </Grid>

                <!-- Manage Users (Active) -->
                <Border StrokeShape="RoundRectangle 0" StrokeThickness="0" BackgroundColor="{StaticResource Slate800}" Padding="24, 12">
                    <Grid ColumnDefinitions="24, *">
                        <Border WidthRequest="4" HeightRequest="24" BackgroundColor="{StaticResource DashboardTeal}" HorizontalOptions="Start" Margin="-24,0,0,0" />
                        <Path Data="M12,12c2.2,0,4-1.8,4-4s-1.8-4-4-4s-4,1.8-4,4S9.8,12,12,12z M12,14c-2.7,0-8,1.3-8,4v2h16v-2C20,15.3,14.7,14,12,14z" 
                              Fill="White" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Manage Users" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <!-- Other Items -->
                <VerticalStackLayout Spacing="4">
                    <Grid Padding="24, 12" ColumnDefinitions="24, *" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnManageModulesClicked" />
                        </Grid.GestureRecognizers>
                        <Path Data="M20,12c0-1.1,0.9-2,2-2V6c0-1.1-0.9-2-2-2h-4c0-1.1-0.9-2-2-2s-2,0.9-2,2H8C6.9,4,6,4.9,6,6v4c-1.1,0-2,0.9-2,2 s0.9,2,2,2v4c0,1.1,0.9,2,2,2h4c0,1.1,0.9,2,2,2s2-0.9,2-2h4c1.1,0,2-0.9,2-2v-4C19.1,14,20,13.1,20,12z" 
                              Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Manage Modules" TextColor="{StaticResource Slate400}" FontSize="14" VerticalOptions="Center" Margin="12,0,0,0" />
                    </Grid>

                    <Grid Padding="24, 12" ColumnDefinitions="24, *" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMonitorSystemClicked" />
                        </Grid.GestureRecognizers>
                        <Path Data="M21,2H3C1.9,2,1,2.9,1,4v12c0,1.1,0.9,2,2,2h7l-2,3v1h8v-1l-2-3h7c1.1,0,2-0.9,2-2V4C23,2.9,22.1,2,21,2z M21,16H3V4h18V16z" 
                              Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Monitor System" TextColor="{StaticResource Slate400}" FontSize="14" VerticalOptions="Center" Margin="12,0,0,0" />
                    </Grid>

                    <Grid Padding="24, 12" ColumnDefinitions="24, *" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSystemReportsClicked" />
                        </Grid.GestureRecognizers>
                        <Path Data="M14,2H6C4.9,2,4,2.9,4,4v16c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V8L14,2z M18,20H6V4h7v5h5V20z" 
                              Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="System Reports" TextColor="{StaticResource Slate400}" FontSize="14" VerticalOptions="Center" Margin="12,0,0,0" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Sign Out -->
            <Grid Grid.Row="2" Padding="24, 48" ColumnDefinitions="24, *" BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSignOutClicked" />
                </Grid.GestureRecognizers>
                <Path Data="M17,7l-1.4,1.4L18.2,11H9v2h9.2l-2.6,2.6L17,17l5-5L17,7z M5,5h7V3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h7v-2H5V5z" 
                      Fill="{StaticResource WarningOrange}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="Sign Out" TextColor="White" FontSize="14" VerticalOptions="Center" Margin="12,0,0,0" />
            </Grid>
        </Grid>

        <!-- Main Content Area -->
        <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="40" Spacing="32">
                
                <!-- Top Nav Bar -->
                <Grid ColumnDefinitions="*, Auto">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 24" Stroke="{StaticResource Slate200}" BackgroundColor="{StaticResource Slate50}" HorizontalOptions="Start" WidthRequest="400" Padding="16, 8">
                        <Grid ColumnDefinitions="Auto, *">
                            <Path Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16 c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5 S11.99,14,9.5,14z" 
                                  Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="Global system search..." PlaceholderColor="{StaticResource Slate400}" TextColor="{StaticResource Slate900}" BackgroundColor="Transparent" Margin="12,0,0,0" FontSize="13" />
                        </Grid>
                    </Border>

                    <HorizontalStackLayout Grid.Column="1" Spacing="24" VerticalOptions="Center">
                        <Path Data="M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.1-1.6-5.6-4.5-6.3V4c0-0.8-0.7-1.5-1.5-1.5 S10.5,3.2,10.5,4v0.7C7.6,5.4,6,7.9,6,11v5l-2,2v1h16v-1L18,16z" 
                              Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                        <Path Data="M19.1,12.9l2.1,1.6c0.2,0.1,0.2,0.4,0.1,0.6l-2,3.5c-0.1,0.2-0.4,0.3-0.6,0.2l-2.5-1c-0.5,0.4-1.1,0.7-1.7,1 l-0.4,2.6c0,0.2-0.2,0.4-0.5,0.4h-4c-0.3,0-0.5-0.2-0.5-0.4l-0.4-2.6c-0.6-0.3-1.2-0.6-1.7-1l-2.5,1c-0.2,0.1-0.5,0-0.6-0.2l-2-3.5 C1.9,14.9,2,14.6,2.2,14.5l2.1-1.6c-0.1-0.3-0.1-0.6-0.1-0.9s0-0.6,0.1-0.9L2.2,8.6c-0.2-0.1-0.2-0.4-0.1-0.6l2-3.5c0.1-0.2,0.4-0.3,0.6-0.2 l2.5,1c0.5-0.4,1.1-0.7,1.7-1L9.4,1.7c0-0.2,0.2-0.4,0.5-0.4h4c0.3,0,0.5,0.2,0.5,0.4l0.4,2.6c0.6,0.3,1.2,0.6,1.7,1l2.5-1 c0.2-0.1,0.5,0,0.6,0.2l2,3.5c0.1,0.2,0,0.5-0.2,0.6l-2.1,1.6c0.1,0.3,0.1,0.6,0.1,0.9S19.2,12.6,19.1,12.9z M12,15c1.7,0,3-1.3,3-3 s-1.3-3-3-3s-3,1.3-3,3S10.3,15,12,15z" 
                              Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                        
                        <HorizontalStackLayout Spacing="12">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label x:Name="UserNameLabel" Text="Marcus Thorne" TextColor="{StaticResource Slate900}" FontSize="14" FontAttributes="Bold" HorizontalOptions="End" />
                                <Label x:Name="UserRoleLabel" Text="SUPER ADMIN" TextColor="{StaticResource DashboardTeal}" FontSize="10" FontAttributes="Bold" HorizontalOptions="End" CharacterSpacing="0.5" />
                            </VerticalStackLayout>
                            <Grid>
                                <Border HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                                    <Image Source="avatar.png" Aspect="AspectFill" />
                                </Border>
                                <Border BackgroundColor="#22C55E" HeightRequest="10" WidthRequest="10" StrokeShape="RoundRectangle 5" StrokeThickness="2" Stroke="White" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,0,2" />
                            </Grid>
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Page Header -->
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Manage Users" TextColor="{StaticResource Slate900}" FontSize="28" FontAttributes="Bold" />
                        <Label Text="Control administrative access and roles for the CreatiSphere platform." TextColor="{StaticResource Slate500}" FontSize="14" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Add New User" Clicked="OnAddUserClicked" BackgroundColor="{StaticResource DashboardTeal}" TextColor="White" Padding="24, 0" HeightRequest="44" CornerRadius="8" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                </Grid>

                <!-- Stats Cards -->
                <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="24">
                    <!-- Total Admins -->
                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                        <Border.Shadow><Shadow Brush="Black" Opacity="0.05" Offset="0,4" Radius="10"/></Border.Shadow>
                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, *">
                            <Border Grid.RowSpan="2" BackgroundColor="#F0FDFA" HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                <Path Data="M18,8c0-4.42-3.58-8-8-8S2,3.58,2,8c0,4.42,3.58,8,8,8S18,12.42,18,8z M10,2c3.31,0,6,2.69,6,6s-2.69,6-6,6s-6-2.69-6-6 S6.69,2,10,2z M10,18c-4.42,0-13,2.21-13,6.67V28h26v-3.33C23,20.21,14.42,18,10,18z M2,24c1.11-1.33,4.64-2,8-2s6.89,0.67,8,2v2H2V24z" 
                                      Fill="{StaticResource DashboardTeal}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="#DCFCE7" Padding="6,2" StrokeShape="RoundRectangle 4" HorizontalOptions="End">
                                <Label x:Name="MonthlyGrowthLabel" Text="+4% this mo" TextColor="#15803D" FontSize="10" FontAttributes="Bold" />
                            </Border>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Margin="16,0,0,0">
                                <Label Text="TOTAL ADMINS" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                                <Label x:Name="TotalAdminsLabel" Text="0" TextColor="{StaticResource Slate900}" FontSize="24" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Active Sessions -->
                    <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                        <Border.Shadow><Shadow Brush="Black" Opacity="0.05" Offset="0,4" Radius="10"/></Border.Shadow>
                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, *">
                            <Border Grid.RowSpan="2" BackgroundColor="#EFF6FF" HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                <Path Data="M11.5,2L2,13h9v9l9.5-11h-9V2z" 
                                      Fill="#2563EB" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="4">
                                <Ellipse Fill="#22C55E" WidthRequest="6" HeightRequest="6" VerticalOptions="Center" />
                                <Label Text="Live" TextColor="{StaticResource Slate500}" FontSize="10" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Margin="16,0,0,0">
                                <Label Text="ACTIVE SESSIONS" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                                <Label x:Name="ActiveSessionsLabel" Text="0" TextColor="{StaticResource Slate900}" FontSize="24" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Pending Requests -->
                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                        <Border.Shadow><Shadow Brush="Black" Opacity="0.05" Offset="0,4" Radius="10"/></Border.Shadow>
                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, *">
                            <Border Grid.RowSpan="2" BackgroundColor="#FFF1F2" HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                <Path Data="M19,3h-4.18C14.4,1.84,13.3,1,12,1S9.6,1.84,9.18,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5 C21,3.9,20.1,3,19,3z M12,3c0.55,0,1,0.45,1,1s-0.45,1-1,1s-1-0.45-1-1S11.45,3,12,3z M19,19H5V5h2v2h10V5h2V19z" 
                                      Fill="#E11D48" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label x:Name="PriorityStatusLabel" Grid.Column="1" Text="High Priority" TextColor="#E11D48" FontSize="10" FontAttributes="Bold" HorizontalOptions="End" />
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Margin="16,0,0,0">
                                <Label Text="PENDING REQUESTS" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                                <Label x:Name="PendingRequestsLabel" Text="0" TextColor="{StaticResource Slate900}" FontSize="24" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Role Distribution -->
                    <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                        <Border.Shadow><Shadow Brush="Black" Opacity="0.05" Offset="0,4" Radius="10"/></Border.Shadow>
                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, *">
                            <Border Grid.RowSpan="2" BackgroundColor="{StaticResource Slate100}" HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                <Path Data="M11,2v20c-5.07,0-9.22-3.72-9.92-8.5h2.02C3.79,16.84,7.07,20,11,20v-2.02c-1.84-0.49-3.33-1.88-4-3.72c-0.1-0.27-0.18-0.56-0.24-0.85H2.08 C2.5,9.5,6.3,6,11,6V2c-6.62,0-12,5.38-12,12s5.38,12,12,12s12-5.38,12-12c0-3.31-1.34-6.31-3.51-8.49L18.07,4.93C19.89,6.75,21,9.25,21,12 c0,5.52-4.48,10-10,10z" 
                                      Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" Spacing="8">
                                <Label Text="ROLE DISTRIBUTION" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                                <Border BackgroundColor="{StaticResource Slate100}" HeightRequest="8" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                                    <BoxView x:Name="RoleDistributionBar" BackgroundColor="{StaticResource DashboardTeal}" WidthRequest="0" HorizontalOptions="Start" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Table Content -->
                <Border Padding="0" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                    <Border.Shadow><Shadow Brush="Black" Opacity="0.05" Offset="0,4" Radius="10"/></Border.Shadow>
                    <VerticalStackLayout>
                        <!-- Table Toolbar -->
                        <Grid Padding="24" ColumnDefinitions="*, Auto, Auto, Auto, Auto">
                            <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Slate200}" BackgroundColor="White" WidthRequest="300" Padding="12, 0" HorizontalOptions="Start">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Path Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16 c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5 S11.99,14,9.5,14z" 
                                          Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" Placeholder="Search by name or email..." PlaceholderColor="{StaticResource Slate400}" FontSize="12" BackgroundColor="Transparent" Margin="8,0,0,0" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Padding="12,0" StrokeShape="RoundRectangle 8" Stroke="{StaticResource Slate200}" HeightRequest="36" Margin="12,0">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Picker x:Name="RoleFilterPicker" Title="All Roles" SelectedIndexChanged="OnFilterChanged" 
                                            TextColor="{StaticResource Slate600}" FontSize="12" VerticalOptions="Center" BackgroundColor="Transparent">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>All Roles</x:String>
                                                <x:String>Super Admin</x:String>
                                                <x:String>Admin</x:String>
                                                <x:String>Creator</x:String>
                                                <x:String>Customer</x:String>
                                                <x:String>Sales</x:String>
                                                <x:String>Finance</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                                    <Path Grid.Column="1" Data="M7,10l5,5l5-5H7z" Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="10" WidthRequest="10" VerticalOptions="Center" InputTransparent="True" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Padding="12,0" StrokeShape="RoundRectangle 8" Stroke="{StaticResource Slate200}" HeightRequest="36">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="Any Status" TextColor="{StaticResource Slate600}" FontSize="12" VerticalOptions="Center" />
                                    <Path Data="M7,10l5,5l5-5H7z" Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="10" WidthRequest="10" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <Border Grid.Column="3" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 8" Stroke="{StaticResource Slate200}" Margin="12,0">
                                <Path Data="M10,18h4v-2h-4V18z M3,6v2h18V6H3z M6,13h12v-2H6V13z" Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="16" WidthRequest="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Column="4" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 8" Stroke="{StaticResource Slate200}">
                                <Path Data="M19,9h-4V3H9v6H5l7,7L19,9z M5,18v2h14v-2H5z" Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="16" WidthRequest="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Slate100}" />

                        <!-- Table Headers -->
                        <Grid Padding="24, 16" ColumnDefinitions="25*, 15*, 25*, 15*, 10*, 10*">
                            <Label Text="NAME / AVATAR" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="ROLE" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="2" Text="EMAIL" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="3" Text="LAST ACTIVE" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="4" Text="STATUS" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Grid.Column="5" Text="ACTIONS" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                        </Grid>

                        <!-- Table Rows -->
                        <CollectionView x:Name="UsersCollectionView" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout>
                                        <Grid Padding="24, 16" ColumnDefinitions="25*, 15*, 25*, 15*, 10*, 10*" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="12">
                                                <Border HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" BackgroundColor="#E0F2F1" StrokeThickness="0">
                                                    <Label Text="{Binding Initials}" TextColor="{StaticResource DashboardTeal}" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <VerticalStackLayout VerticalOptions="Center">
                                                    <Label Text="{Binding Username}" TextColor="{StaticResource Slate900}" FontSize="14" FontAttributes="Bold" />
                                                    <Label Text="ID: CS-XXXX" TextColor="{StaticResource Slate400}" FontSize="11" />
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>
                                            <Border Grid.Column="1" BackgroundColor="#E0F2F1" Padding="8,4" StrokeShape="RoundRectangle 6" HorizontalOptions="Start" VerticalOptions="Center">
                                                <Label Text="{Binding Role}" TextColor="{StaticResource SuccessGreenText}" FontSize="11" FontAttributes="Bold" />
                                            </Border>
                                            <Label Grid.Column="2" Text="{Binding Email}" TextColor="{StaticResource Slate600}" FontSize="13" VerticalOptions="Center" />
                                            <Label Grid.Column="3" Text="{Binding LastActive}" TextColor="{StaticResource Slate600}" FontSize="13" VerticalOptions="Center" />
                                            <HorizontalStackLayout Grid.Column="4" HorizontalOptions="Center" VerticalOptions="Center" Spacing="6">
                                                <Ellipse WidthRequest="6" HeightRequest="6">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#22C55E" />
                                                            <Style.Triggers>
                                                                <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Inactive">
                                                                    <Setter Property="Fill" Value="#EF4444" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="INACTIVE">
                                                                    <Setter Property="Fill" Value="#EF4444" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <Label Text="{Binding Status}" FontSize="12">
                                                    <Label.Style>
                                                        <Style TargetType="Label">
                                                            <Setter Property="TextColor" Value="{StaticResource Slate600}" />
                                                            <Style.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Inactive">
                                                                    <Setter Property="TextColor" Value="#EF4444" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="INACTIVE">
                                                                    <Setter Property="TextColor" Value="#EF4444" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Label.Style>
                                                </Label>
                                            </HorizontalStackLayout>
                                            <Label Grid.Column="5" Text="⋮" TextColor="{StaticResource Slate400}" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnUserOptionsClicked" CommandParameter="{Binding .}" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Slate50}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Pagination -->
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Slate100}" />
                        <Grid Padding="24" ColumnDefinitions="*, Auto">
                            <Label Text="Showing 1 - 4 of 128 users" TextColor="{StaticResource Slate400}" FontSize="12" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <Path Data="M15.41,16.59L10.83,12l4.58-4.59L14,6l-6,6l6,6L15.41,16.59z" Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                                <Border BackgroundColor="{StaticResource DashboardTeal}" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 8">
                                    <Label Text="1" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="2" TextColor="{StaticResource Slate600}" FontSize="12" VerticalOptions="Center" Margin="8,0" />
                                <Label Text="3" TextColor="{StaticResource Slate600}" FontSize="12" VerticalOptions="Center" Margin="8,0" />
                                <Label Text="..." TextColor="{StaticResource Slate600}" FontSize="12" VerticalOptions="Center" Margin="8,0" />
                                <Label Text="32" TextColor="{StaticResource Slate600}" FontSize="12" VerticalOptions="Center" Margin="8,0" />
                                <Path Data="M8.59,16.59L13.17,12L8.59,7.41L10,6l6,6l-6,6L8.59,16.59z" Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Bottom Sections -->
                <Grid ColumnDefinitions="*, 320" ColumnSpacing="24">
                    <!-- Access Control Policy -->
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="{StaticResource Slate900}" Padding="40">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Spacing="20">
                                <Label Text="Access Control Policy" TextColor="White" FontSize="24" FontAttributes="Bold" />
                                <Label Text="Security protocols require all new admin invites to be approved by at least two Super Admins. Audit logs are maintained for all role changes." 
                                       TextColor="{StaticResource Slate400}" FontSize="14" MaxLines="2" LineBreakMode="WordWrap" />
                                <HorizontalStackLayout Spacing="16">
                                    <Button Text="Review Security Policy" BackgroundColor="{StaticResource DashboardTeal}" TextColor="White" HeightRequest="44" CornerRadius="8" Padding="24,0" FontAttributes="Bold" />
                                    <Button Text="View Audit Log" BackgroundColor="Transparent" TextColor="White" BorderColor="{StaticResource Slate700}" BorderWidth="1" HeightRequest="44" CornerRadius="8" Padding="24,0" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Path Grid.Column="1" Data="M12,1L3,5v6c0,5.55,3.84,10.74,9,12c5.16-1.26,9-6.45,9-12V5L12,1L12,1z M12,11.99h7c-0.53,4.12-3.28,7.79-7,8.94V12H5V6.3l7-3.11V11.99z" 
                                  Fill="{StaticResource Slate800}" Aspect="Uniform" HeightRequest="120" WidthRequest="120" VerticalOptions="Center" Opacity="0.5" />
                        </Grid>
                    </Border>

                    <!-- Recent Activity -->
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="{StaticResource Slate100}" Padding="24">
                        <VerticalStackLayout Spacing="20">
                            <Label Text="RECENT ACTIVITY" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                            
                            <!-- Activity 1 -->
                            <Grid ColumnDefinitions="Auto, *">
                                <Ellipse Fill="{StaticResource DashboardTeal}" WidthRequest="8" HeightRequest="8" VerticalOptions="Start" Margin="0,6,12,0" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="New Super Admin Invited" TextColor="{StaticResource Slate900}" FontSize="13" FontAttributes="Bold" />
                                    <Label Text="Julianne Deauville invited Sarah Smith" TextColor="{StaticResource Slate600}" FontSize="11" />
                                    <Label Text="14 MINS AGO" TextColor="{StaticResource Slate400}" FontSize="9" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Activity 2 -->
                            <Grid ColumnDefinitions="Auto, *">
                                <Ellipse Fill="{StaticResource Slate400}" WidthRequest="8" HeightRequest="8" VerticalOptions="Start" Margin="0,6,12,0" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Password Reset" TextColor="{StaticResource Slate900}" FontSize="13" FontAttributes="Bold" />
                                    <Label Text="Arthur Chen reset his credentials" TextColor="{StaticResource Slate600}" FontSize="11" />
                                    <Label Text="2 HOURS AGO" TextColor="{StaticResource Slate400}" FontSize="9" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Activity 3 -->
                            <Grid ColumnDefinitions="Auto, *">
                                <Ellipse Fill="#E11D48" WidthRequest="8" HeightRequest="8" VerticalOptions="Start" Margin="0,6,12,0" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="User Deactivated" TextColor="{StaticResource Slate900}" FontSize="13" FontAttributes="Bold" />
                                    <Label Text="Marcus Thorne deactivated account #0091" TextColor="{StaticResource Slate600}" FontSize="11" />
                                    <Label Text="5 HOURS AGO" TextColor="{StaticResource Slate400}" FontSize="9" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Grid>
                            <Button Text="View All Activities" BackgroundColor="Transparent" TextColor="{StaticResource DashboardTeal}" BorderColor="{StaticResource DashboardTeal}" BorderWidth="1" HeightRequest="36" CornerRadius="8" FontSize="12" Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Add User Modal Overlay -->
        <Grid x:Name="AddUserModal" Grid.ColumnSpan="2" BackgroundColor="#990F172A" IsVisible="False">
            <Border BackgroundColor="White" 
                    VerticalOptions="Center" HorizontalOptions="Center"
                    WidthRequest="480" Padding="0" 
                    StrokeShape="RoundRectangle 24" StrokeThickness="0">
                <Border.Shadow><Shadow Brush="Black" Opacity="0.15" Offset="0,20" Radius="40"/></Border.Shadow>
                
                <VerticalStackLayout Spacing="0">
                    <!-- Modal Header -->
                    <Grid Padding="32, 32, 32, 24" ColumnDefinitions="Auto, *">
                        <Border BackgroundColor="#F0FDFA" HeightRequest="56" WidthRequest="56" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                            <Path Data="M12,12c2.2,0,4-1.8,4-4s-1.8-4-4-4s-4,1.8-4,4S9.8,12,12,12z M12,14c-2.7,0-8,1.3-8,4v2h16v-2C20,15.3,14.7,14,12,14z" 
                                  Fill="{StaticResource DashboardTeal}" Aspect="Uniform" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="16,0,0,0" Spacing="4">
                            <Label Text="Add New Administrator" TextColor="{StaticResource Slate900}" FontSize="22" FontAttributes="Bold" />
                            <Label Text="Create a new administrative account" TextColor="{StaticResource Slate500}" FontSize="13" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Slate100}" Margin="0" />

                    <!-- Modal Body -->
                    <Grid RowDefinitions="Auto, Auto, Auto" Padding="32" RowSpacing="24">
                        <!-- Username -->
                        <VerticalStackLayout Grid.Row="0" Spacing="8">
                            <Label Text="USERNAME" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" CharacterSpacing="0.5" />
                            <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Slate200}" BackgroundColor="#F8FAFC" Padding="16, 0" HeightRequest="48">
                                <Entry x:Name="NewUserUsername" Placeholder="e.g. sarah_smith" PlaceholderColor="{StaticResource Slate400}" TextColor="{StaticResource Slate900}" BackgroundColor="Transparent" FontSize="14" VerticalTextAlignment="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Email -->
                        <VerticalStackLayout Grid.Row="1" Spacing="8">
                            <Label Text="EMAIL ADDRESS" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" CharacterSpacing="0.5" />
                            <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Slate200}" BackgroundColor="#F8FAFC" Padding="16, 0" HeightRequest="48">
                                <Entry x:Name="NewUserEmail" Placeholder="sarah@example.com" PlaceholderColor="{StaticResource Slate400}" TextColor="{StaticResource Slate900}" BackgroundColor="Transparent" FontSize="14" VerticalTextAlignment="Center" Keyboard="Email" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Role and Password Row -->
                        <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="20">
                            <!-- Role -->
                            <VerticalStackLayout Grid.Column="0" Spacing="8">
                                <Label Text="ROLE TYPE" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" CharacterSpacing="0.5" />
                                <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Slate200}" BackgroundColor="#F8FAFC" Padding="12, 0" HeightRequest="48">
                                    <Picker x:Name="NewUserRole" TextColor="{StaticResource Slate900}" Title="Select Role" BackgroundColor="Transparent" FontSize="14" VerticalOptions="Center">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>Super Admin</x:String>
                                                <x:String>Admin</x:String>
                                                <x:String>Creator</x:String>
                                                <x:String>Customer</x:String>
                                                <x:String>Sales</x:String>
                                                <x:String>Finance</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Password -->
                            <VerticalStackLayout Grid.Column="1" Spacing="8">
                                <Label Text="PASSWORD" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" CharacterSpacing="0.5" />
                                <Border StrokeShape="RoundRectangle 12" Stroke="{StaticResource Slate200}" BackgroundColor="#F8FAFC" Padding="16, 0" HeightRequest="48">
                                    <Entry x:Name="NewUserPassword" IsPassword="True" Placeholder="••••••••" TextColor="{StaticResource Slate900}" BackgroundColor="Transparent" FontSize="14" VerticalTextAlignment="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>

                    <!-- Modal Footer -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="16" Padding="32, 0, 32, 32">
                        <Button Text="Cancel" Clicked="OnCancelModalClicked" BackgroundColor="Transparent" BorderColor="{StaticResource Slate200}" BorderWidth="1" TextColor="{StaticResource Slate600}" HeightRequest="48" CornerRadius="12" FontSize="14" FontAttributes="Bold" />
                        <Button Grid.Column="1" Text="Create Account" Clicked="OnSaveUserClicked" BackgroundColor="{StaticResource DashboardTeal}" TextColor="White" HeightRequest="48" CornerRadius="12" FontAttributes="Bold" FontSize="14" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
