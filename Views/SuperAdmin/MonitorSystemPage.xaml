                                    <Label Text="Optimized Fleet Performance" TextColor="{StaticResource Slate900}" FontSize="12" FontAttributes="Bold" />
                                    <Label Text="Fleet utilization is currently 15% more efficient than last week's average." TextColor="{StaticResource DashboardTeal}" FontSize="11" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Incidents Table -->
                <Border Padding="0" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                    <Border.Shadow><Shadow Brush="Black" Opacity="0.05" Offset="0,4" Radius="10"/></Border.Shadow>
                    <VerticalStackLayout>
                        <Grid Padding="24" ColumnDefinitions="*, Auto">
                            <Label Text="Recent System Incidents" TextColor="{StaticResource Slate900}" FontSize="16" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="View All Logs" TextColor="{StaticResource DashboardTeal}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Slate100}" />

                        <!-- Headers -->
                        <Grid Padding="24, 16" ColumnDefinitions="2*, 2*, 4*, 1.5*, 1.5*">
                            <Label Text="TIMESTAMP" TextColor="{StaticResource Slate600}" FontSize="11" FontAttributes="Bold" CharacterSpacing="0.5" />
                            <Label Grid.Column="1" Text="COMPONENT" TextColor="{StaticResource Slate600}" FontSize="11" FontAttributes="Bold" CharacterSpacing="0.5" />
                            <Label Grid.Column="2" Text="INCIDENT TITLE" TextColor="{StaticResource Slate600}" FontSize="11" FontAttributes="Bold" CharacterSpacing="0.5" />
                            <Label Grid.Column="3" Text="SEVERITY" TextColor="{StaticResource Slate600}" FontSize="11" FontAttributes="Bold" CharacterSpacing="0.5" HorizontalOptions="Center" />
                            <Label Grid.Column="4" Text="STATUS" TextColor="{StaticResource Slate600}" FontSize="11" FontAttributes="Bold" CharacterSpacing="0.5" HorizontalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Slate100}" />

                        <CollectionView x:Name="IncidentsCollectionView" Margin="0">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout>
                                        <Grid Padding="24, 16" ColumnDefinitions="2*, 2*, 4*, 1.5*, 1.5*" VerticalOptions="Center">
                                            <VerticalStackLayout VerticalOptions="Center">
                                                <Label Text="{Binding Timestamp}" TextColor="{StaticResource Slate600}" FontSize="13" />
                                                <Label Text="{Binding Time}" TextColor="{StaticResource Slate600}" FontSize="13" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding Component}" TextColor="{StaticResource Slate900}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="{Binding Title}" TextColor="{StaticResource Slate600}" FontSize="13" VerticalOptions="Center" />
                                            <Border Grid.Column="3" BackgroundColor="#FEE2E2" Padding="12,4" StrokeShape="RoundRectangle 12" StrokeThickness="0" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label Text="{Binding Severity}" TextColor="#B91C1C" FontSize="10" FontAttributes="Bold" />
                                            </Border>
                                            <Border Grid.Column="4" BackgroundColor="#ECFDF5" Stroke="#34D399" StrokeThickness="1" Padding="12,4" StrokeShape="RoundRectangle 12" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label Text="{Binding Status, Converter={StaticResource StringToUpperConverter}}" TextColor="#059669" FontSize="10" FontAttributes="Bold" />
                                            </Border>
                                        </Grid>
                                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Slate50}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
