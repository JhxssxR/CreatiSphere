<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CreatiSphere.Views.SuperAdmin.MsmePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Slate50}">

    <ContentPage.Resources>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="MinimumHeightRequest" Value="120" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1" />
                                <Setter Property="BackgroundColor" Value="White" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1.02" />
                                <Setter Property="BackgroundColor" Value="#F8FAFC" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="280, *">
        <!-- Sidebar -->
        <Grid Grid.Column="0" BackgroundColor="{StaticResource Slate900}" RowDefinitions="Auto, *, Auto">
            <!-- Logo Section -->
            <HorizontalStackLayout Spacing="16" Padding="24, 32" VerticalOptions="Center">
                <Border BackgroundColor="{StaticResource DashboardTeal}" 
                        HeightRequest="40" WidthRequest="40" 
                        StrokeShape="RoundRectangle 8" StrokeThickness="0">
                    <Label Text="◈" TextColor="White" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="CreatiSphere" TextColor="White" FontSize="18" FontAttributes="Bold" />
                    <Label Text="SUPER ADMIN CONSOLE" TextColor="{StaticResource Slate400}" FontSize="9" FontAttributes="Bold" CharacterSpacing="1" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- Navigation Menu -->
            <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="0, 16">
                <!-- Dashboard -->
                <Grid Padding="24, 12" ColumnDefinitions="24, *" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDashboardClicked" />
                    </Grid.GestureRecognizers>
                    <Path Data="M3,13h8V3H3V13z M3,21h8v-6H3V21z M13,21h8V11h-8V21z M13,3v6h8V3H13z" 
                          Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Dashboard" TextColor="{StaticResource Slate400}" FontSize="14" VerticalOptions="Center" Margin="12,0,0,0" />
                </Grid>

                <!-- Manage MSMEs (Active) -->
                <Border StrokeShape="RoundRectangle 0" StrokeThickness="0" BackgroundColor="{StaticResource Slate800}" Padding="24, 12">
                    <Grid ColumnDefinitions="24, *">
                        <Border WidthRequest="4" HeightRequest="24" BackgroundColor="{StaticResource DashboardTeal}" HorizontalOptions="Start" Margin="-24,0,0,0" />
                        <Path Data="M20,4H4v2h16V4z M22,13v2v5c0,1.1-0.9,2-2,2H4c-1.1,0-2-0.9-2-2v-5v-2c0-0.6,0.1-1.2,0.4-1.8l2.3-5.7C5,7.7,5.9,7,7,7h10 c1.1,0,2-0.7,2.3,1.5l2.3,5.7C21.9,11.8,22,12.4,22,13z M19,13H5l-1.6,4h17.2L19,13z" 
                              Fill="White" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Manage MSMEs" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <!-- Other Navigation Items -->
                <VerticalStackLayout Spacing="4">
                    <Grid Padding="24, 12" ColumnDefinitions="24, *" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnManageUsersClicked" />
                        </Grid.GestureRecognizers>
                        <Path Data="M12,12c2.2,0,4-1.8,4-4s-1.8-4-4-4s-4,1.8-4,4S9.8,12,12,12z M12,14c-2.7,0-8,1.3-8,4v2h16v-2C20,15.3,14.7,14,12,14z" 
                              Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Manage Users" TextColor="{StaticResource Slate400}" FontSize="14" VerticalOptions="Center" Margin="12,0,0,0" />
                    </Grid>

                    <Grid Padding="24, 12" ColumnDefinitions="24, *" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnManageModulesClicked" />
                        </Grid.GestureRecognizers>
                        <Path Data="M20,12c0-1.1,0.9-2,2-2V6c0-1.1-0.9-2-2-2h-4c0-1.1-0.9-2-2-2s-2,0.9-2,2H8C6.9,4,6,4.9,6,6v4c-1.1,0-2,0.9-2,2 s0.9,2,2,2v4c0,1.1,0.9,2,2,2h4c0,1.1,0.9,2,2,2s2-0.9,2-2h4c1.1,0,2-0.9,2-2v-4C19.1,14,20,13.1,20,12z" 
                              Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Manage Modules" TextColor="{StaticResource Slate400}" FontSize="14" VerticalOptions="Center" Margin="12,0,0,0" />
                    </Grid>

                    <Grid Padding="24, 12" ColumnDefinitions="24, *" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMonitorSystemClicked" />
                        </Grid.GestureRecognizers>
                        <Path Data="M21,2H3C1.9,2,1,2.9,1,4v12c0,1.1,0.9,2,2,2h7l-2,3v1h8v-1l-2-3h7c1.1,0,2-0.9,2-2V4C23,2.9,22.1,2,21,2z M21,16H3V4h18V16z" 
                              Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Monitor System" TextColor="{StaticResource Slate400}" FontSize="14" VerticalOptions="Center" Margin="12,0,0,0" />
                    </Grid>

                    <Grid Padding="24, 12" ColumnDefinitions="24, *" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSystemReportsClicked" />
                        </Grid.GestureRecognizers>
                        <Path Data="M14,2H6C4.9,2,4,2.9,4,4v16c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V8L14,2z M18,20H6V4h7v5h5V20z" 
                              Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="System Reports" TextColor="{StaticResource Slate400}" FontSize="14" VerticalOptions="Center" Margin="12,0,0,0" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Sign Out -->
            <Grid Grid.Row="2" Padding="24, 48" ColumnDefinitions="24, *" BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSignOutClicked" />
                </Grid.GestureRecognizers>
                <Path Data="M17,7l-1.4,1.4L18.2,11H9v2h9.2l-2.6,2.6L17,17l5-5L17,7z M5,5h7V3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h7v-2H5V5z" 
                      Fill="{StaticResource WarningOrange}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="Sign Out" TextColor="White" FontSize="14" VerticalOptions="Center" Margin="12,0,0,0" />
            </Grid>
        </Grid>

        <!-- Main Content Area -->
        <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="40" Spacing="32">
                
                <!-- Top Nav Bar -->
                <Grid ColumnDefinitions="*, Auto">
                    <!-- Search Bar -->
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 24" Stroke="{StaticResource Slate200}" BackgroundColor="{StaticResource Slate50}" HorizontalOptions="Start" WidthRequest="400" Padding="16, 8">
                        <Grid ColumnDefinitions="Auto, *">
                            <Path Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16 c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5 S11.99,14,9.5,14z" 
                                  Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="Global system search..." PlaceholderColor="{StaticResource Slate400}" TextColor="{StaticResource Slate900}" BackgroundColor="Transparent" Margin="12,0,0,0" FontSize="13" />
                        </Grid>
                    </Border>

                    <!-- User Actions -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="24" VerticalOptions="Center">
                        <Path Data="M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.1-1.6-5.6-4.5-6.3V4c0-0.8-0.7-1.5-1.5-1.5 S10.5,3.2,10.5,4v0.7C7.6,5.4,6,7.9,6,11v5l-2,2v1h16v-1L18,16z" 
                              Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                        <Path Data="M19.1,12.9l2.1,1.6c0.2,0.1,0.2,0.4,0.1,0.6l-2,3.5c-0.1,0.2-0.4,0.3-0.6,0.2l-2.5-1c-0.5,0.4-1.1,0.7-1.7,1 l-0.4,2.6c0,0.2-0.2,0.4-0.5,0.4h-4c-0.3,0-0.5-0.2-0.5-0.4l-0.4-2.6c-0.6-0.3-1.2-0.6-1.7-1l-2.5,1c-0.2,0.1-0.5,0-0.6-0.2l-2-3.5 C1.9,14.9,2,14.6,2.2,14.5l2.1-1.6c-0.1-0.3-0.1-0.6-0.1-0.9s0-0.6,0.1-0.9L2.2,8.6c-0.2-0.1-0.2-0.4-0.1-0.6l2-3.5c0.1-0.2,0.4-0.3,0.6-0.2 l2.5,1c0.5-0.4,1.1-0.7,1.7-1L9.4,1.7c0-0.2,0.2-0.4,0.5-0.4h4c0.3,0,0.5,0.2,0.5,0.4l0.4,2.6c0.6,0.3,1.2,0.6,1.7,1l2.5-1 c0.2-0.1,0.5,0,0.6,0.2l2,3.5c0.1,0.2,0,0.5-0.2,0.6l-2.1,1.6c0.1,0.3,0.1,0.6,0.1,0.9S19.2,12.6,19.1,12.9z M12,15c1.7,0,3-1.3,3-3 s-1.3-3-3-3s-3,1.3-3,3S10.3,15,12,15z" 
                              Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                        
                        <HorizontalStackLayout Spacing="12">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label x:Name="UserNameLabel" Text="Alexander Thorne" TextColor="{StaticResource Slate900}" FontSize="14" FontAttributes="Bold" HorizontalOptions="End" />
                                <Label x:Name="UserRoleLabel" Text="SUPER ADMIN" TextColor="{StaticResource DashboardTeal}" FontSize="10" FontAttributes="Bold" HorizontalOptions="End" CharacterSpacing="0.5" />
                            </VerticalStackLayout>
                            <Grid>
                                <Border HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                                    <Image Source="avatar.png" Aspect="AspectFill" />
                                </Border>
                                <Border BackgroundColor="#22C55E" HeightRequest="10" WidthRequest="10" StrokeShape="RoundRectangle 5" StrokeThickness="2" Stroke="White" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,0,2" />
                            </Grid>
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Page Header -->
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Manage MSME Accounts" TextColor="{StaticResource Slate900}" FontSize="28" FontAttributes="Bold" />
                        <Label Text="Oversee and manage all registered creative businesses on the platform." TextColor="{StaticResource Slate500}" FontSize="14" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="+ Add New MSME" Clicked="OnAddMsmeClicked" BackgroundColor="{StaticResource DashboardTeal}" TextColor="White" Padding="24, 0" HeightRequest="44" CornerRadius="8" FontAttributes="Bold" FontSize="14" VerticalOptions="Center" />
                </Grid>

                <!-- Stats Cards -->
                <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="24">
                    <!-- Total MSMEs -->
                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                        <Border.Shadow><Shadow Brush="Black" Opacity="0.05" Offset="0,4" Radius="10"/></Border.Shadow>
                        <Grid ColumnDefinitions="Auto, *">
                            <Border BackgroundColor="{StaticResource Slate100}" HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                <Path Data="M16,11c1.66,0,2.99-1.34,2.99-3S17.66,5,16,5s-3,1.34-3,3S14.34,11,16,11z M7,11c1.66,0,2.99-1.34,2.99-3S8.66,5,7,5S4,6.34,4,8 S5.34,11,7,11z M7,13c-2.33,0-7,1.17-7,3.5V19h14v-2.5C14,14.17,9.33,13,7,13z M16,13c-0.29,0-0.62,0.02-0.97,0.05 C16.52,14.15,17,15.42,17,17v2h7v-2.5C24,14.17,19.33,13,16,13z" 
                                      Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Margin="16,0,0,0">
                                <Label Text="Total MSMEs" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" HorizontalOptions="End" />
                                <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
                                    <Label x:Name="TotalMsmesLabel" Text="0" TextColor="{StaticResource Slate900}" FontSize="24" FontAttributes="Bold" />
                                    <Label Text="Global" TextColor="{StaticResource SuccessGreenText}" FontSize="12" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Active Now -->
                    <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                        <Border.Shadow><Shadow Brush="Black" Opacity="0.05" Offset="0,4" Radius="10"/></Border.Shadow>
                        <Grid ColumnDefinitions="Auto, *">
                            <Border BackgroundColor="#F0FDFA" HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                <Ellipse Stroke="{StaticResource DashboardTeal}" StrokeThickness="2" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Margin="16,0,0,0">
                                <Label Text="Active Now" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" HorizontalOptions="End" />
                                <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
                                    <Label x:Name="ActiveMsmesLabel" Text="0" TextColor="{StaticResource Slate900}" FontSize="24" FontAttributes="Bold" />
                                    <Label Text="Live" TextColor="{StaticResource DashboardTeal}" FontSize="12" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- On Trial -->
                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                        <Border.Shadow><Shadow Brush="Black" Opacity="0.05" Offset="0,4" Radius="10"/></Border.Shadow>
                        <Grid ColumnDefinitions="Auto, *">
                            <Border BackgroundColor="#FFF7ED" HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                <Path Data="M18,2H6v2h12V2z M17,22H7v-2h10V22z M16,4H8v3l4,4l4-4V4z M8,20v-3l4-4l4,4v3H8z" 
                                      Fill="#D97706" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Margin="16,0,0,0">
                                <Label Text="On Trial" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" HorizontalOptions="End" />
                                <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
                                    <Label x:Name="OnTrialMsmesLabel" Text="0" TextColor="{StaticResource Slate900}" FontSize="24" FontAttributes="Bold" />
                                    <Label Text="Pending Conversion" TextColor="#D97706" FontSize="9" VerticalOptions="Center" MaximumWidthRequest="60" LineBreakMode="WordWrap" HorizontalOptions="End" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- New This Month -->
                    <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                        <Border.Shadow><Shadow Brush="Black" Opacity="0.05" Offset="0,4" Radius="10"/></Border.Shadow>
                        <Grid ColumnDefinitions="Auto, *">
                            <Border BackgroundColor="#EEF2FF" HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                <Path Data="M3.5,18.49l6-6.01l4,4L22,6.92l-1.41-1.41l-7.09,7.09l-4-4L2,16.08L3.5,18.49z" 
                                      Fill="#4F46E5" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Margin="16,0,0,0">
                                <Label Text="New This Month" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" HorizontalOptions="End" />
                                <HorizontalStackLayout HorizontalOptions="End" Spacing="8">
                                    <Label x:Name="GrowthLabel" Text="+0%" TextColor="{StaticResource Slate900}" FontSize="24" FontAttributes="Bold" />
                                    <Label Text="MoM Growth" TextColor="#4F46E5" FontSize="12" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Table Content -->
                <Border Padding="0" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                    <Border.Shadow><Shadow Brush="Black" Opacity="0.05" Offset="0,4" Radius="10"/></Border.Shadow>
                    <VerticalStackLayout>
                        <!-- Table Toolbar -->
                        <Grid Padding="24" ColumnDefinitions="Auto, *, Auto, Auto">
                            <HorizontalStackLayout Spacing="8">
                                <Button x:Name="FilterAllBtn" Text="All" Clicked="OnFilterClicked" BackgroundColor="{StaticResource Slate50}" TextColor="{StaticResource Slate900}" Padding="16, 0" HeightRequest="36" CornerRadius="8" FontSize="13" FontAttributes="Bold" />
                                <Button x:Name="FilterActiveBtn" Text="Active" Clicked="OnFilterClicked" BackgroundColor="Transparent" TextColor="{StaticResource Slate500}" Padding="16, 0" HeightRequest="36" CornerRadius="8" FontSize="13" />
                                <Button x:Name="FilterTrialBtn" Text="Trial" Clicked="OnFilterClicked" BackgroundColor="Transparent" TextColor="{StaticResource Slate500}" Padding="16, 0" HeightRequest="36" CornerRadius="8" FontSize="13" />
                                <Button x:Name="FilterInactiveBtn" Text="Inactive" Clicked="OnFilterClicked" BackgroundColor="Transparent" TextColor="{StaticResource Slate500}" Padding="16, 0" HeightRequest="36" CornerRadius="8" FontSize="13" />
                            </HorizontalStackLayout>

                            <Border Grid.Column="2" StrokeShape="RoundRectangle 8" Stroke="{StaticResource Slate200}" BackgroundColor="White" WidthRequest="300" Padding="12, 0" Margin="0,0,12,0">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Path Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16 c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5 S11.99,14,9.5,14z" 
                                          Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                                    <Entry x:Name="SearchEntry" Grid.Column="1" Placeholder="Search by name or niche..." PlaceholderColor="{StaticResource Slate400}" FontSize="12" BackgroundColor="Transparent" Margin="8,0,0,0" TextChanged="OnSearchTextChanged" />
                                </Grid>
                            </Border>

                            <HorizontalStackLayout Grid.Column="3" Spacing="8">
                                <Border HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 8" Stroke="{StaticResource Slate200}">
                                    <Path Data="M10,18h4v-2h-4V18z M3,6v2h18V6H3z M6,13h12v-2H6V13z" Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="16" WidthRequest="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Border HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 8" Stroke="{StaticResource Slate200}">
                                    <Path Data="M19,9h-4V3H9v6H5l7,7L19,9z M5,18v2h14v-2H5z" Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="16" WidthRequest="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Slate100}" />

                        <!-- Table Headers -->
                        <Grid Padding="24, 16" ColumnDefinitions="25*, 15*, 15*, 15*, 10*, 10*, 5*">
                            <Label Text="BUSINESS NAME" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="CREATIVE NICHE" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="2" Text="OWNER NAME" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="3" Text="ERP TIER" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="4" Text="ACTIVE USERS" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Grid.Column="5" Text="STATUS" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                        </Grid>

                        <!-- Table Rows - populated from code-behind -->
                        <VerticalStackLayout x:Name="MsmesCollectionView" />

                        <!-- Pagination -->
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Slate100}" />
                        <Grid Padding="24" ColumnDefinitions="*, Auto">
                            <Label Text="Showing results from database" TextColor="{StaticResource Slate400}" FontSize="12" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <Border HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 8" Stroke="{StaticResource Slate200}">
                                    <Path Data="M15.41,16.59L10.83,12l4.58-4.59L14,6l-6,6l6,6L15.41,16.59z" Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="12" WidthRequest="12" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Border HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource DashboardTeal}" StrokeThickness="0">
                                    <Label Text="1" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="2" TextColor="{StaticResource Slate600}" FontSize="12" Margin="8,0" VerticalOptions="Center" />
                                <Label Text="3" TextColor="{StaticResource Slate600}" FontSize="12" Margin="8,0" VerticalOptions="Center" />
                                <Label Text="..." TextColor="{StaticResource Slate600}" FontSize="12" Margin="8,0" VerticalOptions="Center" />
                                <Label Text="129" TextColor="{StaticResource Slate600}" FontSize="12" Margin="8,0" VerticalOptions="Center" />
                                <Border HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 8" Stroke="{StaticResource Slate200}">
                                    <Path Data="M8.59,16.59L13.17,12L8.59,7.41L10,6l6,6l-6,6L8.59,16.59z" Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="12" WidthRequest="12" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Bottom Row -->
                <Grid ColumnDefinitions="*, 320" ColumnSpacing="24">
                    <!-- Quarterly MSME Review -->
                    <Border Grid.Column="0" Padding="32" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="{StaticResource Slate900}">
                        <VerticalStackLayout Spacing="24">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Quarterly MSME Review" TextColor="White" FontSize="18" FontAttributes="Bold" />
                                <Label Text="Automated audits have flagged 14 MSMEs for tier upgrades based on recent user growth and transactional volume." TextColor="{StaticResource Slate400}" FontSize="12" />
                            </VerticalStackLayout>
                            <Button Text="Review Batch Upgrades →" BackgroundColor="{StaticResource DashboardTealLight}" TextColor="{StaticResource DashboardTeal}" HeightRequest="44" CornerRadius="8" FontAttributes="Bold" FontSize="14" HorizontalOptions="Start" Padding="24, 0" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- System Integrity -->
                    <Border Grid.Column="1" Padding="24" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="SYSTEM INTEGRITY" TextColor="{StaticResource Slate400}" FontSize="10" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="12">
                                <Ellipse Fill="{StaticResource DashboardTeal}" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                                <Label Text="All Nodes Active" TextColor="{StaticResource Slate900}" FontSize="18" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            <Border BackgroundColor="#F0FDFA" HeightRequest="6" StrokeShape="RoundRectangle 3" StrokeThickness="0">
                                <BoxView BackgroundColor="{StaticResource DashboardTeal}" WidthRequest="220" HeightRequest="6" HorizontalOptions="Start" />
                            </Border>
                            <Label Text="Enterprise synchronization at 99.9% across 1,284 nodes." TextColor="{StaticResource Slate400}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Custom Modal Overlay -->
        <Grid x:Name="MsmeModal" Grid.ColumnSpan="2" IsVisible="False" BackgroundColor="#80000000" Padding="20">
            <Border VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="450" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="32" StrokeThickness="0">
                <Border.Shadow><Shadow Brush="Black" Opacity="0.2" Offset="0,10" Radius="30"/></Border.Shadow>
                
                <VerticalStackLayout Spacing="24">
                    <Label x:Name="ModalTitle" Text="Register New MSME" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Slate900}" />
                    
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Business Name" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Slate500}" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Slate200}" Padding="12, 0">
                                <Entry x:Name="BusinessNameEntry" Placeholder="e.g. EcoWeave Textiles" FontSize="14" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Creative Niche" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Slate500}" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Slate200}" Padding="12, 0">
                                <Entry x:Name="NicheEntry" Placeholder="e.g. Sustainable Fashion" FontSize="14" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Owner Name" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Slate500}" />
                            <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Slate200}" Padding="12, 0">
                                <Entry x:Name="OwnerNameEntry" Placeholder="e.g. Maria Clara" FontSize="14" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="AccountFieldsLayout" Spacing="16">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Email Address (Admin Account)" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Slate500}" />
                                <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Slate200}" Padding="12, 0">
                                    <Entry x:Name="EmailEntry" Placeholder="e.g. contact@business.com" FontSize="14" Keyboard="Email" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Password" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Slate500}" />
                                <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Slate200}" Padding="12, 0">
                                    <Entry x:Name="PasswordEntry" Placeholder="e.g. Password123!" FontSize="14" IsPassword="True" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="ERP Tier" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Slate500}" />
                                <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Slate200}" Padding="12, 0">
                                    <Picker x:Name="TierPicker" FontSize="14">
                                        <Picker.Items>
                                            <x:String>Starter</x:String>
                                            <x:String>Standard</x:String>
                                            <x:String>Enterprise Plus</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Status" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Slate500}" />
                                <Border StrokeShape="RoundRectangle 8" Stroke="{StaticResource Slate200}" Padding="12, 0">
                                    <Picker x:Name="StatusPicker" FontSize="14">
                                        <Picker.Items>
                                            <x:String>ACTIVE</x:String>
                                            <x:String>TRIAL</x:String>
                                            <x:String>INACTIVE</x:String>
                                        </Picker.Items>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="16" Margin="0, 8, 0, 0">
                        <Button Text="Cancel" Clicked="OnCancelModalClicked" BackgroundColor="Transparent" TextColor="{StaticResource Slate600}" HeightRequest="44" CornerRadius="8" />
                        <Button Grid.Column="1" Text="Save Record" Clicked="OnSaveMsmeClicked" BackgroundColor="{StaticResource DashboardTeal}" TextColor="White" FontAttributes="Bold" HeightRequest="44" CornerRadius="8" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Confirmation Modal Overlay -->
        <Grid x:Name="ConfirmationModal" Grid.ColumnSpan="2" IsVisible="False" BackgroundColor="#80000000" Padding="20">
            <Border VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="400" BackgroundColor="White" StrokeShape="RoundRectangle 16" Padding="32" StrokeThickness="0">
                <Border.Shadow><Shadow Brush="Black" Opacity="0.2" Offset="0,10" Radius="30"/></Border.Shadow>
                
                <VerticalStackLayout Spacing="24" HorizontalOptions="Center">
                    <Border x:Name="IconContainer" BackgroundColor="#FEF2F2" HeightRequest="64" WidthRequest="64" StrokeShape="RoundRectangle 32" HorizontalOptions="Center">
                        <Path x:Name="ConfirmationIcon" Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M13,17h-2v-2h2V17z M13,13h-2V7h2V13z" 
                              Fill="#EF4444" Aspect="Uniform" HeightRequest="32" WidthRequest="32" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label x:Name="ConfirmationTitle" Text="Confirm Action" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Slate900}" HorizontalOptions="Center" />
                        <Label x:Name="ConfirmationMessage" Text="Are you sure you want to proceed?" FontSize="14" TextColor="{StaticResource Slate500}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="16" WidthRequest="340">
                        <Button Text="Cancel" Clicked="OnCancelConfirmationClicked" BackgroundColor="Transparent" TextColor="{StaticResource Slate600}" HeightRequest="44" CornerRadius="8" />
                        <Button x:Name="ConfirmActionButton" Grid.Column="1" Text="Confirm" Clicked="OnConfirmActionClicked" BackgroundColor="#EF4444" TextColor="White" FontAttributes="Bold" HeightRequest="44" CornerRadius="8" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
