<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CreatiSphere.Views.SuperAdmin.DashboardPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Slate50}">

    <ContentPage.Resources>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1" />
                                <Setter Property="BackgroundColor" Value="White" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1.03" />
                                <Setter Property="BackgroundColor" Value="#F8FAFC" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="280, *">
        <!-- Sidebar -->
        <Grid Grid.Column="0" BackgroundColor="{StaticResource Slate900}" RowDefinitions="Auto, *, Auto">
            <!-- Logo Section -->
            <HorizontalStackLayout Spacing="16" Padding="24, 32" VerticalOptions="Center">
                <Border BackgroundColor="{StaticResource DashboardTeal}" 
                        HeightRequest="40" WidthRequest="40" 
                        StrokeShape="RoundRectangle 8" StrokeThickness="0">
                    <Label Text="◈" TextColor="White" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="CreatiSphere" TextColor="White" FontSize="18" FontAttributes="Bold" />
                    <Label Text="SUPER ADMIN CONSOLE" TextColor="{StaticResource Slate400}" FontSize="9" FontAttributes="Bold" CharacterSpacing="1" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- Navigation Menu -->
            <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="0, 16">
                <!-- Dashboard -->
                <Border StrokeShape="RoundRectangle 0" StrokeThickness="0" BackgroundColor="{StaticResource Slate800}" Padding="24, 12">
                    <Grid ColumnDefinitions="24, *">
                        <Border WidthRequest="4" HeightRequest="24" BackgroundColor="{StaticResource DashboardTeal}" HorizontalOptions="Start" Margin="-24,0,0,0" />
                        <Path Data="M3,13h8V3H3V13z M3,21h8v-6H3V21z M13,21h8V11h-8V21z M13,3v6h8V3H13z" 
                              Fill="White" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Dashboard" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <!-- Navigation Items -->
                <VerticalStackLayout Spacing="4">
                    <Grid Padding="24, 12" ColumnDefinitions="24, *" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMsmeDirectoryClicked" />
                        </Grid.GestureRecognizers>
                        <Path Data="M20,4H4v2h16V4z M22,13v2v5c0,1.1-0.9,2-2,2H4c-1.1,0-2-0.9-2-2v-5v-2c0-0.6,0.1-1.2,0.4-1.8l2.3-5.7C5,7.7,5.9,7,7,7h10 c1.1,0,2-0.7,2.3,1.5l2.3,5.7C21.9,11.8,22,12.4,22,13z M19,13H5l-1.6,4h17.2L19,13z" 
                              Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Manage MSMEs" TextColor="{StaticResource Slate400}" FontSize="14" VerticalOptions="Center" Margin="12,0,0,0" />
                    </Grid>

                    <Grid Padding="24, 12" ColumnDefinitions="24, *" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnManageUsersClicked" />
                        </Grid.GestureRecognizers>
                        <Path Data="M12,12c2.2,0,4-1.8,4-4s-1.8-4-4-4s-4,1.8-4,4S9.8,12,12,12z M12,14c-2.7,0-8,1.3-8,4v2h16v-2C20,15.3,14.7,14,12,14z" 
                              Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Manage Users" TextColor="{StaticResource Slate400}" FontSize="14" VerticalOptions="Center" Margin="12,0,0,0" />
                    </Grid>

                    <Grid Padding="24, 12" ColumnDefinitions="24, *" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnManageModulesClicked" />
                        </Grid.GestureRecognizers>
                        <Path Data="M20,12c0-1.1,0.9-2,2-2V6c0-1.1-0.9-2-2-2h-4c0-1.1-0.9-2-2-2s-2,0.9-2,2H8C6.9,4,6,4.9,6,6v4c-1.1,0-2,0.9-2,2 s0.9,2,2,2v4c0,1.1,0.9,2,2,2h4c0,1.1,0.9,2,2,2s2-0.9,2-2h4c1.1,0,2-0.9,2-2v-4C19.1,14,20,13.1,20,12z" 
                              Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Manage Modules" TextColor="{StaticResource Slate400}" FontSize="14" VerticalOptions="Center" Margin="12,0,0,0" />
                    </Grid>

                    <Grid Padding="24, 12" ColumnDefinitions="24, *" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMonitorSystemClicked" />
                        </Grid.GestureRecognizers>
                        <Path Data="M21,2H3C1.9,2,1,2.9,1,4v12c0,1.1,0.9,2,2,2h7l-2,3v1h8v-1l-2-3h7c1.1,0,2-0.9,2-2V4C23,2.9,22.1,2,21,2z M21,16H3V4h18V16z" 
                              Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Monitor System" TextColor="{StaticResource Slate400}" FontSize="14" VerticalOptions="Center" Margin="12,0,0,0" />
                    </Grid>

                    <Grid Padding="24, 12" ColumnDefinitions="24, *" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSystemReportsClicked" />
                        </Grid.GestureRecognizers>
                        <Path Data="M14,2H6C4.9,2,4,2.9,4,4v16c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V8L14,2z M18,20H6V4h7v5h5V20z" 
                              Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="System Reports" TextColor="{StaticResource Slate400}" FontSize="14" VerticalOptions="Center" Margin="12,0,0,0" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Sign Out -->
            <Grid Grid.Row="2" Padding="24, 48" ColumnDefinitions="24, *" BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSignOutClicked" />
                </Grid.GestureRecognizers>
                <Path Data="M17,7l-1.4,1.4L18.2,11H9v2h9.2l-2.6,2.6L17,17l5-5L17,7z M5,5h7V3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h7v-2H5V5z" 
                      Fill="{StaticResource WarningOrange}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="Sign Out" TextColor="White" FontSize="14" VerticalOptions="Center" Margin="12,0,0,0" />
            </Grid>
        </Grid>

        <!-- Main Content Area -->
        <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="40" Spacing="32">
                
                <!-- Top Nav Bar -->
                <Grid ColumnDefinitions="*, Auto">
                    <!-- Search Bar -->
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 24" Stroke="{StaticResource Slate200}" BackgroundColor="{StaticResource Slate50}" HorizontalOptions="Start" WidthRequest="400" Padding="16, 8">
                        <Grid ColumnDefinitions="Auto, *">
                            <Path Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16 c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5 S11.99,14,9.5,14z" 
                                  Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="Global system search..." PlaceholderColor="{StaticResource Slate400}" TextColor="{StaticResource Slate900}" BackgroundColor="Transparent" Margin="12,0,0,0" FontSize="13" />
                        </Grid>
                    </Border>

                    <!-- User Actions -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="24" VerticalOptions="Center">
                        <Path Data="M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.1-1.6-5.6-4.5-6.3V4c0-0.8-0.7-1.5-1.5-1.5 S10.5,3.2,10.5,4v0.7C7.6,5.4,6,7.9,6,11v5l-2,2v1h16v-1L18,16z" 
                              Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                        <Path Data="M19.1,12.9l2.1,1.6c0.2,0.1,0.2,0.4,0.1,0.6l-2,3.5c-0.1,0.2-0.4,0.3-0.6,0.2l-2.5-1c-0.5,0.4-1.1,0.7-1.7,1 l-0.4,2.6c0,0.2-0.2,0.4-0.5,0.4h-4c-0.3,0-0.5-0.2-0.5-0.4l-0.4-2.6c-0.6-0.3-1.2-0.6-1.7-1l-2.5,1c-0.2,0.1-0.5,0-0.6-0.2l-2-3.5 C1.9,14.9,2,14.6,2.2,14.5l2.1-1.6c-0.1-0.3-0.1-0.6-0.1-0.9s0-0.6,0.1-0.9L2.2,8.6c-0.2-0.1-0.2-0.4-0.1-0.6l2-3.5c0.1-0.2,0.4-0.3,0.6-0.2 l2.5,1c0.5-0.4,1.1-0.7,1.7-1L9.4,1.7c0-0.2,0.2-0.4,0.5-0.4h4c0.3,0,0.5,0.2,0.5,0.4l0.4,2.6c0.6,0.3,1.2,0.6,1.7,1l2.5-1 c0.2-0.1,0.5,0,0.6,0.2l2,3.5c0.1,0.2,0,0.5-0.2,0.6l-2.1,1.6c0.1,0.3,0.1,0.6,0.1,0.9S19.2,12.6,19.1,12.9z M12,15c1.7,0,3-1.3,3-3 s-1.3-3-3-3s-3,1.3-3,3S10.3,15,12,15z" 
                              Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                        
                        <HorizontalStackLayout Spacing="12">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label x:Name="UserNameLabel" Text="Alexander Thorne" TextColor="{StaticResource Slate900}" FontSize="14" FontAttributes="Bold" HorizontalOptions="End" />
                                <Label x:Name="UserRoleLabel" Text="SUPER ADMIN" TextColor="{StaticResource DashboardTeal}" FontSize="10" FontAttributes="Bold" HorizontalOptions="End" CharacterSpacing="0.5" />
                            </VerticalStackLayout>
                            <Grid>
                                <Border HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                                    <Image Source="avatar.png" Aspect="AspectFill" />
                                </Border>
                                <Border BackgroundColor="#22C55E" HeightRequest="10" WidthRequest="10" StrokeShape="RoundRectangle 5" StrokeThickness="2" Stroke="White" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,0,2" />
                            </Grid>
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Page Header -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Super Admin Dashboard" TextColor="{StaticResource Slate900}" FontSize="28" FontAttributes="Bold" />
                    <Label Text="Welcome back, Admin. Here's a high-level overview of the CreatiSphere ecosystem status today." TextColor="{StaticResource Slate500}" FontSize="14" />
                </VerticalStackLayout>

                <!-- Stats Cards -->
                <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="24">
                    <!-- Total MSMEs -->
                    <Border x:Name="CardMsmes" Grid.Column="0" Style="{StaticResource StatCardStyle}">
                        <Border.Shadow><Shadow Brush="Black" Opacity="0.08" Offset="0,6" Radius="12"/></Border.Shadow>
                        <Border.GestureRecognizers>
                            <PointerGestureRecognizer PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="20">
                            <Grid ColumnDefinitions="Auto, *">
                                <Border BackgroundColor="#E0F2F1" HeightRequest="44" WidthRequest="44" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                                    <Path Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z" 
                                          Fill="{StaticResource DashboardTeal}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Start" Spacing="4">
                                    <Path Data="M7,14l5-5l5,5" Fill="{StaticResource SuccessGreen}" Aspect="Uniform" HeightRequest="10" WidthRequest="10" VerticalOptions="Center" />
                                    <Label Text="+13" TextColor="{StaticResource SuccessGreen}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="TOTAL MSMES" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                                <Label x:Name="TotalMsmesLabel" Text="0" TextColor="{StaticResource Slate900}" FontSize="32" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Total Users -->
                    <Border x:Name="CardUsers" Grid.Column="1" Style="{StaticResource StatCardStyle}">
                        <Border.Shadow><Shadow Brush="Black" Opacity="0.08" Offset="0,6" Radius="12"/></Border.Shadow>
                        <Border.GestureRecognizers>
                            <PointerGestureRecognizer PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="20">
                            <Grid ColumnDefinitions="Auto, *">
                                <Border BackgroundColor="#EEF2FF" HeightRequest="44" WidthRequest="44" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                                    <Path Data="M12,12c2.21,0,4-1.79,4-4s-1.79-4-4-4s-4,1.79-4,4S9.79,12,12,12z M12,14c-2.67,0-8,1.34-8,4v2h16v-2 C20,15.34,14.67,14,12,14z" 
                                          Fill="#4F46E5" Aspect="Uniform" HeightRequest="18" WidthRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Start" Spacing="4">
                                    <Path Data="M7,14l5-5l5,5" Fill="{StaticResource SuccessGreen}" Aspect="Uniform" HeightRequest="10" WidthRequest="10" VerticalOptions="Center" />
                                    <Label Text="+89" TextColor="{StaticResource SuccessGreen}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="TOTAL USERS" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                                <Label x:Name="TotalUsersLabel" Text="0" TextColor="{StaticResource Slate900}" FontSize="32" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- System Uptime -->
                    <Border x:Name="CardUptime" Grid.Column="2" Style="{StaticResource StatCardStyle}">
                        <Border.Shadow><Shadow Brush="Black" Opacity="0.08" Offset="0,6" Radius="12"/></Border.Shadow>
                        <Border.GestureRecognizers>
                            <PointerGestureRecognizer PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="20">
                            <Grid ColumnDefinitions="Auto, *">
                                <Border BackgroundColor="#F0FDFA" HeightRequest="44" WidthRequest="44" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                                    <Path Data="M12,21.35l-1.45-1.32C5.4,15.36,2,12.28,2,8.5C2,5.42,4.42,3,7.5,3c1.74,0,3.41,0.81,4.5,2.09C13.09,3.81,14.76,3,16.5,3 C19.58,3,22,5.42,22,8.5c0,3.78-3.4,6.86-8.55,11.54L12,21.35z" 
                                          Fill="{StaticResource DashboardTeal}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1" Text="LAST 30 DAYS" TextColor="{StaticResource Slate400}" FontSize="9" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Start" />
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="SYSTEM UPTIME" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                                <Label x:Name="UptimeLabel" Text="99.9%" TextColor="{StaticResource Slate900}" FontSize="32" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Active Modules -->
                    <Border x:Name="CardModules" Grid.Column="3" Style="{StaticResource StatCardStyle}">
                        <Border.Shadow><Shadow Brush="Black" Opacity="0.08" Offset="0,6" Radius="12"/></Border.Shadow>
                        <Border.GestureRecognizers>
                            <PointerGestureRecognizer PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="20">
                            <Grid ColumnDefinitions="Auto, *">
                                <Border BackgroundColor="{StaticResource Slate100}" HeightRequest="44" WidthRequest="44" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                                    <Path Data="M3,3h7v7H3V3z M14,3h7v7h-7V3z M3,14h7v7H3V14z M14,14h7v7h-7V14z" 
                                          Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1" Text="UNIVERSAL" TextColor="{StaticResource Slate400}" FontSize="9" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Start" />
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="ACTIVE MODULES" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                                <Label x:Name="ActiveModulesLabel" Text="12" TextColor="{StaticResource Slate900}" FontSize="32" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Charts Section -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="24">
                    <!-- MSME Growth Trend (Bar Chart) -->
                    <Border Grid.Column="0" Padding="24" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                        <Border.Shadow><Shadow Brush="Black" Opacity="0.05" Offset="0,4" Radius="10"/></Border.Shadow>
                        <VerticalStackLayout Spacing="24">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="MSME Growth Trend" TextColor="{StaticResource Slate900}" FontSize="18" FontAttributes="Bold" />
                                <Border Grid.Column="1" StrokeShape="RoundRectangle 8" Stroke="{StaticResource Slate200}" Padding="12, 4">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="Last 6 Months" FontSize="12" TextColor="{StaticResource Slate600}" VerticalOptions="Center" />
                                        <Path Data="M7,10l5,5l5-5" Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="8" WidthRequest="8" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Chart Mockup -->
                            <FlexLayout x:Name="GrowthChartLayout" JustifyContent="SpaceBetween" AlignItems="End" HeightRequest="200" VerticalOptions="End" Margin="0,0,0,12">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="8" VerticalOptions="End">
                                            <Grid RowDefinitions="Auto, Auto" VerticalOptions="End">
                                                <BoxView Grid.Row="0" Color="{StaticResource ChartBarTealLight}" CornerRadius="4,4,0,0" HeightRequest="{Binding NewRegistrations}" WidthRequest="32" />
                                                <BoxView Grid.Row="1" Color="{StaticResource ChartBarTeal}" CornerRadius="0,0,4,4" HeightRequest="{Binding ActiveMsmes}" WidthRequest="32" />
                                            </Grid>
                                            <Label Text="{Binding Month}" HorizontalOptions="Center" FontSize="11" TextColor="{StaticResource Slate400}" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                            <!-- Legend -->
                            <HorizontalStackLayout Spacing="24">
                                <HorizontalStackLayout Spacing="8">
                                    <BoxView Color="{StaticResource ChartBarTeal}" CornerRadius="4" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" />
                                    <Label Text="Active MSMEs" FontSize="12" TextColor="{StaticResource Slate600}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <BoxView Color="{StaticResource ChartBarTealLight}" CornerRadius="4" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" />
                                    <Label Text="New Registrations" FontSize="12" TextColor="{StaticResource Slate600}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- System Activity (Line Chart) -->
                    <Border Grid.Column="1" Padding="24" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                        <Border.Shadow><Shadow Brush="Black" Opacity="0.05" Offset="0,4" Radius="10"/></Border.Shadow>
                        <VerticalStackLayout Spacing="24">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="System Activity (API Requests)" TextColor="{StaticResource Slate900}" FontSize="18" FontAttributes="Bold" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <BoxView Color="#22C55E" CornerRadius="4" HeightRequest="8" WidthRequest="8" VerticalOptions="Center" />
                                    <Label Text="Real-time" FontSize="11" TextColor="#15803D" VerticalOptions="Center" BackgroundColor="#DCFCE7" Padding="8,2" />
                                </HorizontalStackLayout>
                            </Grid>

                            <!-- Line Chart Mockup -->
                            <Grid HeightRequest="200" VerticalOptions="End">
                                <Path x:Name="ActivityLinePath" Data="M0,150 C50,150 100,160 150,140 C200,120 250,180 300,150 C350,120 400,60 450,100 C500,140 550,60 600,100" 
                                      Stroke="{StaticResource DashboardTeal}" StrokeThickness="3" Aspect="Fill" />
                                <Path x:Name="ActivityFillPath" Data="M0,150 C50,150 100,160 150,140 C200,120 250,180 300,150 C350,120 400,60 450,100 C500,140 550,60 600,100 L600,200 L0,200 Z" 
                                      Fill="#100D9488" Aspect="Fill" Opacity="0.1" />
                                
                                <!-- Dots -->
                                <Ellipse Fill="White" Stroke="{StaticResource DashboardTeal}" StrokeThickness="2" WidthRequest="8" HeightRequest="8" Margin="145,136,0,0" HorizontalOptions="Start" VerticalOptions="Start" />
                                <Ellipse Fill="White" Stroke="{StaticResource DashboardTeal}" StrokeThickness="2" WidthRequest="8" HeightRequest="8" Margin="295,146,0,0" HorizontalOptions="Start" VerticalOptions="Start" />
                                <Ellipse Fill="White" Stroke="{StaticResource DashboardTeal}" StrokeThickness="2" WidthRequest="8" HeightRequest="8" Margin="445,96,0,0" HorizontalOptions="Start" VerticalOptions="Start" />
                            </Grid>

                            <!-- Time Labels -->
                            <Grid ColumnDefinitions="*, *, *, *, *, *, *" HorizontalOptions="Fill">
                                <Label Grid.Column="0" Text="00:00" FontSize="11" TextColor="{StaticResource Slate400}" HorizontalOptions="Center" />
                                <Label Grid.Column="1" Text="04:00" FontSize="11" TextColor="{StaticResource Slate400}" HorizontalOptions="Center" />
                                <Label Grid.Column="2" Text="08:00" FontSize="11" TextColor="{StaticResource Slate400}" HorizontalOptions="Center" />
                                <Label Grid.Column="3" Text="12:00" FontSize="11" TextColor="{StaticResource Slate400}" HorizontalOptions="Center" />
                                <Label Grid.Column="4" Text="16:00" FontSize="11" TextColor="{StaticResource Slate400}" HorizontalOptions="Center" />
                                <Label Grid.Column="5" Text="20:00" FontSize="11" TextColor="{StaticResource Slate400}" HorizontalOptions="Center" />
                                <Label Grid.Column="6" Text="24:00" FontSize="11" TextColor="{StaticResource Slate400}" HorizontalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Bottom Row -->
                <Grid ColumnDefinitions="*, 320" ColumnSpacing="24">
                    <!-- Recent MSME Registrations Table -->
                    <Border Grid.Column="0" Padding="24" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                        <Border.Shadow><Shadow Brush="Black" Opacity="0.05" Offset="0,4" Radius="10"/></Border.Shadow>
                        <VerticalStackLayout Spacing="24">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Recent MSME Registrations" TextColor="{StaticResource Slate900}" FontSize="18" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="View All" TextColor="{StaticResource DashboardTeal}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>

                            <CollectionView x:Name="RecentMsmesCollectionView" SelectionMode="None">
                                <CollectionView.Header>
                                    <Grid ColumnDefinitions="2*, 1.5*, 1.5*, Auto" Padding="0,0,0,16">
                                        <Label Text="BUSINESS NAME" TextColor="{StaticResource Slate400}" FontSize="10" FontAttributes="Bold" />
                                        <Label Grid.Column="1" Text="INDUSTRY" TextColor="{StaticResource Slate400}" FontSize="10" FontAttributes="Bold" />
                                        <Label Grid.Column="2" Text="REGION" TextColor="{StaticResource Slate400}" FontSize="10" FontAttributes="Bold" />
                                        <Label Grid.Column="3" Text="STATUS" TextColor="{StaticResource Slate400}" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" />
                                    </Grid>
                                </CollectionView.Header>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="2*, 1.5*, 1.5*, Auto" Padding="0,8">
                                            <Label Text="{Binding BusinessName}" TextColor="{StaticResource Slate900}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Niche}" TextColor="{StaticResource Slate600}" FontSize="14" VerticalOptions="Center" />
                                            <Label Grid.Column="2" Text="Cebu, PH" TextColor="{StaticResource Slate600}" FontSize="14" VerticalOptions="Center" />
                                            <Border Grid.Column="3" BackgroundColor="{StaticResource SuccessGreenBg}" Padding="8,4" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                                                <Label Text="{Binding Status}" TextColor="{StaticResource SuccessGreenText}" FontSize="10" FontAttributes="Bold" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- System Health Summary Card -->
                    <Border Grid.Column="1" Padding="24" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="{StaticResource Slate900}">
                        <Border.Shadow><Shadow Brush="Black" Opacity="0.3" Offset="0,6" Radius="16"/></Border.Shadow>
                        <VerticalStackLayout Spacing="24">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="System Health Summary" TextColor="White" FontSize="18" FontAttributes="Bold" />
                                <Label Text="All core modules are performing within optimal latency thresholds." TextColor="{StaticResource Slate400}" FontSize="12" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="24">
                                <!-- DB Node -->
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="Database Node 1" TextColor="White" FontSize="13" />
                                        <Label x:Name="DbNodeStatusLabel" Grid.Column="1" Text="STABLE" TextColor="{StaticResource SuccessGreen}" FontSize="13" FontAttributes="Bold" />
                                    </Grid>
                                    <Border BackgroundColor="#0F172A" HeightRequest="6" StrokeShape="RoundRectangle 3" StrokeThickness="0">
                                        <BoxView x:Name="DbNodeHealthBar" Color="{StaticResource DashboardTeal}" WidthRequest="220" HorizontalOptions="Start" />
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Storage Capacity -->
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="Storage Capacity" TextColor="White" FontSize="13" />
                                        <Label x:Name="StorageUsageLabel" Grid.Column="1" Text="42% USED" TextColor="{StaticResource Slate300}" FontSize="13" FontAttributes="Bold" />
                                    </Grid>
                                    <Border BackgroundColor="#0F172A" HeightRequest="6" StrokeShape="RoundRectangle 3" StrokeThickness="0">
                                        <BoxView x:Name="StorageCapacityBar" Color="#2DD4BF" WidthRequest="100" HorizontalOptions="Start" />
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <Button Text="Run System Diagnostic" 
                                    Clicked="OnRunDiagnosticClicked"
                                    BackgroundColor="{StaticResource DashboardTeal}" 
                                    TextColor="White" 
                                    HeightRequest="48" 
                                    CornerRadius="10" 
                                    FontAttributes="Bold" 
                                    FontSize="14"
                                    Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
