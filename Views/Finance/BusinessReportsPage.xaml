<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CreatiSphere.Views.Finance.BusinessReportsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid ColumnDefinitions="260, *">

        <!-- ===== FINANCE SIDEBAR ===== -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" BackgroundColor="#1E293B">
            
            <!-- Brand Logo -->
            <VerticalStackLayout Grid.Row="0" Padding="24,32" Spacing="4">
                <HorizontalStackLayout Spacing="12">
                    <Border BackgroundColor="#0D9488" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 8">
                        <Label Text="◈" TextColor="White" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="CreatiSphere" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="FINANCE STAFF PORTAL" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" Margin="44,0,0,0" />
            </VerticalStackLayout>

            <!-- Nav Items -->
            <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="12,0">
                
                <!-- Financial Dashboards -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDashboardClicked"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M3,13h8V3H3V13z M3,21h8v-6H3V21z M13,21h8V11h-8V21z M13,3v6h8V3H13z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Financial Dashboards" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Monitor Revenue -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMonitorRevenueClicked"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M7,2v11h3v9l7-12h-4l4-8H7z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Monitor Revenue" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Business Reports (Active) -->
                <Border BackgroundColor="#0D9488" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M19,19H5V5h14V19z" Fill="White" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Business Reports" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>

            <!-- Profile Bottom -->
            <VerticalStackLayout Grid.Row="2" Padding="24" Spacing="24">
                <BoxView HeightRequest="1" Color="#334155" />
                <Grid ColumnDefinitions="Auto, *">
                    <Border HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                        <Image Source="staff_avatar.png" Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="12,0">
                        <Label Text="Alex Thorne" TextColor="White" FontSize="14" FontAttributes="Bold" />
                        <Label Text="Senior Controller" TextColor="#94A3B8" FontSize="11" />
                    </VerticalStackLayout>
                </Grid>
                <HorizontalStackLayout Spacing="12" Padding="4">
                    <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnSignOutClicked"/></HorizontalStackLayout.GestureRecognizers>
                    <Path Data="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z" Fill="#F87171" Aspect="Uniform" HeightRequest="18" WidthRequest="18" />
                    <Label Text="Sign Out" TextColor="#F87171" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <!-- ===== MAIN CONTENT ===== -->
        <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="40" Spacing="32">
                
                <!-- Top Bar -->
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Business Reports" TextColor="#0F172A" FontSize="28" FontAttributes="Bold" />
                        <Label Text="Generate comprehensive financial breakdowns and manage your creative business insights." TextColor="#64748B" FontSize="14" />
                    </VerticalStackLayout>
                    
                    <HorizontalStackLayout Grid.Column="1" Spacing="16">
                        <Border BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" Padding="12,0" HeightRequest="40" WidthRequest="350">
                            <Grid ColumnDefinitions="20, *">
                                <Path Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16 c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5 S11.99,14,9.5,14z" Fill="#64748B" Aspect="Uniform" VerticalOptions="Center" />
                                <Entry Grid.Column="1" Placeholder="Search reports or transactions..." PlaceholderColor="#64748B" TextColor="#0F172A" FontSize="13" Margin="8,0,0,0" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Border BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" HeightRequest="40" WidthRequest="40">
                            <Path Data="M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-0.83-0.67-1.5-1.5-1.5 s-1.5,0.67-1.5,1.5v0.68C7.64,5.36,6,7.92,6,11v5l-2,2v1h16v-1L18,16z" Fill="#64748B" Aspect="Uniform" HeightRequest="18" WidthRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" HeightRequest="40" WidthRequest="40">
                            <Path Data="M20,2H4C2.9,2,2,2.9,2,4v16c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z M20,20H4V4h16V20z M18,12H6v-2h12V12z" Fill="#64748B" Aspect="Uniform" HeightRequest="18" WidthRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                            <Image Source="staff_avatar.png" Aspect="AspectFill" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <Grid ColumnDefinitions="*, 350" ColumnSpacing="24">
                    <!-- Left Section: Main Cards and Table -->
                    <VerticalStackLayout Grid.Column="0" Spacing="32">
                        
                        <!-- Primary Report Card -->
                        <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="32">
                            <VerticalStackLayout Spacing="24">
                                <HorizontalStackLayout Spacing="20">
                                    <Border BackgroundColor="#0D9488" HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 12">
                                        <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M19,19H5V5h14V19z M9,17H7v-7h2V17z M13,17h-2V7h2V17z M17,17h-2v-4h2V17z" Fill="White" Aspect="Uniform" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="Monthly Revenue Performance" TextColor="#0F172A" FontSize="20" FontAttributes="Bold" />
                                        <Label Text="Detailed analysis of sales, licensing fees, and custom commissions." TextColor="#64748B" FontSize="13" />
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>

                                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="16">
                                    <Border Grid.Column="0" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 12" Padding="20">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="GROWTH" TextColor="#64748B" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" />
                                            <Label Text="+12.4%" TextColor="#0D9488" FontSize="18" FontAttributes="Bold" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="1" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 12" Padding="20">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="AVG SALE" TextColor="#64748B" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" />
                                            <Label Text="$142.50" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Column="2" BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 12" Padding="20">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="TOP REGION" TextColor="#64748B" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" />
                                            <Label Text="EU West" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <HorizontalStackLayout Spacing="16">
                                    <Button Text="Generate Full Report" BackgroundColor="#0D9488" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="44" Padding="24,0">
                                        <Button.ImageSource>
                                            <FontImageSource Glyph="✨" Size="14" Color="White" />
                                        </Button.ImageSource>
                                    </Button>
                                    <Button Text="Preview Data" BackgroundColor="White" TextColor="#0F172A" BorderColor="#E2E8F0" BorderWidth="1" FontAttributes="Bold" CornerRadius="8" HeightRequest="44" Padding="24,0" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                            <!-- Payout Summaries -->
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="24">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Border Grid.Column="0" BackgroundColor="#DBEAFE" HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 8">
                                        <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M19,19H5V5h14V19z" Fill="#3B82F6" Aspect="Uniform" HeightRequest="18" WidthRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="16,0">
                                        <Label Text="Payout Summaries" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                                        <Label Text="History of all transfers to your bank." TextColor="#64748B" FontSize="11" />
                                    </VerticalStackLayout>
                                    <Path Grid.Column="2" Data="M19,9h-4V3H9v6H5l7,7L19,9z M5,18v2h14v-2H5z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            <!-- Tax Reports -->
                            <Border Grid.Column="1" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="24">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <Border Grid.Column="0" BackgroundColor="#F1F5F9" HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 8">
                                        <Path Data="M14,2H6C4.9,2,4,2.9,4,4v16c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V8L14,2z M13,9V3.5L18.5,9H13z" Fill="#64748B" Aspect="Uniform" HeightRequest="18" WidthRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="16,0">
                                        <Label Text="Tax Reports" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                                        <Label Text="1099-K forms and annual summaries." TextColor="#64748B" FontSize="11" />
                                    </VerticalStackLayout>
                                    <Path Grid.Column="2" Data="M19,12h-2v3h-3v2h5V12z M7,17h5v-2H9v-3H7V17z M20,2H4C2.9,2,2,2.9,2,4v16c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V4C22,2.9,21.1,2,20,2z M20,20H4V4h16V20z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Recently Generated Table -->
                        <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="0">
                            <VerticalStackLayout>
                                <Grid ColumnDefinitions="*, Auto" Padding="24,16">
                                    <Label Text="Recently Generated" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="View Archive" TextColor="#0D9488" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                                <BoxView HeightRequest="1" Color="#F1F5F9" />

                                <!-- Table Header -->
                                <Grid ColumnDefinitions="2*, *, *, Auto" Padding="24,12" BackgroundColor="#F8FAFC">
                                    <Label Text="REPORT NAME" TextColor="#64748B" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" />
                                    <Label Grid.Column="1" Text="GENERATED ON" TextColor="#64748B" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" />
                                    <Label Grid.Column="2" Text="FORMAT" TextColor="#64748B" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" />
                                    <Label Grid.Column="3" Text="ACTIONS" TextColor="#64748B" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" WidthRequest="60" HorizontalOptions="Center" />
                                </Grid>

                                <!-- Row 1 -->
                                <Grid ColumnDefinitions="2*, *, *, Auto" Padding="24,16">
                                    <HorizontalStackLayout Spacing="12">
                                        <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M19,19H5V5h14V19z M9,17H7v-7h2V17z M13,17h-2V7h2V17z M17,17h-2v-4h2V17z" Fill="#64748B" Aspect="Uniform" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                                        <Label Text="Q3_2026_Licensing_Summary" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="Oct 12, 2026" TextColor="#0F172A" FontSize="13" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 4" Padding="6,2" HorizontalOptions="Start">
                                        <Label Text="PDF" TextColor="#64748B" FontSize="9" FontAttributes="Bold" />
                                    </Border>
                                    <Label Grid.Column="3" Text="•••" TextColor="#94A3B8" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                                <BoxView HeightRequest="1" Color="#F1F5F9" Margin="24,0" />

                                <!-- Row 2 -->
                                <Grid ColumnDefinitions="2*, *, *, Auto" Padding="24,16">
                                    <HorizontalStackLayout Spacing="12">
                                        <Path Data="M14,2H6C4.9,2,4,2.9,4,4v16c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V8L14,2z M13,9V3.5L18.5,9H13z" Fill="#64748B" Aspect="Uniform" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                                        <Label Text="September_Payout_Log" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="Oct 01, 2026" TextColor="#0F172A" FontSize="13" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 4" Padding="6,2" HorizontalOptions="Start">
                                        <Label Text="CSV" TextColor="#64748B" FontSize="9" FontAttributes="Bold" />
                                    </Border>
                                    <Label Grid.Column="3" Text="•••" TextColor="#94A3B8" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                                <BoxView HeightRequest="1" Color="#F1F5F9" Margin="24,0" />

                                <!-- Row 3 -->
                                <Grid ColumnDefinitions="2*, *, *, Auto" Padding="24,16">
                                    <HorizontalStackLayout Spacing="12">
                                        <Path Data="M14,2H6C4.9,2,4,2.9,4,4v16c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V8L14,2z M13,9V3.5L18.5,9H13z" Fill="#64748B" Aspect="Uniform" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                                        <Label Text="Custom_Commissions_August" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="Sep 15, 2026" TextColor="#0F172A" FontSize="13" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="2" BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 4" Padding="6,2" HorizontalOptions="Start">
                                        <Label Text="PDF" TextColor="#64748B" FontSize="9" FontAttributes="Bold" />
                                    </Border>
                                    <Label Grid.Column="3" Text="•••" TextColor="#94A3B8" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Right Sidebar Section -->
                    <VerticalStackLayout Grid.Column="1" Spacing="24">
                        <!-- Automated Schedule Card -->
                        <Border StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="#064E3B" Padding="24">
                            <Grid RowDefinitions="Auto, *, Auto">
                                <Label Text="Automated Schedule" TextColor="White" FontSize="16" FontAttributes="Bold" />
                                <Label Grid.Row="1" Text="Receive monthly summaries directly to your email on the 1st of every month." 
                                       TextColor="#D1FAE5" FontSize="13" Margin="0,12,0,24" LineBreakMode="WordWrap" />
                                <Button Grid.Row="2" Text="Configure Automation" BackgroundColor="#0D9488" TextColor="White" 
                                        FontAttributes="Bold" CornerRadius="8" HeightRequest="40" Padding="16,0" />
                                
                                <!-- Background Icon Overlay (Large Clock) -->
                                <Path Grid.RowSpan="3" Data="M11.99,2C6.47,2,2,6.48,2,12s4.47,10,9.99,10C17.52,22,22,17.52,22,12S17.52,2,11.99,2z M12,20c-4.42,0-8-3.58-8-8 s3.58-8,8-8s8,3.58,8,8S16.42,20,12,20z M12.5,7H11v6l5.25,3.15l0.75-1.23L12.5,12.5V7z" 
                                      Fill="White" Opacity="0.1" Aspect="Uniform" HeightRequest="140" WidthRequest="140" 
                                      HorizontalOptions="End" VerticalOptions="End" Margin="0,0,-40,-40" />
                            </Grid>
                        </Border>

                        <!-- Report Builder Tips -->
                        <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F1F5F9" Padding="24">
                            <VerticalStackLayout Spacing="16">
                                <Label Text="Report Builder Tips" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                                
                                <Grid ColumnDefinitions="20, *">
                                    <Label Text="💡" FontSize="14" VerticalOptions="Start" />
                                    <Label Grid.Column="1" Text="Use CSV format if you plan to import data into Excel or Google Sheets." 
                                           TextColor="#475569" FontSize="12" LineBreakMode="WordWrap" />
                                </Grid>

                                <Grid ColumnDefinitions="20, *">
                                    <Label Text="🛡️" FontSize="14" VerticalOptions="Start" />
                                    <Label Grid.Column="1" Text="Reports containing sensitive tax ID info are automatically password-protected." 
                                           TextColor="#475569" FontSize="12" LineBreakMode="WordWrap" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
