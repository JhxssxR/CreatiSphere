<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CreatiSphere.Views.Finance.MonitorRevenuePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <ContentPage.Resources>
        <Style x:Key="HoverCardStyle" TargetType="Border">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="#E2E8F0" />
                                <Setter Property="BackgroundColor" Value="White" />
                                <Setter Property="TranslationY" Value="0" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="#0D9488" />
                                <Setter Property="BackgroundColor" Value="#F8FAFC" />
                                <Setter Property="TranslationY" Value="-4" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="260, *">

        <!-- ===== FINANCE SIDEBAR ===== -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" BackgroundColor="#1E293B">
            
            <!-- Brand Logo -->
            <VerticalStackLayout Grid.Row="0" Padding="24,32" Spacing="4">
                <HorizontalStackLayout Spacing="12">
                    <Border BackgroundColor="#0D9488" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 8">
                        <Label Text="◈" TextColor="White" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="CreatiSphere" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="FINANCE STAFF PORTAL" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" Margin="44,0,0,0" />
            </VerticalStackLayout>

            <!-- Nav Items -->
            <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="12,0">
                
                <!-- Financial Dashboards -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDashboardClicked"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M3,13h8V3H3V13z M3,21h8v-6H3V21z M13,21h8V11h-8V21z M13,3v6h8V3H13z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Financial Dashboards" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Monitor Revenue (Active) -->
                <Border BackgroundColor="#0D9488" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M7,2v11h3v9l7-12h-4l4-8H7z" Fill="White" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Monitor Revenue" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Business Reports -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBusinessReportsClicked"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M19,19H5V5h14V19z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Business Reports" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>

            <!-- Profile Bottom -->
            <VerticalStackLayout Grid.Row="2" Padding="24" Spacing="24">
                <BoxView HeightRequest="1" Color="#334155" />
                <Grid ColumnDefinitions="Auto, *">
                    <Border HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                        <Image Source="staff_avatar.png" Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="12,0">
                        <Label Text="Alex Thorne" TextColor="White" FontSize="14" FontAttributes="Bold" />
                        <Label Text="Senior Controller" TextColor="#94A3B8" FontSize="11" />
                    </VerticalStackLayout>
                </Grid>
                <HorizontalStackLayout Spacing="12" Padding="4">
                    <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnSignOutClicked"/></HorizontalStackLayout.GestureRecognizers>
                    <Path Data="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z" Fill="#F87171" Aspect="Uniform" HeightRequest="18" WidthRequest="18" />
                    <Label Text="Sign Out" TextColor="#F87171" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <!-- ===== MAIN CONTENT ===== -->
        <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="40" Spacing="32">
                
                <!-- Top Bar -->
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Revenue Analytics" TextColor="#0F172A" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
                    
                    <HorizontalStackLayout Grid.Column="1" Spacing="16">
                        <Border BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" Padding="12,0" HeightRequest="40" WidthRequest="300">
                            <Grid ColumnDefinitions="20, *">
                                <Path Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16 c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5 S11.99,14,9.5,14z" Fill="#64748B" Aspect="Uniform" VerticalOptions="Center" />
                                <Entry Grid.Column="1" Placeholder="Search transactions..." PlaceholderColor="#64748B" TextColor="#0F172A" FontSize="13" Margin="8,0,0,0" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Border BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" HeightRequest="40" WidthRequest="40">
                            <Path Data="M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-0.83-0.67-1.5-1.5-1.5 s-1.5,0.67-1.5,1.5v0.68C7.64,5.36,6,7.92,6,11v5l-2,2v1h16v-1L18,16z" Fill="#64748B" Aspect="Uniform" HeightRequest="18" WidthRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" HeightRequest="40" WidthRequest="40">
                            <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.91,7.62,6.29L5.23,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.72,8.87 c-0.11,0.21-0.06,0.47,0.12,0.61l2.03,1.58C4.84,11.36,4.81,11.69,4.81,12c0,0.31,0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.11-0.21,0.06-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" Fill="#64748B" Aspect="Uniform" HeightRequest="18" WidthRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                            <Image Source="staff_avatar.png" Aspect="AspectFill" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Filter Bar -->
                <Grid ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="12">
                    <Border BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" Padding="16,8">
                        <HorizontalStackLayout Spacing="12">
                            <Path Data="M19,3h-1V1h-2v2H8V1H6v2H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M19,19H5V8h14V19z" Fill="#64748B" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center"/>
                            <Label Text="Last 30 Days" TextColor="#475569" FontSize="13" VerticalOptions="Center" />
                            <Path Data="M7,10l5,5l5-5H7z" Fill="#64748B" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                    <Border BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" Padding="16,8">
                        <HorizontalStackLayout Spacing="12">
                            <Path Data="M10,18h4v-2h-4V18z M3,6v2h18V6H3z M6,13h12v-2H6V13z" Fill="#64748B" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center"/>
                            <Label Text="All Channels" TextColor="#475569" FontSize="13" VerticalOptions="Center" />
                            <Path Data="M7,10l5,5l5-5H7z" Fill="#64748B" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                    
                    <Button Grid.Column="3" Text="Export CSV" Clicked="OnExportCsvClicked" BackgroundColor="#0D9488" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="40" Padding="20,0" />
                </Grid>

                <!-- Stats Cards Row -->
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="20">
                    <!-- Total Revenue -->
                    <Border Grid.Column="0" Style="{StaticResource HoverCardStyle}" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="20">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="TOTAL REVENUE" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding TotalRevenue}" TextColor="#0D9488" FontSize="24" FontAttributes="Bold" />
                                <Label Text="↗ 12%" TextColor="#0D9488" FontSize="11" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <!-- Commissions -->
                    <Border Grid.Column="1" Style="{StaticResource HoverCardStyle}" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="20">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="COMMISSIONS" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Commissions}" TextColor="#0F172A" FontSize="24" FontAttributes="Bold" />
                                <Label Text="↘ 0.2%" TextColor="#EF4444" FontSize="11" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <!-- Pending Payouts -->
                    <Border Grid.Column="2" Style="{StaticResource HoverCardStyle}" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="0">
                        <Grid ColumnDefinitions="4, *">
                            <BoxView Grid.Column="0" BackgroundColor="#0D9488" WidthRequest="4" VerticalOptions="Fill" />
                            <VerticalStackLayout Grid.Column="1" Spacing="8" Padding="20">
                                <Label Text="PENDING PAYOUTS" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding PendingPayouts}" TextColor="#0F172A" FontSize="24" FontAttributes="Bold" />
                                    <Path Data="M11.99,2C6.47,2,2,6.48,2,12s4.47,10,9.99,10C17.52,22,22,17.52,22,12S17.52,2,11.99,2z M12,20c-4.42,0-8-3.58-8-8 s3.58-8,8-8s8,3.58,8,8S16.42,20,12,20z M12.5,7H11v6l5.25,3.15l0.75-1.23L12.5,12.5V7z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Revenue Trends Chart -->
                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="24">
                    <VerticalStackLayout Spacing="24">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Revenue Trends" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" />
                            <HorizontalStackLayout Grid.Column="1" BackgroundColor="#F1F5F9" Padding="4" Spacing="4">
                                <Border x:Name="DailyTabBorder" BackgroundColor="White" StrokeShape="RoundRectangle 4" StrokeThickness="0" Padding="8,4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDailyTabTapped" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="DailyTabLabel" Text="DAILY" TextColor="#0D9488" FontSize="10" FontAttributes="Bold" />
                                </Border>
                                <Border x:Name="WeeklyTabBorder" BackgroundColor="Transparent" StrokeShape="RoundRectangle 4" StrokeThickness="0" Padding="8,4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnWeeklyTabTapped" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="WeeklyTabLabel" Text="WEEKLY" TextColor="#64748B" FontSize="10" FontAttributes="Bold" />
                                </Border>
                                <Border x:Name="MonthlyTabBorder" BackgroundColor="Transparent" StrokeShape="RoundRectangle 4" StrokeThickness="0" Padding="8,4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMonthlyTabTapped" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="MonthlyTabLabel" Text="MONTHLY" TextColor="#64748B" FontSize="10" FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- Custom Bar Chart Visualization -->
                        <Grid HeightRequest="200" ColumnDefinitions="*, *, *, *, *, *, *" ColumnSpacing="12" VerticalOptions="End">
                            <BoxView Grid.Column="0" HeightRequest="{Binding BarHeight0}" CornerRadius="4" BackgroundColor="#CCFBF1" VerticalOptions="End" />
                            <BoxView Grid.Column="1" HeightRequest="{Binding BarHeight1}" CornerRadius="4" BackgroundColor="#99F6E4" VerticalOptions="End" />
                            <BoxView Grid.Column="2" HeightRequest="{Binding BarHeight2}" CornerRadius="4" BackgroundColor="#0D9488" VerticalOptions="End" />
                            <BoxView Grid.Column="3" HeightRequest="{Binding BarHeight3}" CornerRadius="4" BackgroundColor="#5EEAD4" VerticalOptions="End" />
                            <BoxView Grid.Column="4" HeightRequest="{Binding BarHeight4}" CornerRadius="4" BackgroundColor="#99F6E4" VerticalOptions="End" />
                            <BoxView Grid.Column="5" HeightRequest="{Binding BarHeight5}" CornerRadius="4" BackgroundColor="#0D9488" VerticalOptions="End" />
                            <BoxView Grid.Column="6" HeightRequest="{Binding BarHeight6}" CornerRadius="4" BackgroundColor="#CCFBF1" VerticalOptions="End" />
                        </Grid>

                        <Grid ColumnDefinitions="*, *, *, *, *, *, *">
                            <Label Text="{Binding LabelText0}" HorizontalOptions="Center" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="{Binding LabelText1}" HorizontalOptions="Center" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" />
                            <Label Grid.Column="2" Text="{Binding LabelText2}" HorizontalOptions="Center" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" />
                            <Label Grid.Column="3" Text="{Binding LabelText3}" HorizontalOptions="Center" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" />
                            <Label Grid.Column="4" Text="{Binding LabelText4}" HorizontalOptions="Center" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" />
                            <Label Grid.Column="5" Text="{Binding LabelText5}" HorizontalOptions="Center" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" />
                            <Label Grid.Column="6" Text="{Binding LabelText6}" HorizontalOptions="Center" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Recent Transactions -->
                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="0">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*, Auto" Padding="24,16">
                            <Label Text="Recent Transactions" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="View All" TextColor="#0D9488" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F1F5F9" />

                        <!-- Table Header -->
                        <Grid ColumnDefinitions="*, 2.5*, 1.5*, 1.2*, 1.2*, Auto" Padding="24,12" BackgroundColor="#F8FAFC">
                            <Label Text="DATE" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label Grid.Column="1" Text="ITEM/DESCRIPTION" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label Grid.Column="2" Text="CHANNEL" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label Grid.Column="3" Text="AMOUNT" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label Grid.Column="4" Text="STATUS" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Transactions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="*, 2.5*, 1.5*, 1.2*, 1.2*, Auto" Padding="24,16">
                                            <Label Text="{Binding Date}" TextColor="#64748B" FontSize="13" VerticalOptions="Center" />
                                            <HorizontalStackLayout Grid.Column="1" Spacing="12">
                                                <Border BackgroundColor="#F1F5F9" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 4">
                                                    <Label Text="{Binding Initials}" TextColor="#475569" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <VerticalStackLayout VerticalOptions="Center">
                                                    <Label Text="{Binding CustomerName}" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" />
                                                    <Label Text="{Binding TransactionID}" TextColor="#94A3B8" FontSize="11" />
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>
                                            <Label Grid.Column="2" Text="{Binding PaymentMethod}" TextColor="#475569" FontSize="13" VerticalOptions="Center" />
                                            <Label Grid.Column="3" Text="{Binding AmountFormatted}" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                            
                                            <!-- Status Badge -->
                                            <Border Grid.Column="4" StrokeShape="RoundRectangle 12" Padding="10,4" HorizontalOptions="Start">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="BackgroundColor" Value="#F0FDFA" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Processing">
                                                        <Setter Property="BackgroundColor" Value="#F1F5F9" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Text="{Binding Status}" FontSize="10" FontAttributes="Bold">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="TextColor" Value="#0D9488" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Processing">
                                                            <Setter Property="TextColor" Value="#64748B" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                            <Label Grid.Column="5" Text="⋮" TextColor="#94A3B8" FontSize="20" VerticalOptions="Center" />
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="#F1F5F9" Margin="24,0" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
