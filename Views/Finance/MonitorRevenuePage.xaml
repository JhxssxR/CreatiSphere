                                <Label Grid.Column="2" Text="WED" HorizontalOptions="Center" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" />
                                <Label Grid.Column="3" Text="THU" HorizontalOptions="Center" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" />
                                <Label Grid.Column="4" Text="FRI" HorizontalOptions="Center" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" />
