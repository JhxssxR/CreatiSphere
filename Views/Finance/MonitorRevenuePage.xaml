                            <HorizontalStackLayout Spacing="8">
                                <Label Text="$128,450.00" TextColor="#0D9488" FontSize="24" FontAttributes="Bold" />
                                <Label Text="↗ 12%" TextColor="#0D9488" FontSize="11" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <!-- Asset Sales -->
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="20">
