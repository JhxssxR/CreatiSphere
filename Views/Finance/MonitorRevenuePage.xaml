                                    <Label Grid.Column="1" Text="30%" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" />
                                </Grid>
                                <ProgressBar Progress="0.30" ProgressColor="#2DD4BF" />
                            </VerticalStackLayout>

                            <!-- Breakdown Item 3 -->
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="Motion Graphics" TextColor="#475569" FontSize="13" />
                                    <Label Grid.Column="1" Text="18%" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" />
                                </Grid>
                                <ProgressBar Progress="0.18" ProgressColor="#99F6E4" />
