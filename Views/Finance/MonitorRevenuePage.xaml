                            <Label Text="Oct 24, 2026" TextColor="#64748B" FontSize="13" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="12">
                                <Border BackgroundColor="#F1F5F9" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 4">
                                    <Path Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M12,20c-4.42,0-8-3.58-8-8s3.58-8,8-8s8,3.58,8,8 S16.42,20,12,20z" Fill="#64748B" Aspect="Uniform" HeightRequest="14" WidthRequest="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="Abstract Geometry Set" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" />
                                    <Label Text="ID: #CS-8921" TextColor="#94A3B8" FontSize="11" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                            <Label Grid.Column="2" Text="Marketplace" TextColor="#475569" FontSize="13" VerticalOptions="Center" />
                            <Label Grid.Column="3" Text="$1,200.00" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                            <Border Grid.Column="4" BackgroundColor="#F0FDFA" StrokeShape="RoundRectangle 12" Padding="10,4" HorizontalOptions="Start">
                                <Label Text="DELIVERED" TextColor="#0D9488" FontSize="10" FontAttributes="Bold" />
                            </Border>
                            <Label Grid.Column="5" Text="⋮" TextColor="#94A3B8" FontSize="20" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F1F5F9" Margin="24,0" />

                        <!-- Row 2 -->
                        <Grid ColumnDefinitions="*, 2.5*, 1.5*, 1.2*, 1.2*, Auto" Padding="24,16">
                            <Label Text="Oct 24, 2026" TextColor="#64748B" FontSize="13" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="12">
                                <Border BackgroundColor="#F1F5F9" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 4">
                                    <Path Data="M3,17.25V21h3.75L17.81,9.94l-3.75-3.75L3,17.25z M20.71,7.04c0.39-0.39,0.39-1.02,0-1.41l-2.34-2.34 c-0.39-0.39-1.02-0.39-1.41,0l-1.83,1.83l3.75,3.75L20.71,7.04z" Fill="#64748B" Aspect="Uniform" HeightRequest="14" WidthRequest="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout VerticalOptions="Center">
                                    <Label Text="Custom Brand Mascot" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" />
                                    <Label Text="ID: #CS-8922" TextColor="#94A3B8" FontSize="11" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
