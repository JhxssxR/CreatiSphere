                                    <Label Text="WEEKLY" TextColor="#64748B" FontSize="10" FontAttributes="Bold" Padding="8,4" />
                                    <Label Text="MONTHLY" TextColor="#64748B" FontSize="10" FontAttributes="Bold" Padding="8,4" />
                                </HorizontalStackLayout>
                            </Grid>

