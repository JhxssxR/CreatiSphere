<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CreatiSphere.Views.Finance.FinanceDashboardPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <ContentPage.Resources>
        <Style x:Key="HoverCardStyle" TargetType="Border">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="#E2E8F0" />
                                <Setter Property="BackgroundColor" Value="White" />
                                <Setter Property="TranslationY" Value="0" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="#0D9488" />
                                <Setter Property="BackgroundColor" Value="#F8FAFC" />
                                <Setter Property="TranslationY" Value="-4" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="260, *">

        <!-- ===== FINANCE SIDEBAR ===== -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" BackgroundColor="#1E293B">
            
            <!-- Brand Logo -->
            <VerticalStackLayout Grid.Row="0" Padding="24,32" Spacing="4">
                <HorizontalStackLayout Spacing="12">
                    <Border BackgroundColor="#0D9488" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 8">
                        <Label Text="◈" TextColor="White" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="CreatiSphere" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="FINANCE STAFF PORTAL" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" Margin="44,0,0,0" />
            </VerticalStackLayout>

            <!-- Nav Items -->
            <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="12,0">
                
                <!-- Financial Dashboards (Active) -->
                <Border BackgroundColor="#0D9488" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M3,13h8V3H3V13z M3,21h8v-6H3V21z M13,21h8V11h-8V21z M13,3v6h8V3H13z" Fill="White" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Financial Dashboards" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Monitor Revenue -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnMonitorRevenueClicked"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M7,2v11h3v9l7-12h-4l4-8H7z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Monitor Revenue" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Business Reports -->
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBusinessReportsClicked"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M19,19H5V5h14V19z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Business Reports" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Profile Bottom -->
            <VerticalStackLayout Grid.Row="2" Padding="24" Spacing="24">
                <BoxView HeightRequest="1" Color="#334155" />
                <Grid ColumnDefinitions="Auto, *">
                    <Border HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                        <Image Source="staff_avatar.png" Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="12,0">
                        <Label Text="Alex Thorne" TextColor="White" FontSize="14" FontAttributes="Bold" />
                        <Label Text="Senior Controller" TextColor="#94A3B8" FontSize="11" />
                    </VerticalStackLayout>
                </Grid>
                <HorizontalStackLayout Spacing="12" Padding="4">
                    <HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Tapped="OnSignOutClicked"/></HorizontalStackLayout.GestureRecognizers>
                    <Path Data="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z" Fill="#F87171" Aspect="Uniform" HeightRequest="18" WidthRequest="18" />
                    <Label Text="Sign Out" TextColor="#F87171" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <!-- ===== MAIN CONTENT ===== -->
        <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="40" Spacing="32">
                
                <!-- Top Bar -->
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Revenue Overview" TextColor="#0F172A" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
                    
                    <HorizontalStackLayout Grid.Column="1" Spacing="16">
                        <Border BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="12,0" HeightRequest="40" WidthRequest="300">
                            <Grid ColumnDefinitions="20, *">
                                <Path Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16 c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5 S11.99,14,9.5,14z" Fill="#64748B" Aspect="Uniform" VerticalOptions="Center" />
                                <Entry Grid.Column="1" Placeholder="Search transactions..." PlaceholderColor="#64748B" TextColor="#0F172A" FontSize="13" Margin="8,0,0,0" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Border BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" HeightRequest="40" WidthRequest="40">
                            <Path Data="M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-0.83-0.67-1.5-1.5-1.5 s-1.5,0.67-1.5,1.5v0.68C7.64,5.36,6,7.92,6,11v5l-2,2v1h16v-1L18,16z" Fill="#64748B" Aspect="Uniform" HeightRequest="18" WidthRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" HeightRequest="40" WidthRequest="40">
                            <Path Data="M19,3h-1V1h-2v2H8V1H6v2H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M19,19H5V8h14V19z" Fill="#64748B" Aspect="Uniform" HeightRequest="18" WidthRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Stats Cards Row -->
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="24">
                    <Border Grid.Column="0" Style="{StaticResource HoverCardStyle}" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="24">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Total Revenue" TextColor="#64748B" FontSize="13" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="12">
                                <Label x:Name="TotalRevenueLabel" Text="{Binding TotalRevenue}" TextColor="#0F172A" FontSize="28" FontAttributes="Bold" />
                                <Label Text="+12.5%" TextColor="#0D9488" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="Growth compared to last month" TextColor="#94A3B8" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource HoverCardStyle}" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="24">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Outstanding Payouts" TextColor="#64748B" FontSize="13" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="12">
                                <Label x:Name="OutstandingPayoutsLabel" Text="{Binding OutstandingPayouts}" TextColor="#0F172A" FontSize="28" FontAttributes="Bold" />
                                <Label Text="-4.2%" TextColor="#EF4444" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="Pending creator distributions" TextColor="#94A3B8" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource HoverCardStyle}" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="24">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Net Profit" TextColor="#64748B" FontSize="13" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="12">
                                <Label x:Name="NetProfitLabel" Text="{Binding NetProfit}" TextColor="#0F172A" FontSize="28" FontAttributes="Bold" />
                                <Label Text="+8.1%" TextColor="#0D9488" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="After creator and operational costs" TextColor="#94A3B8" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Chart Card -->
                <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="32">
                    <Grid RowDefinitions="Auto, *">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Revenue Over Time" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" />
                                <Label Text="Fiscal Year 2026 Performance Data" TextColor="#64748B" FontSize="13" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="12">
                                <Border BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" Padding="16,8">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnExportCsvClicked"/></Border.GestureRecognizers>
                                    <Label Text="Export CSV" TextColor="#475569" FontSize="13" FontAttributes="Bold" />
                                </Border>
                                <Border BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" Padding="16,8">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnFilterClicked"/></Border.GestureRecognizers>
                                    <Label x:Name="FilterLabel" Text="Last 12 Months ▾" TextColor="#475569" FontSize="13" FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,24,0,0" RowDefinitions="*, Auto" HeightRequest="320">
                            <!-- Y Axis grid lines -->
                            <VerticalStackLayout Spacing="55" VerticalOptions="Fill">
                                <BoxView HeightRequest="1" Color="#F1F5F9" />
                                <BoxView HeightRequest="1" Color="#F1F5F9" />
                                <BoxView HeightRequest="1" Color="#F1F5F9" />
                                <BoxView HeightRequest="1" Color="#F1F5F9" />
                                <BoxView HeightRequest="1" Color="#F1F5F9" />
                            </VerticalStackLayout>

                            <!-- Bar Chart -->
                            <FlexLayout x:Name="RevenueChartLayout" BindableLayout.ItemsSource="{Binding ChartData}" Grid.Row="0" Grid.RowSpan="2" Margin="20,10,20,30" JustifyContent="SpaceEvenly" AlignItems="End">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="8" VerticalOptions="End">
                                            <Label Text="{Binding RevenueFormatted}" TextColor="#0D9488" FontSize="9" FontAttributes="Bold" HorizontalOptions="Center" />
                                            <Border HeightRequest="{Binding BarHeight}" WidthRequest="40" BackgroundColor="#0D9488" StrokeThickness="0" StrokeShape="RoundRectangle 6,6,0,0" VerticalOptions="End">
                                                <Border.Shadow><Shadow Brush="#0D9488" Opacity="0.25" Offset="0,4" Radius="8"/></Border.Shadow>
                                            </Border>
                                            <Label Text="{Binding Month}" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Transactions Section -->
                <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="0">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*, Auto" Padding="32,24">
                            <Label Text="Recent Financial Transactions" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="View All Activity" TextColor="#0D9488" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F1F5F9" />

                        <!-- Table Header -->
                        <Grid ColumnDefinitions="1.5*, 1.5*, 1.2*, *, *, Auto" Padding="32,16" BackgroundColor="#F8FAFC">
                            <Label Text="TRANSACTION ID" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label Grid.Column="1" Text="SOURCE" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label Grid.Column="2" Text="STATUS" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label Grid.Column="3" Text="AMOUNT" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label Grid.Column="4" Text="DATE" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                        </Grid>

                        <!-- Transaction Rows (Dynamic) -->
                        <VerticalStackLayout x:Name="TransactionsList" BindableLayout.ItemsSource="{Binding Transactions}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="1.5*, 1.5*, 1.2*, *, *, Auto" Padding="32,20">
                                            <Label Text="{Binding TransactionID}" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                            <HorizontalStackLayout Grid.Column="1" Spacing="12">
                                                <Border BackgroundColor="#F1F5F9" HeightRequest="28" WidthRequest="28" StrokeShape="RoundRectangle 4">
                                                    <Label Text="{Binding Initials}" TextColor="#475569" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <VerticalStackLayout VerticalOptions="Center">
                                                    <Label Text="{Binding CustomerName}" TextColor="#0F172A" FontSize="12" FontAttributes="Bold" />
                                                    <Label Text="Payment" TextColor="#64748B" FontSize="11" />
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>
                                            
                                            <!-- Status Badge -->
                                            <Border Grid.Column="2" StrokeShape="RoundRectangle 12" Padding="12,4" HorizontalOptions="Start">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="BackgroundColor" Value="#F0FDFA" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Succeeded">
                                                        <Setter Property="BackgroundColor" Value="#F0FDFA" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="BackgroundColor" Value="#EFF6FF" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Refunded">
                                                        <Setter Property="BackgroundColor" Value="#FEF2F2" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <HorizontalStackLayout Spacing="6">
                                                    <Ellipse HeightRequest="6" WidthRequest="6" VerticalOptions="Center">
                                                        <Ellipse.Triggers>
                                                            <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="Fill" Value="#0D9488" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Succeeded">
                                                                <Setter Property="Fill" Value="#0D9488" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Pending">
                                                                <Setter Property="Fill" Value="#3B82F6" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Refunded">
                                                                <Setter Property="Fill" Value="#EF4444" />
                                                            </DataTrigger>
                                                        </Ellipse.Triggers>
                                                    </Ellipse>
                                                    <Label Text="{Binding Status}" FontSize="10" FontAttributes="Bold">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="TextColor" Value="#0D9488" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Succeeded">
                                                                <Setter Property="TextColor" Value="#0D9488" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Pending">
                                                                <Setter Property="TextColor" Value="#3B82F6" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Refunded">
                                                                <Setter Property="TextColor" Value="#EF4444" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </HorizontalStackLayout>
                                            </Border>

                                            <Label Grid.Column="3" Text="{Binding AmountFormatted}" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Label Grid.Column="4" Text="{Binding Date}" TextColor="#64748B" FontSize="13" VerticalOptions="Center" />
                                            <Label Grid.Column="5" Text="•••" TextColor="#94A3B8" FontSize="18" VerticalOptions="Center" />
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="#F1F5F9" Margin="32,0" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Footer -->
                        <Grid ColumnDefinitions="*, Auto" Padding="32,24" BackgroundColor="#F8FAFC">
                            <Label Text="Showing 4 of 1,248 transactions" TextColor="#94A3B8" FontSize="12" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <Button Text="Previous" BackgroundColor="White" TextColor="#475569" BorderColor="#E2E8F0" BorderWidth="1" CornerRadius="8" HeightRequest="36" Padding="16,0" FontSize="12" FontAttributes="Bold" />
                                <Button Text="Next" BackgroundColor="White" TextColor="#475569" BorderColor="#E2E8F0" BorderWidth="1" CornerRadius="8" HeightRequest="36" Padding="16,0" FontSize="12" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
