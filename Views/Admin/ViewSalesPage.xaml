<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:admin="clr-namespace:CreatiSphere.Views.Admin"
             x:Class="CreatiSphere.Views.Admin.ViewSalesPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Slate50}">

    <Grid ColumnDefinitions="280, *">
        <!-- Sidebar -->
        <admin:AdminSidebar Grid.Column="0" ActivePage="ViewSales" />

        <!-- Main Content Area -->
        <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="40" Spacing="32">
                
                <!-- Top Nav Bar -->
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Sales Overview" TextColor="{StaticResource Slate900}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />

                    <!-- User Actions -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="24" VerticalOptions="Center">
                        <!-- Search Bar -->
                        <Border StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White" WidthRequest="320" Padding="16, 8">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="Stroke" Value="{StaticResource DashboardTeal}" />
                                            <Setter Property="BackgroundColor" Value="#F0FDFA" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid ColumnDefinitions="Auto, *">
                                <Path Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16 c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5 S11.99,14,9.5,14z" 
                                      Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" />
                                <Entry x:Name="SearchEntry" Grid.Column="1" Placeholder="Search transactions..." PlaceholderColor="{StaticResource Slate400}" TextColor="{StaticResource Slate900}" BackgroundColor="Transparent" Margin="8,0,0,0" FontSize="12" TextChanged="OnSearchTextChanged" />
                            </Grid>
                        </Border>

                        <Path Data="M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.1-1.6-5.6-4.5-6.3V4c0-0.8-0.7-1.5-1.5-1.5 S10.5,3.2,10.5,4v0.7C7.6,5.4,6,7.9,6,11v5l-2,2v1h16v-1L18,16z" 
                              Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                        <Path Data="M19.1,12.9l2.1,1.6c0.2,0.1,0.2,0.4,0.1,0.6l-2,3.5c-0.1,0.2-0.4,0.3-0.6,0.2l-2.5-1c-0.5,0.4-1.1,0.7-1.7,1 l-0.4,2.6c0,0.2-0.2,0.4-0.5,0.4h-4c-0.3,0-0.5-0.2-0.5-0.4l-0.4-2.6c-0.6-0.3-1.2-0.6-1.7-1l-2.5,1c-0.2,0.1-0.5,0-0.6-0.2l-2-3.5 C1.9,14.9,2,14.6,2.2,14.5l2.1-1.6c-0.1-0.3-0.1-0.6-0.1-0.9s0-0.6,0.1-0.9L2.2,8.6c-0.2-0.1-0.2-0.4-0.1-0.6l2-3.5c0.1-0.2,0.4-0.3,0.6-0.2 l2.5,1c0.5-0.4,1.1-0.7,1.7-1L9.4,1.7c0-0.2,0.2-0.4,0.5-0.4h4c0.3,0,0.5,0.2,0.5,0.4l0.4,2.6c0.6,0.3,1.2,0.6,1.7,1l2.5-1 c0.2-0.1,0.5,0,0.6,0.2l2,3.5c0.1,0.2,0,0.5-0.2,0.6l-2.1,1.6c0.1,0.3,0.1,0.6,0.1,0.9S19.2,12.6,19.1,12.9z M12,15c1.7,0,3-1.3,3-3 s-1.3-3-3-3s-3,1.3-3,3S10.3,15,12,15z" 
                              Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                        
                        <Border HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                            <Image Source="avatar.png" Aspect="AspectFill" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Summary Cards Row -->
                <Grid ColumnDefinitions="*, *, *, 280" ColumnSpacing="20">
                    <!-- Total Revenue -->
                    <Border Grid.Column="0" Padding="24" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#F8FAFC" />
                                        <Setter Property="Stroke" Value="{StaticResource DashboardTeal}" />
                                        <Setter Property="TranslationY" Value="-4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="TOTAL REVENUE" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                            <Label x:Name="TotalRevenueLabel" Text="$0.00" TextColor="{StaticResource Slate900}" FontSize="28" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="4">
                                <Path Data="M7,14l5-5l5,5" Fill="{StaticResource SuccessGreen}" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" />
                                <Label Text="+12.4% vs last month" TextColor="{StaticResource SuccessGreen}" FontSize="12" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            <!-- Background Icon -->
                            <Path Data="M21,19V5c0-1.1-0.9-2-2-2H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14C20.1,21,21,20.1,21,19z M8.5,13.5l2.5,3.01L14.5,12l4.5,6H5 L8.5,13.5z" 
                                  Fill="{StaticResource Slate100}" Aspect="Uniform" HeightRequest="64" WidthRequest="64" HorizontalOptions="End" Margin="0,-48,-16,0" Opacity="0.5" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Today's Sales -->
                    <Border Grid.Column="1" Padding="24" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#F8FAFC" />
                                        <Setter Property="Stroke" Value="{StaticResource DashboardTeal}" />
                                        <Setter Property="TranslationY" Value="-4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="TODAY'S SALES" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                            <Label x:Name="TodaySalesLabel" Text="$0.00" TextColor="{StaticResource Slate900}" FontSize="28" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="4">
                                <Path Data="M7,2v10l3.35-3.35L14,12l-5,5l-5-5l3.35,3.35L7,2z" Fill="{StaticResource DashboardTeal}" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" />
                                <Label x:Name="TodayTransactionsLabel" Text="0 transactions today" TextColor="{StaticResource DashboardTeal}" FontSize="12" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            <!-- Background Icon -->
                            <Path Data="M19,3h-1V1h-2v2H8V1H6v2H5C3.89,3,3,3.9,3,5v14c0,1.1,0.89,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M19,19H5V8h14V19z" 
                                  Fill="{StaticResource Slate100}" Aspect="Uniform" HeightRequest="64" WidthRequest="64" HorizontalOptions="End" Margin="0,-48,-16,0" Opacity="0.5" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Avg. Order Value -->
                    <Border Grid.Column="2" Padding="24" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#F8FAFC" />
                                        <Setter Property="Stroke" Value="{StaticResource DashboardTeal}" />
                                        <Setter Property="TranslationY" Value="-4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="AVG. ORDER VALUE" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                            <Label x:Name="AvgOrderValueLabel" Text="$0.00" TextColor="{StaticResource Slate900}" FontSize="28" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="4">
                                <Path Data="M22,7.5l-7.08,7.07l-4.24-4.24L2,19" Stroke="{StaticResource Slate500}" StrokeThickness="2" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" />
                                <Label Text="Stable Performance" TextColor="{StaticResource Slate500}" FontSize="12" />
                            </HorizontalStackLayout>
                            <!-- Background Icon -->
                            <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M19,19H5V5h14V19z" 
                                  Fill="{StaticResource Slate100}" Aspect="Uniform" HeightRequest="64" WidthRequest="64" HorizontalOptions="End" Margin="0,-48,-16,0" Opacity="0.5" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Conversion Rate -->
                    <Border Grid.Column="3" Padding="24" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{StaticResource Slate900}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="CONVERSION RATE" TextColor="{StaticResource Slate400}" FontSize="10" FontAttributes="Bold" />
                            <Label x:Name="ConversionRateLabel" Text="0.0%" TextColor="White" FontSize="36" FontAttributes="Bold" />
                            <Label Text="Analytics Chart" TextColor="{StaticResource Slate500}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Recent Transactions Table Section -->
                <Border Padding="0" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*, Auto" Padding="24, 20">
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                <Label Text="Recent Transactions" TextColor="{StaticResource Slate900}" FontSize="18" FontAttributes="Bold" />
                                <Border BackgroundColor="{StaticResource Slate100}" Padding="8, 2" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                                    <Label Text="942 Total" TextColor="{StaticResource Slate600}" FontSize="11" FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                            
                            <HorizontalStackLayout Grid.Column="1" Spacing="12">
                                <Button Text="Filters" 
                                        Clicked="OnFiltersClicked"
                                        TextColor="{StaticResource Slate700}" 
                                        BackgroundColor="White"
                                        BorderColor="{StaticResource Slate200}"
                                        BorderWidth="1"
                                        CornerRadius="8"
                                        Padding="16, 8"
                                        FontSize="13" />
                                <Button Text="Export CSV" 
                                        Clicked="OnExportClicked"
                                        TextColor="White" 
                                        BackgroundColor="{StaticResource DashboardTeal}"
                                        CornerRadius="8"
                                        Padding="16, 8"
                                        FontSize="13" />
                            </HorizontalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Slate200}" />

                        <!-- Table Headers -->
                        <Grid ColumnDefinitions="1.5*, 3*, 1.5*, 1.5*, 1.5*, Auto" Padding="24, 16" BackgroundColor="#F8FAFC">
                            <Label Grid.Column="0" Text="TRANSACTION ID" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="CUSTOMER" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="2" Text="DATE &amp; TIME" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="3" Text="TOTAL AMOUNT" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="4" Text="STATUS" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="5" Text="ACTIONS" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Slate200}" />

                        <VerticalStackLayout x:Name="TransactionsList" BindableLayout.ItemsSource="{Binding .}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="1.5*, 3*, 1.5*, 1.5*, 1.5*, Auto" Padding="24, 20" VerticalOptions="Center">
                                            <Label Grid.Column="0" Text="{Binding TransactionID}" TextColor="{StaticResource Slate600}" FontSize="14" VerticalOptions="Center" />
                                            <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                                                <Border BackgroundColor="#E2E8F0" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="0">
                                                    <Label Text="{Binding Initials}" TextColor="{StaticResource Slate600}" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <VerticalStackLayout VerticalOptions="Center" Spacing="1">
                                                    <Label Text="{Binding CustomerName}" TextColor="{StaticResource Slate900}" FontSize="14" FontAttributes="Bold" />
                                                    <Label Text="{Binding CustomerEmail}" TextColor="{StaticResource Slate500}" FontSize="11" />
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>
                                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="1">
                                                <Label Text="{Binding Date}" TextColor="{StaticResource Slate600}" FontSize="13" />
                                                <Label Text="{Binding Time}" TextColor="{StaticResource Slate400}" FontSize="11" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="3" Text="{Binding Amount, StringFormat='{0:C}'}" TextColor="{StaticResource Slate900}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Border Grid.Column="4" Padding="12, 4" StrokeShape="RoundRectangle 12" StrokeThickness="0" HorizontalOptions="Start" VerticalOptions="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BackgroundColor" Value="#F3F4F6" />
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="BackgroundColor" Value="#DCFCE7" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Pending">
                                                                <Setter Property="BackgroundColor" Value="#FEF3C7" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Label Text="{Binding Status}" FontSize="11" FontAttributes="Bold">
                                                    <Label.Style>
                                                        <Style TargetType="Label">
                                                            <Setter Property="TextColor" Value="{StaticResource Slate600}" />
                                                            <Style.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Completed">
                                                                    <Setter Property="TextColor" Value="#166534" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Pending">
                                                                    <Setter Property="TextColor" Value="#92400E" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Label.Style>
                                                </Label>
                                            </Border>
                                            <Label Grid.Column="5" Text="⋮" TextColor="{StaticResource Slate400}" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" Margin="12,0,0,0" />
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="{StaticResource Slate100}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource Slate200}" />

                        <!-- Pagination Footer -->
                        <Grid ColumnDefinitions="*, Auto" Padding="24, 16" BackgroundColor="#F8FAFC">
                            <Label Text="Showing 1-10 of 942 transactions" TextColor="{StaticResource Slate500}" FontSize="13" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                <Button Text="&lt;" Clicked="OnPageClicked" TextColor="{StaticResource Slate400}" BackgroundColor="White" BorderColor="{StaticResource Slate200}" BorderWidth="1" CornerRadius="6" WidthRequest="36" Padding="0" />
                                <Button Text="1" Clicked="OnPageClicked" TextColor="White" BackgroundColor="{StaticResource Slate900}" CornerRadius="6" WidthRequest="36" Padding="0" />
                                <Button Text="2" Clicked="OnPageClicked" TextColor="{StaticResource Slate600}" BackgroundColor="White" BorderColor="{StaticResource Slate200}" BorderWidth="1" CornerRadius="6" WidthRequest="36" Padding="0" />
                                <Button Text="3" Clicked="OnPageClicked" TextColor="{StaticResource Slate600}" BackgroundColor="White" BorderColor="{StaticResource Slate200}" BorderWidth="1" CornerRadius="6" WidthRequest="36" Padding="0" />
                                <Button Text="&gt;" Clicked="OnPageClicked" TextColor="{StaticResource Slate600}" BackgroundColor="White" BorderColor="{StaticResource Slate200}" BorderWidth="1" CornerRadius="6" WidthRequest="36" Padding="0" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>


    </Grid>

</ContentPage>
