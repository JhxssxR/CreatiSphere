<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:admin="clr-namespace:CreatiSphere.Views.Admin"
             x:Class="CreatiSphere.Views.Admin.ManageInventoryPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Slate50}">

    <Grid ColumnDefinitions="280, *">
        <!-- Sidebar -->
        <admin:AdminSidebar Grid.Column="0" ActivePage="ManageInventory" />

        <!-- Main Content Area -->
        <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="40" Spacing="32">
                
                <!-- Top Nav Bar -->
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="System Overview Dashboard" TextColor="{StaticResource Slate900}" FontSize="14" VerticalOptions="Center" />

                    <!-- User Actions -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="24" VerticalOptions="Center">
                        <!-- Search Bar -->
                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{StaticResource Slate100}" WidthRequest="300" Padding="12, 8">
                            <Grid ColumnDefinitions="Auto, *">
                                <Path Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16 c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5 S11.99,14,9.5,14z" 
                                      Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" />
                                <Entry Grid.Column="1" Placeholder="Search creatives, assets..." PlaceholderColor="{StaticResource Slate400}" TextColor="{StaticResource Slate900}" BackgroundColor="Transparent" Margin="8,0,0,0" FontSize="12" />
                            </Grid>
                        </Border>

                        <Path Data="M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.1-1.6-5.6-4.5-6.3V4c0-0.8-0.7-1.5-1.5-1.5 S10.5,3.2,10.5,4v0.7C7.6,5.4,6,7.9,6,11v5l-2,2v1h16v-1L18,16z" 
                              Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                        <Path Data="M19.1,12.9l2.1,1.6c0.2,0.1,0.2,0.4,0.1,0.6l-2,3.5c-0.1,0.2-0.4,0.3-0.6,0.2l-2.5-1c-0.5,0.4-1.1,0.7-1.7,1 l-0.4,2.6c0,0.2-0.2,0.4-0.5,0.4h-4c-0.3,0-0.5-0.2-0.5-0.4l-0.4-2.6c-0.6-0.3-1.2-0.6-1.7-1l-2.5,1c-0.2,0.1-0.5,0-0.6-0.2l-2-3.5 C1.9,14.9,2,14.6,2.2,14.5l2.1-1.6c-0.1-0.3-0.1-0.6-0.1-0.9s0-0.6,0.1-0.9L2.2,8.6c-0.2-0.1-0.2-0.4-0.1-0.6l2-3.5c0.1-0.2,0.4-0.3,0.6-0.2 l2.5,1c0.5-0.4,1.1-0.7,1.7-1L9.4,1.7c0-0.2,0.2-0.4,0.5-0.4h4c0.3,0,0.5,0.2,0.5,0.4l0.4,2.6c0.6,0.3,1.2,0.6,1.7,1l2.5-1 c0.2-0.1,0.5,0,0.6,0.2l2,3.5c0.1,0.2,0,0.5-0.2,0.6l-2.1,1.6c0.1,0.3,0.1,0.6,0.1,0.9S19.2,12.6,19.1,12.9z M12,15c1.7,0,3-1.3,3-3 s-1.3-3-3-3s-3,1.3-3,3S10.3,15,12,15z" 
                              Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                        
                        <Border BackgroundColor="{StaticResource DashboardTeal}" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                            <Label x:Name="HeaderProfileInitials" Text="AD" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSignOutClicked" />
                            </Border.GestureRecognizers>
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Page Header -->
                <Grid ColumnDefinitions="*, Auto" Margin="0, 16, 0, 0">
                    <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="Manage Inventory" TextColor="{StaticResource Slate900}" FontSize="28" FontAttributes="Bold" />
                        <Label Text="Track and optimize stock levels across all channels." TextColor="{StaticResource Slate600}" FontSize="14" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="16" VerticalOptions="Center">
                        <Button Text="Export CSV" 
                                Clicked="OnExportCsvClicked"
                                TextColor="{StaticResource Slate700}" 
                                BackgroundColor="White"
                                BorderColor="{StaticResource Slate300}"
                                BorderWidth="1"
                                CornerRadius="8"
                                Padding="16, 8"
                                FontSize="14" />
                        <Button Text="+ New Item" 
                                Clicked="OnNewItemClicked"
                                TextColor="White" 
                                BackgroundColor="{StaticResource DashboardTeal}"
                                CornerRadius="8"
                                Padding="16, 8"
                                FontSize="14" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Stats Cards -->
                <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="20">
                    <!-- Total Stock Value -->
                    <Border Grid.Column="0" Padding="24" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="Scale" Value="1.02" />
                                        <Setter Property="Stroke" Value="{StaticResource DashboardTeal}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="TOTAL STOCK VALUE" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                            <Label x:Name="TotalStockValueLabel" Text="$428,950.00" TextColor="{StaticResource Slate900}" FontSize="26" FontAttributes="Bold" />
                            <Path Data="M21,19V5c0-1.1-0.9-2-2-2H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14C20.1,21,21,20.1,21,19z M8.5,13.5l2.5,3.01L14.5,12l4.5,6H5 L8.5,13.5z" 
                                  Fill="{StaticResource Slate100}" Aspect="Uniform" HeightRequest="64" WidthRequest="64" HorizontalOptions="End" Margin="0,-32,-16,0" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Low Stock Alerts -->
                    <Border Grid.Column="1" Padding="24" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="Scale" Value="1.02" />
                                        <Setter Property="Stroke" Value="#E11D48" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="LOW STOCK ALERTS" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="8">
                                <Label x:Name="LowStockAlertsLabel" Text="12" TextColor="#E11D48" FontSize="26" FontAttributes="Bold" />
                                <Border BackgroundColor="#FFE4E6" Padding="8,4" StrokeShape="RoundRectangle 12" StrokeThickness="0" VerticalOptions="Center">
                                    <Label Text="CRITICAL" TextColor="#E11D48" FontSize="10" FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>
                            <Path Data="M1,21h22L12,2L1,21z M13,18h-2v-2h2V18z M13,14h-2v-4h2V14z" 
                                  Fill="#FFF1F2" Aspect="Uniform" HeightRequest="64" WidthRequest="64" HorizontalOptions="End" Margin="0,-32,-16,0" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Digital Assets -->
                    <Border Grid.Column="2" Padding="24" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="Scale" Value="1.02" />
                                        <Setter Property="Stroke" Value="{StaticResource DashboardTeal}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="DIGITAL ASSETS" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                            <Label x:Name="DigitalAssetsLabel" Text="1,402" TextColor="{StaticResource Slate900}" FontSize="26" FontAttributes="Bold" />
                            <Path Data="M19.35,10.04C18.67,6.59,15.64,4,12,4C9.11,4,6.6,5.64,5.35,8.04C2.34,8.36,0,10.91,0,14c0,3.31,2.69,6,6,6h13c2.76,0,5-2.24,5-5C24,12.36,21.95,10.22,19.35,10.04z" 
                                  Fill="{StaticResource Slate100}" Aspect="Uniform" HeightRequest="64" WidthRequest="64" HorizontalOptions="End" Margin="0,-32,-16,0" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Active Shipments -->
                    <Border Grid.Column="3" Padding="24" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="Scale" Value="1.02" />
                                        <Setter Property="Stroke" Value="{StaticResource DashboardTeal}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="ACTIVE SHIPMENTS" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                            <Label x:Name="ActiveShipmentsLabel" Text="45" TextColor="{StaticResource DashboardTeal}" FontSize="26" FontAttributes="Bold" />
                            <Path Data="M20,8h-3V4H3c-1.1,0-2,0.9-2,2v11h2c0,1.66,1.34,3,3,3s3-1.34,3-3h6c0,1.66,1.34,3,3,3s3-1.34,3-3h2v-5L20,8z M6,18.5c-0.83,0-1.5-0.67-1.5-1.5s0.67-1.5,1.5-1.5s1.5,0.67,1.5,1.5S6.83,18.5,6,18.5z M19.5,9.5l1.96,2.5H17V9.5H19.5z M18,18.5c-0.83,0-1.5-0.67-1.5-1.5s0.67-1.5,1.5-1.5s1.5,0.67,1.5,1.5S18.83,18.5,18,18.5z" 
                                  Fill="#F0FDFA" Aspect="Uniform" HeightRequest="64" WidthRequest="64" HorizontalOptions="End" Margin="0,-32,-16,0" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Inventory List Section -->
                <Border Padding="0" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White">
                    <VerticalStackLayout>
                        
                        <!-- Tabs -->
                        <Grid ColumnDefinitions="*, Auto" Padding="24, 20">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Border x:Name="TabAllItems" BackgroundColor="{StaticResource DashboardTealLight}" Padding="16, 8" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTabClicked" CommandParameter="All" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="8">
                                        <Path Data="M3,13h2v-2H3v2zm0,4h2v-2H3v2zm0-8h2V7H3v2zm4,4h14v-2H7v2zm0,4h14v-2H7v2zM7,7v2h14V7H7z" 
                                              Fill="{StaticResource DashboardTeal}" Aspect="Uniform" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                                        <Label x:Name="TabAllItemsLabel" Text="All Items" TextColor="{StaticResource DashboardTeal}" FontSize="13" FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                </Border>
                                <Border x:Name="TabLowStock" BackgroundColor="Transparent" Padding="16, 8" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTabClicked" CommandParameter="LowStock" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="TabLowStockLabel" Text="Low Stock" TextColor="{StaticResource Slate500}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                </Border>
                                <Border x:Name="TabDigital" BackgroundColor="Transparent" Padding="16, 8" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTabClicked" CommandParameter="Digital" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="TabDigitalLabel" Text="Digital Assets" TextColor="{StaticResource Slate500}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                </Border>
                                <Border x:Name="TabPhysical" BackgroundColor="Transparent" Padding="16, 8" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTabClicked" CommandParameter="Physical" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="TabPhysicalLabel" Text="Physical Goods" TextColor="{StaticResource Slate500}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                </Border>
                            </HorizontalStackLayout>
                            
                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Label Text="Show:" TextColor="{StaticResource Slate500}" FontSize="13" VerticalOptions="Center" />
                                <Border BackgroundColor="{StaticResource Slate100}" Padding="12, 6" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="25 rows" TextColor="{StaticResource Slate700}" FontSize="13" FontAttributes="Bold" />
                                        <Path Data="M7,10l5,5l5-5H7z" Fill="{StaticResource Slate500}" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>
                        
                        <BoxView HeightRequest="1" Color="{StaticResource Slate200}" />

                        <!-- Table Headers -->
                        <Grid ColumnDefinitions="3*, 1.2*, 1.2*, 1.2*, 1.2*, 1.2*, Auto" Padding="24, 16" BackgroundColor="#F8FAFC">
                            <Label Grid.Column="0" Text="ITEM SKU" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="CATEGORY" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" HorizontalOptions="Center" />
                            <Label Grid.Column="2" Text="CURRENT STOCK" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="3" Text="COMMITTED" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="4" Text="REORDER POINT" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="5" Text="STATUS" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="6" Text="ACTIONS" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                        </Grid>
                        
                        <BoxView HeightRequest="1" Color="{StaticResource Slate200}" />

                        <VerticalStackLayout x:Name="InventoryList" BindableLayout.ItemsSource="{Binding .}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="3*, 1.2*, 1.2*, 1.2*, 1.2*, 1.2*, Auto" Padding="24, 20" VerticalOptions="Center">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="16" VerticalOptions="Center">
                                                <Border BackgroundColor="White" HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{StaticResource Slate200}">
                                                    <Path Data="M14,2H6C4.9,2,4,2.9,4,4v16c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V8L14,2z M13,9V3.5L18.5,9H13z M16,15H8v-2h8V15z M12,19H8v-2h4V19z" 
                                                          Fill="{StaticResource Slate300}" Aspect="Uniform" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                                                </Border>
                                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                                    <Label Text="{Binding SKU}" TextColor="{StaticResource Slate900}" FontSize="15" FontAttributes="Bold" />
                                                    <Label Text="{Binding Name}" TextColor="{StaticResource Slate500}" FontSize="11" />
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>
                                            <Border Grid.Column="1" BackgroundColor="{StaticResource Slate200}" Padding="12, 4" StrokeShape="RoundRectangle 12" StrokeThickness="0" HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label Text="{Binding Warehouse}" TextColor="{StaticResource Slate700}" FontSize="11" FontAttributes="Bold" />
                                            </Border>
                                            <Label Grid.Column="2" Text="{Binding Quantity}" TextColor="{StaticResource Slate900}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Label Grid.Column="3" Text="0 Units" TextColor="{StaticResource Slate600}" FontSize="14" VerticalOptions="Center" />
                                            <Label Grid.Column="4" Text="{Binding ReorderPoint}" TextColor="{StaticResource Slate600}" FontSize="14" VerticalOptions="Center" />
                                            <Border Grid.Column="5" Padding="12, 6" StrokeShape="RoundRectangle 4" StrokeThickness="0" HorizontalOptions="Start" VerticalOptions="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BackgroundColor" Value="#ECFDF5" />
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Low Stock">
                                                                <Setter Property="BackgroundColor" Value="#FEE2E2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="{Binding Status}" FontSize="11" FontAttributes="Bold">
                                                        <Label.Style>
                                                            <Style TargetType="Label">
                                                                <Setter Property="TextColor" Value="#059669" />
                                                                <Style.Triggers>
                                                                    <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Low Stock">
                                                                        <Setter Property="TextColor" Value="#DC2626" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Label.Style>
                                                    </Label>
                                                </HorizontalStackLayout>
                                            </Border>
                                            <Path Grid.Column="6" Data="M12,16A2,2 0 0,1 14,18A2,2 0 0,1 12,20A2,2 0 0,1 10,18A2,2 0 0,1 12,16M12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8A2,2 0 0,1 10,6A2,2 0 0,1 12,4Z" 
                                                  Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" HorizontalOptions="Center" VerticalOptions="Center" Margin="12,0,0,0">
                                                <Path.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnRowMenuClicked" CommandParameter="{Binding .}" />
                                                </Path.GestureRecognizers>
                                            </Path>
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="{StaticResource Slate100}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        
                        <BoxView HeightRequest="1" Color="{StaticResource Slate200}" />

                        <!-- Footer Pagination -->
                        <Grid ColumnDefinitions="*, Auto" Padding="24, 16" BackgroundColor="#F8FAFC">
                            <Label x:Name="InventoryCountLabel" Text="Showing 1-25 of 482 items" TextColor="{StaticResource Slate500}" FontSize="13" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <Button Text="&lt;" TextColor="{StaticResource Slate400}" BackgroundColor="White" BorderColor="{StaticResource Slate200}" BorderWidth="1" CornerRadius="6" Padding="12, 6" FontSize="14" />
                                <Button Text="1" TextColor="White" BackgroundColor="{StaticResource DashboardTeal}" BorderColor="{StaticResource DashboardTeal}" BorderWidth="1" CornerRadius="6" Padding="16, 6" FontSize="14" />
                                <Button Text="2" TextColor="{StaticResource Slate700}" BackgroundColor="White" BorderColor="Transparent" BorderWidth="0" CornerRadius="6" Padding="12, 6" FontSize="14" />
                                <Button Text="3" TextColor="{StaticResource Slate700}" BackgroundColor="White" BorderColor="Transparent" BorderWidth="0" CornerRadius="6" Padding="12, 6" FontSize="14" />
                                <Button Text="&gt;" TextColor="{StaticResource Slate700}" BackgroundColor="White" BorderColor="{StaticResource Slate200}" BorderWidth="1" CornerRadius="6" Padding="12, 6" FontSize="14" />
                            </HorizontalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Add/Edit Item Modal -->
        <Grid x:Name="ItemModal" Grid.RowSpan="2" Grid.ColumnSpan="2" BackgroundColor="#80000000" IsVisible="False" Padding="20">
            <Border VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="540" BackgroundColor="White" StrokeShape="RoundRectangle 24" Padding="0" StrokeThickness="0">
                <Border.Shadow><Shadow Brush="Black" Opacity="0.15" Offset="0,12" Radius="40"/></Border.Shadow>
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto, *, Auto" Padding="32, 28, 32, 24">
                        <Border BackgroundColor="#F0FDFA" HeightRequest="52" WidthRequest="52" StrokeShape="RoundRectangle 14" StrokeThickness="0" VerticalOptions="Center">
                            <Path Data="M20,8h-3V4H3C1.9,4,1,4.9,1,6v11h2c0,1.66,1.34,3,3,3s3-1.34,3-3h6c0,1.66,1.34,3,3,3s3-1.34,3-3h2v-5L20,8z" Fill="{StaticResource DashboardTeal}" Aspect="Uniform" HeightRequest="22" WidthRequest="22" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Margin="16,0,0,0" VerticalOptions="Center" Spacing="2">
                            <Label x:Name="ModalTitle" Text="New Inventory Item" TextColor="{StaticResource Slate900}" FontSize="19" FontAttributes="Bold" />
                            <Label Text="Configure stock levels and warehouse location" TextColor="{StaticResource Slate500}" FontSize="12" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" BackgroundColor="{StaticResource Slate100}" HeightRequest="36" WidthRequest="36" StrokeShape="RoundRectangle 18" StrokeThickness="0" VerticalOptions="Center">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCancelClicked" /></Border.GestureRecognizers>
                            <Label Text="&#x2715;" TextColor="{StaticResource Slate500}" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Slate100}" />
                    <VerticalStackLayout Padding="32,28,32,24" Spacing="22">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="ITEM NAME" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" CharacterSpacing="0.5" />
                            <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White" Padding="14,10" HeightRequest="48">
                                <Entry x:Name="ItemNameEntry" Placeholder="e.g. Premium Canvas 24x36" PlaceholderColor="{StaticResource Slate400}" TextColor="{StaticResource Slate900}" FontSize="14" BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="SKU" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" CharacterSpacing="0.5" />
                                <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White" Padding="14,10" HeightRequest="48">
                                    <Entry x:Name="ItemSkuEntry" Placeholder="SKU-XXXX" PlaceholderColor="{StaticResource Slate400}" TextColor="{StaticResource Slate900}" FontSize="14" BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="WAREHOUSE" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" CharacterSpacing="0.5" />
                                <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White" Padding="6,0" HeightRequest="48">
                                    <Picker x:Name="WarehousePicker" Title="Select location" TitleColor="{StaticResource Slate400}" TextColor="{StaticResource Slate900}" FontSize="14" BackgroundColor="Transparent" VerticalOptions="Center" HorizontalOptions="Fill">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>North Hub</x:String>
                                                <x:String>East Wing</x:String>
                                                <x:String>Central Logistics</x:String>
                                                <x:String>Digital Storage</x:String>
                                                <x:String>Main Hub</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0" Spacing="6">
                                <Label Text="QUANTITY" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" CharacterSpacing="0.5" />
                                <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White" Padding="14,10" HeightRequest="48">
                                    <Entry x:Name="ItemQuantityEntry" Keyboard="Numeric" Placeholder="0" PlaceholderColor="{StaticResource Slate400}" TextColor="{StaticResource Slate900}" FontSize="14" BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="REORDER POINT" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" CharacterSpacing="0.5" />
                                <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White" Padding="14,10" HeightRequest="48">
                                    <Entry x:Name="ItemReorderEntry" Keyboard="Numeric" Placeholder="10" PlaceholderColor="{StaticResource Slate400}" TextColor="{StaticResource Slate900}" FontSize="14" BackgroundColor="Transparent" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1" Color="{StaticResource Slate100}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Padding="32,20,32,28">
                        <Button Text="Cancel" Clicked="OnCancelClicked" BackgroundColor="White" TextColor="{StaticResource Slate600}" BorderWidth="1" BorderColor="{StaticResource Slate200}" CornerRadius="10" HeightRequest="46" FontSize="14" />
                        <Button x:Name="SaveItemBtn" Grid.Column="1" Text="Save Item" Clicked="OnSaveItemClicked" BackgroundColor="{StaticResource DashboardTeal}" TextColor="White" CornerRadius="10" HeightRequest="46" FontAttributes="Bold" FontSize="14" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Custom Confirmation Modal -->
        <Grid x:Name="ConfirmationModal" Grid.RowSpan="2" Grid.ColumnSpan="2" IsVisible="False" BackgroundColor="#80000000" Padding="20">
            <Border VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="400" BackgroundColor="White" StrokeShape="RoundRectangle 24" Padding="32" StrokeThickness="0">
                <Border.Shadow><Shadow Brush="Black" Opacity="0.15" Offset="0,10" Radius="30"/></Border.Shadow>
                <VerticalStackLayout Spacing="24" HorizontalOptions="Center">
                    <Border BackgroundColor="#FEF2F2" HeightRequest="80" WidthRequest="80" StrokeShape="RoundRectangle 40" StrokeThickness="0" HorizontalOptions="Center">
                        <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Fill="#EF4444" Aspect="Uniform" HeightRequest="32" WidthRequest="32" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="Remove Item?" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Slate900}" HorizontalOptions="Center" />
                        <Label Text="This will permanently delete this item from the inventory records. Proceed?" FontSize="14" TextColor="{StaticResource Slate500}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16" WidthRequest="340">
                        <Button Text="Cancel" Clicked="OnCancelConfirmClicked" BackgroundColor="Transparent" TextColor="{StaticResource Slate600}" HeightRequest="48" CornerRadius="12" BorderWidth="1" BorderColor="{StaticResource Slate200}" />
                        <Button Grid.Column="1" Text="Delete" Clicked="OnFinalDeleteClicked" BackgroundColor="#EF4444" TextColor="White" FontAttributes="Bold" HeightRequest="48" CornerRadius="12" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>