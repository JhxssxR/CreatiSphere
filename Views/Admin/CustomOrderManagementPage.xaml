<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:admin="clr-namespace:CreatiSphere.Views.Admin"
             x:Class="CreatiSphere.Views.Admin.CustomOrderManagementPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Slate50}">

    <Grid ColumnDefinitions="280, *">
        <!-- Sidebar -->
        <admin:AdminSidebar Grid.Column="0" ActivePage="CustomOrderManagement" />

        <!-- Main Content Area -->
        <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="40" Spacing="32">
                <!-- Top Nav Bar -->
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Custom Order Management" TextColor="{StaticResource Slate900}" FontSize="14" VerticalOptions="Center" />

                    <!-- User Actions -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="24" VerticalOptions="Center">
                        <!-- Search Bar -->
                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{StaticResource Slate100}" WidthRequest="300" Padding="12, 8">
                            <Grid ColumnDefinitions="Auto, *">
                                <Path Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16 c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5 S11.99,14,9.5,14z" 
                                      Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" />
                                <Entry Grid.Column="1" Placeholder="Search orders, artists..." PlaceholderColor="{StaticResource Slate400}" TextColor="{StaticResource Slate900}" BackgroundColor="Transparent" Margin="8,0,0,0" FontSize="12" />
                            </Grid>
                        </Border>

                        <Path Data="M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.1-1.6-5.6-4.5-6.3V4c0-0.8-0.7-1.5-1.5-1.5 S10.5,3.2,10.5,4v0.7C7.6,5.4,6,7.9,6,11v5l-2,2v1h16v-1L18,16z" 
                              Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                        <Path Data="M19.1,12.9l2.1,1.6c0.2,0.1,0.2,0.4,0.1,0.6l-2,3.5c-0.1,0.2-0.4,0.3-0.6,0.2l-2.5-1c-0.5,0.4-1.1,0.7-1.7,1 l-0.4,2.6c0,0.2-0.2,0.4-0.5,0.4h-4c-0.3,0-0.5-0.2-0.5-0.4l-0.4-2.6c-0.6-0.3-1.2-0.6-1.7-1l-2.5,1c-0.2,0.1-0.5,0-0.6-0.2l-2-3.5 C1.9,14.9,2,14.6,2.2,14.5l2.1-1.6c-0.1-0.3-0.1-0.6-0.1-0.9s0-0.6,0.1-0.9L2.2,8.6c-0.2-0.1-0.2-0.4-0.1-0.6l2-3.5c0.1-0.2,0.4-0.3,0.6-0.2 l2.5,1c0.5-0.4,1.1-0.7,1.7-1L9.4,1.7c0-0.2,0.2-0.4,0.5-0.4h4c0.3,0,0.5,0.2,0.5,0.4l0.4,2.6c0.6,0.3,1.2,0.6,1.7,1l2.5-1 c0.2-0.1,0.5,0,0.6,0.2l2,3.5c0.1,0.2,0,0.5-0.2,0.6l-2.1,1.6c0.1,0.3,0.1,0.6,0.1,0.9S19.2,12.6,19.1,12.9z M12,15c1.7,0,3-1.3,3-3 s-1.3-3-3-3s-3,1.3-3,3S10.3,15,12,15z" 
                              Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                        
                        <Border BackgroundColor="#E2E8F0" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                            <Label x:Name="HeaderProfileInitials" Text="U" TextColor="{StaticResource Slate600}" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Stats Cards Row -->
                <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="20">
                    <Border Grid.Column="0" Padding="20" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#F8FAFC" />
                                        <Setter Property="TranslationY" Value="-4" />
                                        <Setter Property="Stroke" Value="{StaticResource DashboardTeal}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="TOTAL VOLUME" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                <Path Data="M11.8,2.1L3,5.1V19l8.8,3l8.8-3V5.1L11.8,2.1z M11,20l-6-2V7.2l6,2V20z M18,18l-6,2V9.2l6-2V18z" Fill="{StaticResource DashboardTeal}" Aspect="Uniform" HeightRequest="14" WidthRequest="14" Grid.Column="1" />
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label x:Name="TotalVolumeLabel" Text="$42,850" TextColor="{StaticResource Slate900}" FontSize="28" FontAttributes="Bold" />
                                <HorizontalStackLayout Spacing="4">
                                    <Path Data="M7,14l5-5l5,5" Fill="{StaticResource SuccessGreen}" Aspect="Uniform" HeightRequest="10" WidthRequest="10" VerticalOptions="Center" />
                                    <Label Text="+12.5% vs last month" TextColor="{StaticResource SuccessGreen}" FontSize="11" FontAttributes="Bold" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Padding="20" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#F8FAFC" />
                                        <Setter Property="TranslationY" Value="-4" />
                                        <Setter Property="Stroke" Value="{StaticResource DashboardTeal}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="ACTIVE BRIEFS" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                <Path Data="M14,2H6C4.9,2,4.01,2.9,4.01,4L4,20c0,1.1,0.89,2,1.99,2H18c1.1,0,2-0.9,2-2V8L14,2z M18,20H6V4h7v5h5V20z" Fill="{StaticResource DashboardTeal}" Aspect="Uniform" HeightRequest="14" WidthRequest="14" Grid.Column="1" />
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="24" TextColor="{StaticResource Slate900}" FontSize="28" FontAttributes="Bold" />
                                <Label Text="8 pending review" TextColor="{StaticResource Slate400}" FontSize="11" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="2" Padding="20" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#F8FAFC" />
                                        <Setter Property="TranslationY" Value="-4" />
                                        <Setter Property="Stroke" Value="{StaticResource DashboardTeal}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="ARTIST CAPACITY" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                <Path Data="M3,17.25V21h3.75L17.81,9.94l-3.75-3.75L3,17.25z M20.71,7.04c0.39-0.39,0.39-1.02,0-1.41l-2.34-2.34 c-0.39-0.39-1.02-0.39-1.41,0l-1.83,1.83l3.75,3.75L20.71,7.04z" Fill="{StaticResource DashboardTeal}" Aspect="Uniform" HeightRequest="14" WidthRequest="14" Grid.Column="1" />
                            </Grid>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="88%" TextColor="{StaticResource Slate900}" FontSize="28" FontAttributes="Bold" />
                                <Border BackgroundColor="#E2E8F0" HeightRequest="4" StrokeShape="RoundRectangle 2" StrokeThickness="0">
                                    <BoxView Color="{StaticResource DashboardTeal}" WidthRequest="200" HorizontalOptions="Start" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="3" Padding="20" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#F8FAFC" />
                                        <Setter Property="TranslationY" Value="-4" />
                                        <Setter Property="Stroke" Value="{StaticResource DashboardTeal}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="AVG. FULFILLMENT" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                <Path Data="M11.99,2C6.47,2,2,6.48,2,12s4.47,10,9.99,10C17.52,22,22,17.52,22,12S17.52,2,11.99,2z M12,20c-4.42,0-8-3.58-8-8 s3.58-8,8-8s8,3.58,8,8S16.42,20,12,20z M12.5,7H11v6l5.25,3.15l0.75-1.23L12.5,12.5V7z" Fill="{StaticResource DashboardTeal}" Aspect="Uniform" HeightRequest="14" WidthRequest="14" Grid.Column="1" />
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="6.4 Days" TextColor="{StaticResource Slate900}" FontSize="28" FontAttributes="Bold" />
                                <Label Text="-0.5 days since last week" TextColor="{StaticResource SuccessGreen}" FontSize="11" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Kanban Board Section -->
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="24">
                    <!-- New Requests -->
                    <VerticalStackLayout Grid.Column="0" Spacing="16">
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Ellipse WidthRequest="8" HeightRequest="8" Fill="#3B82F6" VerticalOptions="Center" />
                            <Label Text="New Requests" TextColor="{StaticResource Slate900}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                            <Border BackgroundColor="#E0E7FF" Padding="8, 2" StrokeShape="RoundRectangle 12" StrokeThickness="0" VerticalOptions="Center">
                                <Label x:Name="NewRequestsCountLabel" Text="0" TextColor="#3B82F6" FontSize="11" FontAttributes="Bold" />
                            </Border>
                        </HorizontalStackLayout>

                        <VerticalStackLayout x:Name="NewOrdersList" BindableLayout.ItemsSource="{Binding .}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White" Margin="0,0,0,12">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal" />
                                                <VisualState Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="#F8FAFC" />
                                                        <Setter Property="Stroke" Value="{StaticResource DashboardTeal}" />
                                                        <Setter Property="TranslationX" Value="4" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnOrderSelected" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="12">
                                            <Grid ColumnDefinitions="Auto, *">
                                                <Border BackgroundColor="#EFF6FF" Padding="8, 2" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                                                    <Label Text="{Binding Priority}" TextColor="#3B82F6" FontSize="9" FontAttributes="Bold" />
                                                </Border>
                                                <Label Grid.Column="1" Text="{Binding OrderID, StringFormat='#{0}'}" TextColor="{StaticResource Slate400}" FontSize="10" HorizontalOptions="End" />
                                            </Grid>
                                            <Label Text="{Binding Title}" TextColor="{StaticResource Slate900}" FontSize="14" FontAttributes="Bold" />
                                            <Label Text="{Binding Description}" TextColor="{StaticResource Slate500}" FontSize="12" LineBreakMode="WordWrap" MaxLines="2" />
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                    <Path Data="M19,3h-1V1h-2v2H8V1H6v2H5C3.89,3,3,3.9,3,5v14c0,1.1,0.89,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.11,3,19,3z M19,19H5V8h14V19z" Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" />
                                                    <Label Text="{Binding Date}" TextColor="{StaticResource Slate400}" FontSize="11" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                                <Border Grid.Column="2" HeightRequest="24" WidthRequest="24" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                                    <Image Source="avatar.png" Aspect="AspectFill" />
                                                </Border>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- In Progress -->
                    <VerticalStackLayout Grid.Column="1" Spacing="16">
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Ellipse WidthRequest="8" HeightRequest="8" Fill="{StaticResource DashboardTeal}" VerticalOptions="Center" />
                            <Label Text="In Progress" TextColor="{StaticResource Slate900}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                            <Border BackgroundColor="#CCFBF1" Padding="8, 2" StrokeShape="RoundRectangle 12" StrokeThickness="0" VerticalOptions="Center">
                                <Label x:Name="InProgressCountLabel" Text="0" TextColor="{StaticResource DashboardTeal}" FontSize="11" FontAttributes="Bold" />
                            </Border>
                        </HorizontalStackLayout>

                        <!-- In Progress List -->
                        <VerticalStackLayout x:Name="InProgressOrdersList" BindableLayout.ItemsSource="{Binding .}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White" Margin="0,0,0,12">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal" />
                                                <VisualState Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="#F8FAFC" />
                                                        <Setter Property="Stroke" Value="{StaticResource DashboardTeal}" />
                                                        <Setter Property="TranslationX" Value="4" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnOrderSelected" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="12">
                                            <Grid ColumnDefinitions="Auto, *">
                                                <Border BackgroundColor="#ECFDF5" Padding="8, 2" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                                                    <Label Text="SKETCHING" TextColor="#10B981" FontSize="9" FontAttributes="Bold" />
                                                </Border>
                                                <Label Grid.Column="1" Text="{Binding OrderID, StringFormat='#{0}'}" TextColor="{StaticResource Slate400}" FontSize="10" HorizontalOptions="End" />
                                            </Grid>
                                            <Label Text="{Binding Title}" TextColor="{StaticResource Slate900}" FontSize="14" FontAttributes="Bold" />
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                    <Border HeightRequest="20" WidthRequest="20" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                                                        <Image Source="artist1.png" Aspect="AspectFill" />
                                                    </Border>
                                                    <Label Text="Elena S." TextColor="{StaticResource Slate500}" FontSize="11" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                                <Label Grid.Column="2" Text="60%" TextColor="{StaticResource DashboardTeal}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Review -->
                    <VerticalStackLayout Grid.Column="2" Spacing="16">
                        <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                            <Ellipse WidthRequest="8" HeightRequest="8" Fill="#F59E0B" VerticalOptions="Center" />
                            <Label Text="Review" TextColor="{StaticResource Slate900}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                            <Border BackgroundColor="#FEF3C7" Padding="8, 2" StrokeShape="RoundRectangle 12" StrokeThickness="0" VerticalOptions="Center">
                                <Label x:Name="ReviewCountLabel" Text="0" TextColor="#F59E0B" FontSize="11" FontAttributes="Bold" />
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Review List -->
                        <VerticalStackLayout x:Name="ReviewOrdersList" BindableLayout.ItemsSource="{Binding .}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White" Margin="0,0,0,12">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal" />
                                                <VisualState Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="#F8FAFC" />
                                                        <Setter Property="Stroke" Value="{StaticResource DashboardTeal}" />
                                                        <Setter Property="TranslationX" Value="4" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnOrderSelected" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="12">
                                            <Grid ColumnDefinitions="Auto, *">
                                                <Border BackgroundColor="#FFF7ED" Padding="8, 2" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                                                    <Label Text="FEEDBACK" TextColor="#F97316" FontSize="9" FontAttributes="Bold" />
                                                </Border>
                                                <Label Grid.Column="1" Text="{Binding OrderID, StringFormat='#{0}'}" TextColor="{StaticResource Slate400}" FontSize="10" HorizontalOptions="End" />
                                            </Grid>
                                            <Label Text="{Binding Title}" TextColor="{StaticResource Slate900}" FontSize="14" FontAttributes="Bold" />
                                            <Border BackgroundColor="#F8FAFC" Padding="12" StrokeShape="RoundRectangle 4" StrokeThickness="0">
                                                <Label Text="&quot;Client awaiting review...&quot;" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Italic" />
                                            </Border>
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <Label Text="VIEW DRAFT" TextColor="{StaticResource DashboardTeal}" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                                                <Label Grid.Column="2" Text="Marcus K." TextColor="{StaticResource Slate500}" FontSize="11" VerticalOptions="Center" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <!-- Detailed View Area -->
                <Border Padding="0" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White">
                    <Grid ColumnDefinitions="*, 300">
                        <!-- Left Details -->
                        <VerticalStackLayout Grid.Column="0" Padding="32" Spacing="32">
                            <HorizontalStackLayout Spacing="16">
                                <Border BackgroundColor="#CCFBF1" Padding="12, 4" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                    <Label Text="CURRENTLY VIEWING" TextColor="{StaticResource DashboardTeal}" FontSize="10" FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="12">
                                <Label x:Name="DetailTitleLabel" Text="Cyberpunk Landscape" TextColor="{StaticResource Slate900}" FontSize="32" FontAttributes="Bold" />
                                <Label x:Name="DetailIdLabel" Text="#CO-8821" TextColor="{StaticResource Slate400}" FontSize="32" VerticalOptions="End" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="24">
                                <HorizontalStackLayout Spacing="8">
                                    <Path Data="M11.99,2C6.47,2,2,6.48,2,12s4.47,10,9.99,10C17.52,22,22,17.52,22,12S17.52,2,11.99,2z M12,20c-4.42,0-8-3.58-8-8 s3.58-8,8-8s8,3.58,8,8S16.42,20,12,20z M12.5,7H11v6l5.25,3.15l0.75-1.23L12.5,12.5V7z" Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                                    <Label x:Name="DetailPriorityLabel" Text="Priority: High (Expedited)" TextColor="{StaticResource Slate600}" FontSize="13" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <Path Data="M20,6h-4V4c0-1.11-.89-2-2-2h-4c-1.11,0-2,.89-2,2v2H4c-1.11,0-1.99.89-1.99,2L2,19c0,1.11.89,2,2,2h16c1.11,0,2-.89,2-2V8c0-1.11-.89-2-2-2zm-6,0h-4V4h4v2z" Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                                    <Label x:Name="DetailCategoryLabel" Text="Digital Mural Asset Pack" TextColor="{StaticResource Slate600}" FontSize="13" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>

                            <VerticalStackLayout Spacing="32">
                                <VerticalStackLayout Spacing="16">
                                    <Label Text="CLIENT BRIEF" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" />
                                    <Border BackgroundColor="#F8FAFC" Padding="24" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                        <Label x:Name="DetailBriefLabel" Text="Create an ultra-wide panoramic digital painting of a futuristic metropolis. Focus on verticality and dense atmospheric haze." 
                                               TextColor="{StaticResource Slate600}" FontSize="14" LineBreakMode="WordWrap" LineHeight="1.5" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="16">
                                    <Label Text="TECHNICAL SPECS" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" />
                                    <VerticalStackLayout Spacing="1">
                                        <Grid ColumnDefinitions="*, *" Padding="0, 12">
                                            <Label Text="Resolution" TextColor="{StaticResource Slate500}" FontSize="13" />
                                            <Label x:Name="DetailResolutionLabel" Grid.Column="1" Text="7680 × 2160 (8K)" TextColor="{StaticResource Slate900}" FontSize="13" FontAttributes="Bold" HorizontalOptions="End" />
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="{StaticResource Slate100}" />
                                        <Grid ColumnDefinitions="*, *" Padding="0, 12">
                                            <Label Text="Color Profile" TextColor="{StaticResource Slate500}" FontSize="13" />
                                            <Label x:Name="DetailColorProfileLabel" Grid.Column="1" Text="Adobe RGB (1998)" TextColor="{StaticResource Slate900}" FontSize="13" FontAttributes="Bold" HorizontalOptions="End" />
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="{StaticResource Slate100}" />
                                        <Grid ColumnDefinitions="*, *" Padding="0, 12">
                                            <Label Text="Deliverables" TextColor="{StaticResource Slate500}" FontSize="13" />
                                            <Label x:Name="DetailDeliverablesLabel" Grid.Column="1" Text="PSD, TIFF, 4K Proxy" TextColor="{StaticResource Slate900}" FontSize="13" FontAttributes="Bold" HorizontalOptions="End" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <HorizontalStackLayout Spacing="16" Margin="0,16,0,0">
                                <Button Text="Update Order Status" 
                                        Clicked="OnUpdateStatusClicked"
                                        TextColor="White" 
                                        BackgroundColor="#065F46"
                                        CornerRadius="8"
                                        Padding="24, 12"
                                        FontAttributes="Bold" />
                                <Button Text="Contact Client" 
                                        TextColor="{StaticResource Slate900}" 
                                        BackgroundColor="White"
                                        BorderColor="{StaticResource Slate200}"
                                        BorderWidth="1"
                                        CornerRadius="8"
                                        Padding="24, 12" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Right Sidebar (Execution Path) -->
                        <Border Grid.Column="1" BackgroundColor="#F8FAFC" StrokeThickness="0" StrokeShape="RoundRectangle 0" Padding="24">
                            <VerticalStackLayout Spacing="32">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="Execution Path" TextColor="{StaticResource Slate900}" FontSize="18" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="⋮" TextColor="{StaticResource Slate400}" FontSize="20" VerticalOptions="Center" />
                                </Grid>

                                <VerticalStackLayout Spacing="12">
                                    <Label Text="ASSIGNED ARTIST" TextColor="{StaticResource Slate400}" FontSize="10" FontAttributes="Bold" />
                                    <Border BackgroundColor="White" Padding="12" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{StaticResource Slate200}">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <Border HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                                <Image Source="artist2.png" Aspect="AspectFill" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Margin="12,0" Spacing="2">
                                                <Label x:Name="DetailArtistNameLabel" Text="Unassigned" TextColor="{StaticResource Slate900}" FontSize="14" FontAttributes="Bold" />
                                                <Label Text="Elite Concept Artist" TextColor="{StaticResource DashboardTeal}" FontSize="11" FontAttributes="Bold" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="16">
                                    <Label Text="ORDER TIMELINE" TextColor="{StaticResource Slate400}" FontSize="10" FontAttributes="Bold" />
                                    
                                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto" RowSpacing="24">
                                        <!-- Step 1 -->
                                        <VerticalStackLayout Grid.Column="0" Grid.Row="0" Spacing="0" HorizontalOptions="Center">
                                            <Border BackgroundColor="{StaticResource DashboardTeal}" HeightRequest="20" WidthRequest="20" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                                                <Label Text="✓" TextColor="White" FontSize="10" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <BoxView WidthRequest="2" Color="{StaticResource DashboardTeal}" HeightRequest="24" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Grid.Row="0" Margin="12,0">
                                            <Label Text="Concept Approval" TextColor="{StaticResource Slate900}" FontSize="13" FontAttributes="Bold" />
                                            <Label Text="Oct 18, 2026 • Completed" TextColor="{StaticResource Slate400}" FontSize="11" />
                                        </VerticalStackLayout>

                                        <!-- Step 2 -->
                                        <VerticalStackLayout Grid.Column="0" Grid.Row="1" Spacing="0" HorizontalOptions="Center">
                                            <Border BackgroundColor="White" Stroke="{StaticResource DashboardTeal}" StrokeThickness="2" HeightRequest="20" WidthRequest="20" StrokeShape="RoundRectangle 10">
                                                <Ellipse Fill="{StaticResource DashboardTeal}" WidthRequest="8" HeightRequest="8" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <BoxView WidthRequest="2" Color="{StaticResource Slate200}" HeightRequest="24" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Grid.Row="1" Margin="12,0">
                                            <Label Text="Final Render Submission" TextColor="{StaticResource Slate900}" FontSize="13" FontAttributes="Bold" />
                                            <Label Text="Oct 24, 2026 • Current Task" TextColor="{StaticResource DashboardTeal}" FontSize="11" FontAttributes="Bold" />
                                        </VerticalStackLayout>

                                        <!-- Step 3 -->
                                        <VerticalStackLayout Grid.Column="0" Grid.Row="2" Spacing="0" HorizontalOptions="Center">
                                            <Border BackgroundColor="{StaticResource Slate200}" HeightRequest="20" WidthRequest="20" StrokeShape="RoundRectangle 10" StrokeThickness="0" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Grid.Row="2" Margin="12,0">
                                            <Label Text="Client Handover" TextColor="{StaticResource Slate400}" FontSize="13" />
                                            <Label Text="Oct 26, 2026 • Upcoming" TextColor="{StaticResource Slate400}" FontSize="11" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>

                                <Border BackgroundColor="#FEF2F2" Padding="16" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                    <VerticalStackLayout Spacing="8">
                                        <HorizontalStackLayout Spacing="8">
                                            <Path Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M13,17h-2v-2h2V17z M13,13h-2V7h2V13z" Fill="#EF4444" Aspect="Uniform" HeightRequest="14" WidthRequest="14" VerticalOptions="Center" />
                                            <Label Text="ACTION REQUIRED" TextColor="#EF4444" FontSize="10" FontAttributes="Bold" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="Client requested a progress update by EOD today. Victor Chen has not logged activity for 14 hours." TextColor="#991B1B" FontSize="11" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Status Update Modal Overlay -->
        <Grid x:Name="StatusModal" Grid.ColumnSpan="2" IsVisible="False" BackgroundColor="#80000000">
            <Border VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="400" Padding="32" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                <VerticalStackLayout Spacing="24">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Update Order Status" TextColor="{StaticResource Slate900}" FontSize="20" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="✕" TextColor="{StaticResource Slate400}" FontSize="20" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseModalClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Select new status for this order:" TextColor="{StaticResource Slate600}" FontSize="14" />
                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{StaticResource Slate200}" Padding="12">
                            <Picker x:Name="StatusPicker" Title="Choose Status" TitleColor="{StaticResource Slate400}" TextColor="{StaticResource Slate900}">
                                <Picker.Items>
                                    <x:String>New Request</x:String>
                                    <x:String>Sketching</x:String>
                                    <x:String>In Progress</x:String>
                                    <x:String>Review</x:String>
                                    <x:String>Completed</x:String>
                                </Picker.Items>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <HorizontalStackLayout Spacing="12" HorizontalOptions="End">
                        <Button Text="Cancel" Clicked="OnCloseModalClicked" TextColor="{StaticResource Slate600}" BackgroundColor="White" BorderColor="{StaticResource Slate200}" BorderWidth="1" CornerRadius="8" Padding="20, 10" />
                        <Button Text="Update Status" Clicked="OnConfirmStatusUpdate" TextColor="White" BackgroundColor="{StaticResource DashboardTeal}" CornerRadius="8" Padding="20, 10" FontAttributes="Bold" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
        <!-- Selection Required Modal Overlay -->
        <Grid x:Name="SelectionModal" Grid.ColumnSpan="2" IsVisible="False" BackgroundColor="#80000000">
            <Border VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="400" Padding="32" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="White">
                <VerticalStackLayout Spacing="24">
                    <Label Text="Selection Required" TextColor="{StaticResource Slate900}" FontSize="20" FontAttributes="Bold" />
                    <Label Text="Please select an order from the list first." TextColor="{StaticResource Slate600}" FontSize="14" />
                    <Button Text="OK" Clicked="OnCloseSelectionModalClicked" TextColor="{StaticResource Slate700}" BackgroundColor="White" BorderColor="{StaticResource Slate200}" BorderWidth="1" CornerRadius="8" Padding="20, 10" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
