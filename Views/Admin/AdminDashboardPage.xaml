                                        <Label Text="MOTION" TextColor="{StaticResource Slate400}" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" />
                                        <Label Text="1,490" TextColor="{StaticResource Slate900}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
        
        <!-- SUBSCRIPTION PAYMENT MODAL OVERLAY -->
        <ContentView x:Name="SubscriptionPaymentModal" IsVisible="False" Grid.ColumnSpan="2" BackgroundColor="#B30F172A">
            <Border HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="900" BackgroundColor="White" StrokeShape="RoundRectangle 16" StrokeThickness="0" Padding="0">
                <Grid RowDefinitions="Auto, Auto">
                    <!-- Modal Header -->
                    <Grid Padding="32,24" BackgroundColor="#F8FAFC">
                        <Label x:Name="PaymentModalTitle" Text="Secure Your Subscription" TextColor="#0F172A" FontSize="24" FontAttributes="Bold" />
                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" Fill="#64748B" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="End" VerticalOptions="Center">
