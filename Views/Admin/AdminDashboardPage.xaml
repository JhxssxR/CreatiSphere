                                        <Label Text="Credit Card" TextColor="#0D9488" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                                <!-- Digital Wallet Tab -->
                                <Border x:Name="DigitalWalletTabPayment" Grid.Column="1" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="20,18">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnDigitalWalletTabTapped" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Path Data="M21,7.28V5C21,3.9,20.1,3,19,3H5C3.9,3,3,3.9,3,5V19C3,20.1,3.9,21,5,21H19C20.1,21,21,20.1,21,19V12.72C21.59,12.38,22,11.74,22,11C22,10.26,21.59,9.62,21,9.28V7.28ZM20,9V13H14V9H20ZM5,19V5H19V7H13C11.9,7,11,7.9,11,9V13C11,14.1,11.9,15,13,15H19V19H5Z" Fill="#64748B" Aspect="Uniform" HeightRequest="28" WidthRequest="28" HorizontalOptions="Center" />
                                        <Label Text="Digital Wallet" TextColor="#64748B" FontSize="15" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Credit Card Panel -->
                            <VerticalStackLayout x:Name="CreditCardPanel" Spacing="20">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Cardholder Name" TextColor="#475569" FontSize="14" FontAttributes="Bold" />
                                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#CBD5E1" Padding="16,0" HeightRequest="52">
                                        <Entry Placeholder="e.g. Alex Morgan" PlaceholderColor="#94A3B8" TextColor="#0F172A" FontSize="15" />
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Card Number" TextColor="#475569" FontSize="14" FontAttributes="Bold" />
                                    <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#CBD5E1" Padding="16,0" HeightRequest="52">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Entry Placeholder="XXXX XXXX XXXX XXXX" PlaceholderColor="#94A3B8" TextColor="#0F172A" FontSize="15" Keyboard="Numeric" />
                                            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                                <Border BackgroundColor="#1A1F71" StrokeShape="RoundRectangle 4" Padding="6,3" StrokeThickness="0">
                                                    <Label Text="VISA" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                                </Border>
                                                <Border BackgroundColor="#EB001B" StrokeShape="RoundRectangle 4" Padding="4,3" StrokeThickness="0">
                                                    <Label Text="MC" TextColor="White" FontSize="10" FontAttributes="Bold" />
                                                </Border>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Expiry Date" TextColor="#475569" FontSize="14" FontAttributes="Bold" />
                                        <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#CBD5E1" Padding="16,0" HeightRequest="52">
                                            <Entry Placeholder="MM / YY" PlaceholderColor="#94A3B8" TextColor="#0F172A" FontSize="15" Keyboard="Numeric" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                                        <Label Text="CVV" TextColor="#475569" FontSize="14" FontAttributes="Bold" />
                                        <Border StrokeShape="RoundRectangle 10" StrokeThickness="1" Stroke="#CBD5E1" Padding="16,0" HeightRequest="52">
                                            <Entry Placeholder="• • •" PlaceholderColor="#94A3B8" TextColor="#0F172A" FontSize="15" Keyboard="Numeric" IsPassword="True" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Digital Wallet Panel -->
                            <VerticalStackLayout x:Name="DigitalWalletPanel" IsVisible="False" Spacing="16">
                                <Label Text="Select your e-wallet provider" TextColor="#64748B" FontSize="14" />
                                <!-- GCash -->
                                <Border x:Name="GCashOption" StrokeShape="RoundRectangle 12" StrokeThickness="2" Stroke="#0D9488" BackgroundColor="#F0FDFA" Padding="20,16">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnGCashSelected" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Border HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="#007AFF">
                                            <Label Text="G" TextColor="White" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Padding="16,0" VerticalOptions="Center" Spacing="2">
                                            <Label Text="GCash" TextColor="#0F172A" FontSize="17" FontAttributes="Bold" />
                                            <Label Text="Linked: 09XX XXX 1234" TextColor="#64748B" FontSize="13" />
                                        </VerticalStackLayout>
                                        <Path x:Name="GCashCheck" Grid.Column="2" Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M10,17l-5-5l1.41-1.41L10,14.17l7.59-7.59L19,8L10,17z" Fill="#0D9488" Aspect="Uniform" HeightRequest="22" WidthRequest="22" VerticalOptions="Center" />
                                        <Ellipse x:Name="GCashUncheck" Grid.Column="2" IsVisible="False" WidthRequest="22" HeightRequest="22" Stroke="#CBD5E1" StrokeThickness="1" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                                <!-- PayMaya -->
                                <Border x:Name="PayMayaOption" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="20,16">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPayMayaSelected" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Border HeightRequest="48" WidthRequest="48" StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="#0A7A55">
                                            <Label Text="M" TextColor="White" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Padding="16,0" VerticalOptions="Center" Spacing="2">
                                            <Label Text="Maya (PayMaya)" TextColor="#0F172A" FontSize="17" FontAttributes="Bold" />
                                            <Label Text="Linked: 09XX XXX 5678" TextColor="#64748B" FontSize="13" />
                                        </VerticalStackLayout>
                                        <Path x:Name="PayMayaCheck" Grid.Column="2" IsVisible="False" Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M10,17l-5-5l1.41-1.41L10,14.17l7.59-7.59L19,8L10,17z" Fill="#0D9488" Aspect="Uniform" HeightRequest="22" WidthRequest="22" VerticalOptions="Center" />
                                        <Ellipse x:Name="PayMayaUncheck" Grid.Column="2" WidthRequest="22" HeightRequest="22" Stroke="#CBD5E1" StrokeThickness="1" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- RIGHT: Order Summary -->
                        <VerticalStackLayout Grid.Column="1" Spacing="16">
                            <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="#F8FAFC" Padding="24">
                                <VerticalStackLayout Spacing="20">
                                    <Label Text="Subscription Summary" TextColor="#0F172A" FontSize="17" FontAttributes="Bold" />

                                    <VerticalStackLayout Spacing="12">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label x:Name="SummaryPlanNameLabel" Text="Standard Plan" TextColor="#475569" FontSize="14" />
                                            <Label x:Name="SummaryPlanPriceLabel" Grid.Column="1" Text="$99.00 / mo" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Text="Taxes (Estimated)" TextColor="#475569" FontSize="14" />
                                            <Label Grid.Column="1" Text="$0.00" TextColor="#94A3B8" FontSize="14" />
                                        </Grid>
                                    </VerticalStackLayout>

                                    <BoxView HeightRequest="1" Color="#E2E8F0" />

                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="Total Due Today" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" />
                                        <Label x:Name="SummaryTotalLabel" Grid.Column="1" Text="$99.00" TextColor="#0F172A" FontSize="18" FontAttributes="Bold" />
                                    </Grid>

                                    <Button x:Name="ConfirmPaymentButton" Text="Confirm Payment" BackgroundColor="#0D9488" TextColor="White" CornerRadius="10" Padding="0,18" FontAttributes="Bold" FontSize="15" Clicked="OnConfirmPaymentClicked" />

                                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,8,0,0">
                                        <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                                            <Path Data="M18,8H17V6C17,3.24,14.76,1,12,1C9.24,1,7,3.24,7,6V8H6C4.9,8,4,8.9,4,10V20C4,21.1,4.9,22,6,22H18C19.1,22,20,21.1,20,20V10C20,8.9,19.1,8,18,8ZM12,17C10.9,17,10,16.1,10,15C10,13.9,10.9,13,12,13C13.1,13,14,13.9,14,15C14,16.1,13.1,17,12,17ZM15.1,8H8.9V6C8.9,4.29,10.29,2.9,12,2.9C13.71,2.9,15.1,4.29,15.1,6V8Z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="13" WidthRequest="13" VerticalOptions="Center" />
                                            <Label Text="Secure Encrypted Payment" TextColor="#94A3B8" FontSize="11" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Border>
        </ContentView>
    </Grid>

</ContentPage>
