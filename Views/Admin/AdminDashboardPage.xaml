<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:admin="clr-namespace:CreatiSphere.Views.Admin"
             x:Class="CreatiSphere.Views.Admin.AdminDashboardPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Slate50}">

    <ContentPage.Resources>
        <Style x:Key="StatCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Stroke" Value="{StaticResource Slate200}" />
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1" />
                                <Setter Property="BackgroundColor" Value="White" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1.02" />
                                <Setter Property="BackgroundColor" Value="#F8FAFC" />
                                <Setter Property="Stroke" Value="{StaticResource DashboardTeal}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="ChartBarStyle" TargetType="BoxView">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalOptions" Value="End" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="0.8" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Scale" Value="1.1" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="SalesRowStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource Slate50}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>


    <Grid ColumnDefinitions="280, *">
        <!-- Sidebar -->
        <admin:AdminSidebar Grid.Column="0" ActivePage="Dashboard" />

        <!-- Main Content Area -->
        <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="40" Spacing="32">
                
                <!-- Top Nav Bar -->
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="System Overview Dashboard" TextColor="{StaticResource Slate900}" FontSize="14" VerticalOptions="Center" />

                    <!-- User Actions -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="24" VerticalOptions="Center">
                        <!-- Search Bar -->
                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{StaticResource Slate100}" WidthRequest="300" Padding="12, 8">
                            <Grid ColumnDefinitions="Auto, *">
                                <Path Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16 c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5 S11.99,14,9.5,14z" 
                                      Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" />
                                <Entry Grid.Column="1" Placeholder="Search creatives, assets..." PlaceholderColor="{StaticResource Slate400}" TextColor="{StaticResource Slate900}" BackgroundColor="Transparent" Margin="8,0,0,0" FontSize="12" />
                            </Grid>
                        </Border>

                        <Path Data="M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.1-1.6-5.6-4.5-6.3V4c0-0.8-0.7-1.5-1.5-1.5 S10.5,3.2,10.5,4v0.7C7.6,5.4,6,7.9,6,11v5l-2,2v1h16v-1L18,16z" 
                              Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                        <Path Data="M19.1,12.9l2.1,1.6c0.2,0.1,0.2,0.4,0.1,0.6l-2,3.5c-0.1,0.2-0.4,0.3-0.6,0.2l-2.5-1c-0.5,0.4-1.1,0.7-1.7,1 l-0.4,2.6c0,0.2-0.2,0.4-0.5,0.4h-4c-0.3,0-0.5-0.2-0.5-0.4l-0.4-2.6c-0.6-0.3-1.2-0.6-1.7-1l-2.5,1c-0.2,0.1-0.5,0-0.6-0.2l-2-3.5 C1.9,14.9,2,14.6,2.2,14.5l2.1-1.6c-0.1-0.3-0.1-0.6-0.1-0.9s0-0.6,0.1-0.9L2.2,8.6c-0.2-0.1-0.2-0.4-0.1-0.6l2-3.5c0.1-0.2,0.4-0.3,0.6-0.2 l2.5,1c0.5-0.4,1.1-0.7,1.7-1L9.4,1.7c0-0.2,0.2-0.4,0.5-0.4h4c0.3,0,0.5,0.2,0.5,0.4l0.4,2.6c0.6,0.3,1.2,0.6,1.7,1l2.5-1 c0.2-0.1,0.5,0,0.6,0.2l2,3.5c0.1,0.2,0,0.5-0.2,0.6l-2.1,1.6c0.1,0.3,0.1,0.6,0.1,0.9S19.2,12.6,19.1,12.9z M12,15c1.7,0,3-1.3,3-3 s-1.3-3-3-3s-3,1.3-3,3S10.3,15,12,15z" 
                              Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                        
                        <Border HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                            <Image Source="avatar.png" Aspect="AspectFill" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Stats Cards Row -->
                <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="20">
                    <!-- Active MSMEs -->
                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="ACTIVE MSMES" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                <Border Grid.Column="1" BackgroundColor="#ECFDF5" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                    <Path Data="M20,4H4v2h16V4z M22,13v2v5c0,1.1-0.9,2-2,2H4c-1.1,0-2-0.9-2-2v-5v-2c0-0.6,0.1-1.2,0.4-1.8l2.3-5.7C5,7.7,5.9,7,7,7h10 c1.1,0,2-0.7,2.3,1.5l2.3,5.7C21.9,11.8,22,12.4,22,13z M19,13H5l-1.6,4h17.2L19,13z" 
                                          Fill="#10B981" Aspect="Uniform" HeightRequest="14" WidthRequest="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label x:Name="ActiveCreatorsLabel" Text="1,284" TextColor="{StaticResource Slate900}" FontSize="28" FontAttributes="Bold" />
                                <VerticalStackLayout Spacing="6">
                                    <HorizontalStackLayout Spacing="4">
                                        <Label x:Name="TierLimitLabel" Text="Starter (Limit: 5)" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                                        <Label Text="•" TextColor="{StaticResource Slate300}" FontSize="11" />
                                        <Label x:Name="CapacityPercentLabel" Text="20%" TextColor="{StaticResource DashboardTeal}" FontSize="11" FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                    <ProgressBar x:Name="CapacityProgress" Progress="0.2" ProgressColor="{StaticResource DashboardTeal}" HeightRequest="4" BackgroundColor="{StaticResource Slate100}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Active Custom Orders -->
                    <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="ACTIVE CUSTOM ORDERS" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                <Border Grid.Column="1" BackgroundColor="#EFF6FF" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                    <Path Data="M7,18c-1.1,0-1.99.9-1.99,2S5.9,22,7,22s2-.9,2-2-.9-2-2-2zM1,2v2h2l3.6,7.59-1.35,2.45c-.16.28-.25.61-.25.96,0,1.1.9,2,2,2h12v-2H7.42c-.14,0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75,0,1.41-.41,1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48,0-.55-.45-1-1-1H5.21l-.94-2H1zm16,16c-1.1,0-1.99.9-1.99,2s.89,2,1.99,2,2-.9,2-2-.9-2-2-2z" 
                                          Fill="#3B82F6" Aspect="Uniform" HeightRequest="14" WidthRequest="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label x:Name="ActiveOrdersLabel" Text="342" TextColor="{StaticResource Slate900}" FontSize="28" FontAttributes="Bold" />
                                <Label Text="48 pending approval" TextColor="{StaticResource Slate400}" FontSize="11" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Digital Assets -->
                    <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="DIGITAL ASSETS" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                <Border Grid.Column="1" BackgroundColor="#FAF5FF" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                    <Path Data="M19.35,10.04C18.67,6.59,15.64,4,12,4C9.11,4,6.6,5.64,5.35,8.04C2.34,8.36,0,10.91,0,14c0,3.31,2.69,6,6,6h13c2.76,0,5-2.24,5-5C24,12.36,21.95,10.22,19.35,10.04z" 
                                          Fill="#A855F7" Aspect="Uniform" HeightRequest="14" WidthRequest="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label x:Name="DigitalAssetsLabel" Text="8,421" TextColor="{StaticResource Slate900}" FontSize="28" FontAttributes="Bold" />
                                <Label Text="2.4 TB storage used" TextColor="#A855F7" FontSize="11" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Total CRM Leads -->
                    <Border Grid.Column="3" Style="{StaticResource StatCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="TOTAL CRM LEADS" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" VerticalOptions="Center" />
                                <Border Grid.Column="1" BackgroundColor="#FFF7ED" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                                    <Path Data="M16,11c1.66,0,2.99-1.34,2.99-3S17.66,5,16,5s-3,1.34-3,3,1.34,3,3,3zm-8,0c1.66,0,2.99-1.34,2.99-3S9.66,5,8,5,5,6.34,5,8s1.34,3,3,3z" 
                                          Fill="#F97316" Aspect="Uniform" HeightRequest="14" WidthRequest="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label x:Name="CrmLeadsLabel" Text="5,109" TextColor="{StaticResource Slate900}" FontSize="28" FontAttributes="Bold" />
                                <HorizontalStackLayout Spacing="4">
                                    <Path Data="M7,14l5-5l5,5" Fill="{StaticResource SuccessGreen}" Aspect="Uniform" HeightRequest="10" WidthRequest="10" VerticalOptions="Center" />
                                    <Label Text="8% conversion rate" TextColor="{StaticResource SuccessGreen}" FontSize="11" FontAttributes="Bold" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Sales Revenue & Fulfillment Health Row -->
                <Grid ColumnDefinitions="*, 350" ColumnSpacing="24">
                    <!-- Sales Revenue Chart -->
                    <Border Grid.Column="0" Padding="24" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White">
                        <VerticalStackLayout Spacing="32">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Sales Revenue" TextColor="{StaticResource Slate900}" FontSize="18" FontAttributes="Bold" />
                                    <Label Text="Revenue split between Fine Art and Digital Commissions" TextColor="{StaticResource Slate400}" FontSize="12" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1" StrokeShape="RoundRectangle 8" Stroke="{StaticResource Slate200}" BackgroundColor="{StaticResource Slate50}" Padding="4">
                                    <HorizontalStackLayout Spacing="4">
                                        <Border BackgroundColor="White" Padding="12, 4" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                                            <Label Text="Art" FontSize="11" TextColor="{StaticResource Slate600}" FontAttributes="Bold" />
                                        </Border>
                                        <Border BackgroundColor="Transparent" Padding="12, 4" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                                            <Label Text="Comm." FontSize="11" TextColor="{StaticResource Slate400}" FontAttributes="Bold" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Chart Placeholder -->
                            <FlexLayout x:Name="RevenueChartLayout" HeightRequest="200" JustifyContent="SpaceBetween" AlignItems="End" Margin="0,0,0,12">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <BoxView Style="{StaticResource ChartBarStyle}" 
                                                 Color="{StaticResource DashboardTeal}" 
                                                 HeightRequest="{Binding .}" 
                                                 WidthRequest="28" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="1">
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="ART SALES" TextColor="{StaticResource Slate400}" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" />
                                    <Label Text="$42,900" TextColor="{StaticResource Slate900}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                                <BoxView Grid.Column="0" WidthRequest="1" BackgroundColor="{StaticResource Slate200}" HorizontalOptions="End" Margin="0,8" />
                                <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                                    <Label Text="DIGITAL COMM." TextColor="{StaticResource Slate400}" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" />
                                    <Label Text="$18,450" TextColor="{StaticResource Slate900}" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Subscriptions Showcase Card -->
                    <Border Grid.Column="1" Padding="24" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{StaticResource Slate900}">
                        <VerticalStackLayout Spacing="24">
                            <Label Text="Subscriptions Showcase" TextColor="White" FontSize="20" FontAttributes="Bold" />

                            <Grid ColumnDefinitions="110, *" ColumnSpacing="20">
                                <!-- Selection Tabs -->
                                <VerticalStackLayout Grid.Column="0" Spacing="8">
                                    <Border x:Name="StarterTab" BackgroundColor="#1E293B" StrokeShape="RoundRectangle 8" Padding="12,10" StrokeThickness="0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnTierTabTapped" CommandParameter="Starter" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto, *">
                                            <BoxView x:Name="StarterIndicator" WidthRequest="3" BackgroundColor="#3B82F6" VerticalOptions="Fill" Margin="-12,0,8,0" IsVisible="True" />
                                            <Label Grid.Column="1" Text="Starter" TextColor="White" FontSize="14" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>

                                    <Border x:Name="StandardTab" BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" Padding="12,10" StrokeThickness="0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnTierTabTapped" CommandParameter="Standard" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto, *">
                                            <BoxView x:Name="StandardIndicator" WidthRequest="3" BackgroundColor="#3B82F6" VerticalOptions="Fill" Margin="-12,0,8,0" IsVisible="False" />
                                            <Label Grid.Column="1" Text="Standard" TextColor="{StaticResource Slate400}" FontSize="14" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>

                                    <Border x:Name="EnterpriseTab" BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" Padding="12,10" StrokeThickness="0">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnTierTabTapped" CommandParameter="EnterprisePlus" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto, *">
                                            <BoxView x:Name="EnterpriseIndicator" WidthRequest="3" BackgroundColor="#3B82F6" VerticalOptions="Fill" Margin="-12,0,8,0" IsVisible="False" />
                                            <Label Grid.Column="1" Text="Enterprise Plus" TextColor="{StaticResource Slate400}" FontSize="14" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Details Panel -->
                                <VerticalStackLayout Grid.Column="1" Spacing="20">
                                    <VerticalStackLayout x:Name="StarterDetails" Spacing="16" IsVisible="True">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="$49 / month" TextColor="{StaticResource DashboardTeal}" FontSize="24" FontAttributes="Bold" />
                                            <Border x:Name="StarterCurrentBadge" BackgroundColor="#134E4A" Padding="8,4" StrokeShape="RoundRectangle 4" StrokeThickness="0" HorizontalOptions="Start">
                                                <Label Text="✓  CURRENT PLAN" TextColor="{StaticResource DashboardTeal}" FontSize="10" FontAttributes="Bold" />
                                            </Border>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Spacing="8">
                                            <HorizontalStackLayout Spacing="8">
                                                <Path Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" Fill="{StaticResource DashboardTeal}" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" />
                                                <Label Text="Up to 5 Users" TextColor="{StaticResource Slate300}" FontSize="12" />
                                            </HorizontalStackLayout>
                                            <HorizontalStackLayout Spacing="8">
                                                <Path Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" Fill="{StaticResource DashboardTeal}" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" />
                                                <Label Text="Basic Analytics" TextColor="{StaticResource Slate300}" FontSize="12" />
                                            </HorizontalStackLayout>
                                            <HorizontalStackLayout Spacing="8">
                                                <Path Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" Fill="{StaticResource DashboardTeal}" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" />
                                                <Label Text="100GB Storage" TextColor="{StaticResource Slate300}" FontSize="12" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <Label Text="Active Subscriptions: 842" TextColor="{StaticResource Slate400}" FontSize="11" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout x:Name="StandardDetails" Spacing="16" IsVisible="False">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="$199 / month" TextColor="#3B82F6" FontSize="24" FontAttributes="Bold" />
                                            <Border x:Name="StandardCurrentBadge" IsVisible="False" BackgroundColor="#1E3A5F" Padding="8,4" StrokeShape="RoundRectangle 4" StrokeThickness="0" HorizontalOptions="Start">
                                                <Label Text="✓  CURRENT PLAN" TextColor="#60A5FA" FontSize="10" FontAttributes="Bold" />
                                            </Border>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Spacing="8">
                                            <HorizontalStackLayout Spacing="8">
                                                <Path Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" Fill="#3B82F6" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" />
                                                <Label Text="Up to 20 Users" TextColor="{StaticResource Slate300}" FontSize="12" />
                                            </HorizontalStackLayout>
                                            <HorizontalStackLayout Spacing="8">
                                                <Path Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" Fill="#3B82F6" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" />
                                                <Label Text="Advanced CRM" TextColor="{StaticResource Slate300}" FontSize="12" />
                                            </HorizontalStackLayout>
                                            <HorizontalStackLayout Spacing="8">
                                                <Path Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" Fill="#3B82F6" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" />
                                                <Label Text="1TB Storage" TextColor="{StaticResource Slate300}" FontSize="12" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                            <Label Text="Active Subscriptions: 312" TextColor="{StaticResource Slate400}" FontSize="11" VerticalOptions="Center" />
                                            <Button x:Name="StandardSubscribeBtn" Grid.Column="1" Text="Subscribe" BackgroundColor="#3B82F6" TextColor="White" HeightRequest="36" Padding="16,0" CornerRadius="8" FontSize="12" FontAttributes="Bold" Clicked="OnSubscribeClicked" CommandParameter="Standard" />
                                        </Grid>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout x:Name="EnterprisePlusDetails" Spacing="16" IsVisible="False">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="$599 / month" TextColor="#A855F7" FontSize="24" FontAttributes="Bold" />
                                            <Border x:Name="EnterpriseCurrentBadge" IsVisible="False" BackgroundColor="#2E1A47" Padding="8,4" StrokeShape="RoundRectangle 4" StrokeThickness="0" HorizontalOptions="Start">
                                                <Label Text="✓  CURRENT PLAN" TextColor="#C084FC" FontSize="10" FontAttributes="Bold" />
                                            </Border>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Spacing="8">
                                            <HorizontalStackLayout Spacing="8">
                                                <Path Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" Fill="#A855F7" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" />
                                                <Label Text="Up to 50 Users" TextColor="{StaticResource Slate300}" FontSize="12" />
                                            </HorizontalStackLayout>
                                            <HorizontalStackLayout Spacing="8">
                                                <Path Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" Fill="#A855F7" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" />
                                                <Label Text="Dedicated Support" TextColor="{StaticResource Slate300}" FontSize="12" />
                                            </HorizontalStackLayout>
                                            <HorizontalStackLayout Spacing="8">
                                                <Path Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" Fill="#A855F7" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" />
