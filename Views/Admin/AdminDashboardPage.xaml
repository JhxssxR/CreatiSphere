                                                <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                                                    <Border HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0" BackgroundColor="{StaticResource Slate100}">
                                                        <Label Text="{Binding Initials}" TextColor="{StaticResource Slate500}" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                                    </Border>
                                                    <Label Text="{Binding CustomerName}" TextColor="{StaticResource Slate900}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                                <Border Grid.Column="2" BackgroundColor="#FAF5FF" Padding="8,4" StrokeShape="RoundRectangle 4" StrokeThickness="0" HorizontalOptions="Start" VerticalOptions="Center">
                                                    <Label Text="Fine Art" TextColor="#A855F7" FontSize="10" FontAttributes="Bold" />
                                                </Border>
                                                <Label Grid.Column="3" Text="{Binding Date}" TextColor="{StaticResource Slate600}" FontSize="13" VerticalOptions="Center" />
                                                <Label Grid.Column="4" Text="{Binding Amount, StringFormat='{0:C}'}" TextColor="{StaticResource Slate900}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                                <Border Grid.Column="5" BackgroundColor="#DCFCE7" Padding="12,4" StrokeShape="RoundRectangle 12" StrokeThickness="0" HorizontalOptions="Center" VerticalOptions="Center">
                                                    <Label Text="{Binding Status}" TextColor="#15803D" FontSize="10" FontAttributes="Bold" />
                                                </Border>
                                            </Grid>
                                            <BoxView HeightRequest="1" Color="{StaticResource Slate100}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Bottom Row: CRM Leads & Digital Asset Distribution -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="24">
                    <!-- CRM Recent Leads -->
                    <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                        <VerticalStackLayout Spacing="24">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="CRM Recent Leads" TextColor="{StaticResource Slate900}" FontSize="18" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="⋯" TextColor="{StaticResource Slate400}" FontSize="20" VerticalOptions="Center" />
                            </Grid>

                            <VerticalStackLayout Spacing="16">
                                <!-- Lead 1 -->
                                <Border Padding="12" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{StaticResource Slate50}">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Border HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="#F1F5F9">
                                            <Label Text="AM" TextColor="{StaticResource Slate500}" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Margin="12,0" Spacing="2">
                                            <Label Text="Alex Marshall" TextColor="{StaticResource Slate900}" FontSize="14" FontAttributes="Bold" />
                                            <Label Text="Interested in: Digital Licensing" TextColor="{StaticResource Slate500}" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2" BackgroundColor="#ECFDF5" Padding="8,4" StrokeShape="RoundRectangle 4" StrokeThickness="0" VerticalOptions="Center">
                                            <Label Text="HOT LEAD" TextColor="#10B981" FontSize="9" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Lead 2 -->
                                <Border Padding="12" StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{StaticResource Slate50}">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Border HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0" BackgroundColor="#F1F5F9">
                                            <Label Text="SK" TextColor="{StaticResource Slate500}" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Margin="12,0" Spacing="2">
                                            <Label Text="Sarah Kinsley" TextColor="{StaticResource Slate900}" FontSize="14" FontAttributes="Bold" />
                                            <Label Text="Interested in: Custom Sculpture" TextColor="{StaticResource Slate500}" FontSize="12" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2" BackgroundColor="#F1F5F9" Padding="8,4" StrokeShape="RoundRectangle 4" StrokeThickness="0" VerticalOptions="Center">
                                            <Label Text="FOLLOW UP" TextColor="{StaticResource Slate400}" FontSize="9" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Digital Asset Distribution -->
                    <Border Grid.Column="1" Style="{StaticResource StatCardStyle}">
                        <VerticalStackLayout Spacing="24">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Digital Asset Distribution" TextColor="{StaticResource Slate900}" FontSize="18" FontAttributes="Bold" />
                                <Path Grid.Column="1" Data="M10,18h4v-2h-4V18z M3,6v2h18V6H3z M6,13h12v-2H6V13z" Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" />
                            </Grid>

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                                <!-- Graphics -->
                                <Border Grid.Column="0" Padding="20" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{StaticResource Slate50}">
                                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                                        <Path Data="M21,19V5c0-1.1-0.9-2-2-2H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14C20.1,21,21,20.1,21,19z M8.5,13.5l2.5,3.01L14.5,12l4.5,6H5 L8.5,13.5z" 
                                              Fill="#A855F7" Aspect="Uniform" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" />
                                        <Label Text="GRAPHICS" TextColor="{StaticResource Slate400}" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" />
                                        <Label Text="3,102" TextColor="{StaticResource Slate900}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Motion -->
                                <Border Grid.Column="1" Padding="20" StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="{StaticResource Slate50}">
                                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                                        <Path Data="M18,3v2h-2V3H8v2H6V3H4v18h2v-2h2v2h8v-2h2v2h2V3H18z M8,17H6v-2h2V17z M8,13H6v-2h2V13z M8,9H6V7h2V9z M14,19h-4V5h4V19z M18,17h-2v-2h2V17z M18,13h-2v-2h2V13z M18,9h-2V7h2V9z" 
