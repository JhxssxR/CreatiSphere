<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:admin="clr-namespace:CreatiSphere.Views.Admin"
             x:Class="CreatiSphere.Views.Admin.ManageProductsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Slate50}">

    <Grid ColumnDefinitions="280, *">
        <!-- Sidebar -->
        <admin:AdminSidebar Grid.Column="0" ActivePage="ManageProducts" />

        <!-- Main Content Area -->
        <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="40" Spacing="32">
                
                <!-- Top Nav Bar -->
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="System Overview Dashboard" TextColor="{StaticResource Slate900}" FontSize="14" VerticalOptions="Center" />

                    <!-- User Actions -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="24" VerticalOptions="Center">
                        <!-- Search Bar -->
                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="0" BackgroundColor="{StaticResource Slate100}" WidthRequest="300" Padding="12, 8">
                            <Grid ColumnDefinitions="Auto, *">
                                <Path Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16 c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5 S11.99,14,9.5,14z" 
                                      Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" />
                                <Entry Grid.Column="1" Placeholder="Search creatives, assets..." PlaceholderColor="{StaticResource Slate400}" TextColor="{StaticResource Slate900}" BackgroundColor="Transparent" Margin="8,0,0,0" FontSize="12" />
                            </Grid>
                        </Border>

                        <Path Data="M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.1-1.6-5.6-4.5-6.3V4c0-0.8-0.7-1.5-1.5-1.5 S10.5,3.2,10.5,4v0.7C7.6,5.4,6,7.9,6,11v5l-2,2v1h16v-1L18,16z" 
                              Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                        <Path Data="M19.1,12.9l2.1,1.6c0.2,0.1,0.2,0.4,0.1,0.6l-2,3.5c-0.1,0.2-0.4,0.3-0.6,0.2l-2.5-1c-0.5,0.4-1.1,0.7-1.7,1 l-0.4,2.6c0,0.2-0.2,0.4-0.5,0.4h-4c-0.3,0-0.5-0.2-0.5-0.4l-0.4-2.6c-0.6-0.3-1.2-0.6-1.7-1l-2.5,1c-0.2,0.1-0.5,0-0.6-0.2l-2-3.5 C1.9,14.9,2,14.6,2.2,14.5l2.1-1.6c-0.1-0.3-0.1-0.6-0.1-0.9s0-0.6,0.1-0.9L2.2,8.6c-0.2-0.1-0.2-0.4-0.1-0.6l2-3.5c0.1-0.2,0.4-0.3,0.6-0.2 l2.5,1c0.5-0.4,1.1-0.7,1.7-1L9.4,1.7c0-0.2,0.2-0.4,0.5-0.4h4c0.3,0,0.5,0.2,0.5,0.4l0.4,2.6c0.6,0.3,1.2,0.6,1.7,1l2.5-1 c0.2-0.1,0.5,0,0.6,0.2l2,3.5c0.1,0.2,0,0.5-0.2,0.6l-2.1,1.6c0.1,0.3,0.1,0.6,0.1,0.9S19.2,12.6,19.1,12.9z M12,15c1.7,0,3-1.3,3-3 s-1.3-3-3-3s-3,1.3-3,3S10.3,15,12,15z" 
                              Fill="{StaticResource Slate600}" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                        
                        <Border HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                            <Image Source="avatar.png" Aspect="AspectFill" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Page Header -->
                <Grid ColumnDefinitions="*, Auto" Margin="0, 16, 0, 0">
                    <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="Manage Products" TextColor="{StaticResource Slate900}" FontSize="28" FontAttributes="Bold" />
                        <Label Text="Track, edit, and organize your digital asset catalog." TextColor="{StaticResource Slate600}" FontSize="14" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="+ Add Product" 
                            Clicked="OnAddProductClicked"
                            TextColor="White" 
                            BackgroundColor="{StaticResource DashboardTeal}"
                            CornerRadius="8"
                            Padding="16, 8"
                            FontSize="14"
                            VerticalOptions="Center" />
                </Grid>

                <!-- Filters Row -->
                <Border Padding="16" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White">
                    <Grid ColumnDefinitions="*, Auto">
                        <HorizontalStackLayout Spacing="16" VerticalOptions="Center">
                            <!-- All Categories Filter -->
                            <Border BackgroundColor="{StaticResource Slate50}" Padding="16, 8" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{StaticResource Slate200}">
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Path Data="M10,18h4v-2h-4V18z M3,6v2h18V6H3z M6,13h12v-2H6V13z" Fill="{StaticResource Slate500}" Aspect="Uniform" HeightRequest="14" WidthRequest="14" />
                                    <Label Text="All Categories" TextColor="{StaticResource Slate700}" FontSize="13" />
                                    <Path Data="M7,10l5,5l5-5H7z" Fill="{StaticResource Slate500}" Aspect="Uniform" HeightRequest="12" WidthRequest="12" Margin="4,0,0,0" />
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Visibility Filter -->
                            <Border BackgroundColor="{StaticResource Slate50}" Padding="16, 8" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{StaticResource Slate200}">
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Path Data="M12,4.5C7,4.5 2.73,7.61 1,12c1.73,4.39 6,7.5 11,7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12,17c-2.76,0-5-2.24-5-5s2.24-5 5-5 5,2.24 5,5-2.24,5-5,5zm0-8c-1.66,0-3,1.34-3,3s1.34,3 3,3 3-1.34 3-3-1.34-3-3-3z" Fill="{StaticResource Slate500}" Aspect="Uniform" HeightRequest="14" WidthRequest="14" />
                                    <Label Text="Visibility" TextColor="{StaticResource Slate700}" FontSize="13" />
                                    <Path Data="M7,10l5,5l5-5H7z" Fill="{StaticResource Slate500}" Aspect="Uniform" HeightRequest="12" WidthRequest="12" Margin="4,0,0,0" />
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>

                        <!-- View Toggles -->
                        <Border Grid.Column="1" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White">
                            <HorizontalStackLayout>
                                <Border BackgroundColor="White" Padding="12, 8" StrokeThickness="0">
                                    <Path Data="M4,11h5V5H4V11z M4,18h5v-5H4V18z M10,18h5v-6h-5V18z M16,18h5v-7h-5V18z M10,10h11V5H10V10z" Fill="{StaticResource DashboardTeal}" Aspect="Uniform" HeightRequest="16" WidthRequest="16" />
                                </Border>
                                <BoxView WidthRequest="1" Color="{StaticResource Slate200}" />
                                <Border BackgroundColor="{StaticResource Slate50}" Padding="12, 8" StrokeThickness="0">
                                    <Path Data="M3,13h2v-2H3v2zm0,4h2v-2H3v2zm0-8h2V7H3v2zm4,4h14v-2H7v2zm0,4h14v-2H7v2zM7,7v2h14V7H7z" Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="16" WidthRequest="16" />
                                </Border>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <!-- Cards Grid -->
                <FlexLayout x:Name="ProductsGrid" BindableLayout.ItemsSource="{Binding .}" Wrap="Wrap" JustifyContent="Start" AlignItems="Start" Margin="0,0,-20,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border WidthRequest="280" Margin="0,0,20,20" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="Scale" Value="1.02" />
                                                <Setter Property="Stroke" Value="{StaticResource DashboardTeal}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <VerticalStackLayout>
                                    <Grid HeightRequest="180">
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                        <Border BackgroundColor="#CCFBF1" Padding="12, 4" StrokeShape="RoundRectangle 4" StrokeThickness="0" HorizontalOptions="End" VerticalOptions="Start" Margin="12">
                                            <Label Text="{Binding Status}" TextColor="#0D9488" FontSize="10" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                    <VerticalStackLayout Padding="16" Spacing="8">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Text="{Binding Name}" TextColor="{StaticResource Slate900}" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="1" Text="{Binding Price, StringFormat='{0:C}'}" TextColor="{StaticResource DashboardTeal}" FontSize="14" FontAttributes="Bold" />
                                        </Grid>
                                        <HorizontalStackLayout Spacing="8">
                                            <Border HeightRequest="20" WidthRequest="20" StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="{StaticResource Slate200}">
                                                <Image Source="avatar.png" Aspect="AspectFill" />
                                            </Border>
                                            <Label Text="Creative Dept." TextColor="{StaticResource Slate500}" FontSize="12" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <BoxView HeightRequest="1" Color="{StaticResource Slate100}" Margin="0, 8" />
                                        <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                                            <Border BackgroundColor="#ECFDF5" Padding="8, 4" StrokeShape="RoundRectangle 12" StrokeThickness="0" HorizontalOptions="Start">
                                                <Label Text="{Binding Stock, StringFormat='In Stock ({0})'}" TextColor="#059669" FontSize="11" FontAttributes="Bold" />
                                            </Border>
                                            
                                            <Path Grid.Column="1" Data="M12,4.5C7,4.5 2.73,7.61 1,12c1.73,4.39 6,7.5 11,7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12,17c-2.76,0-5-2.24-5-5s2.24-5 5-5 5,2.24 5,5-2.24,5-5,5zm0-8c-1.66,0-3,1.34-3,3s1.34,3 3,3 3-1.34 3-3-1.34-3-3-3z" 
                                                  Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="18" WidthRequest="18" Margin="8,0" VerticalOptions="Center">
                                                <Path.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnViewDetailsClicked" CommandParameter="{Binding .}" />
                                                </Path.GestureRecognizers>
                                            </Path>

                                            <Path Grid.Column="2" Data="M3,17.25V21h3.75L17.81,9.94l-3.75-3.75L3,17.25z M20.71,7.04c0.39-0.39,0.39-1.02,0-1.41l-2.34-2.34c-0.39-0.39-1.02-0.39-1.41,0l-1.83,1.83l3.75,3.75L20.71,7.04z" 
                                                  Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="16" WidthRequest="16" Margin="8,0" VerticalOptions="Center">
                                                <Path.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnEditProductClicked" CommandParameter="{Binding .}" />
                                                </Path.GestureRecognizers>
                                            </Path>
                                            
                                            <Path Grid.Column="3" Data="M6,19c0,1.1,0.9,2,2,2h8c1.1,0,2-0.9,2-2V7H6V19z M19,4h-3.5l-1-1h-5l-1,1H5v2h14V4z" 
                                                  Fill="{StaticResource Slate400}" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center">
                                                <Path.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnDeleteProductClicked" CommandParameter="{Binding .}" />
                                                </Path.GestureRecognizers>
                                            </Path>
                                        </Grid>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- Catalog Details Table -->
                <Border Padding="0" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*, Auto" Padding="24, 20">
                            <Label Text="Catalog Details" TextColor="{StaticResource Slate900}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Showing 4 of 124 products" TextColor="{StaticResource Slate500}" FontSize="13" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Slate200}" />

                        <!-- Headers -->
                        <Grid ColumnDefinitions="2.5*, 1.5*, 1*, 1*, 1*, 1.4*" Padding="24, 16" BackgroundColor="#F8FAFC">
                            <Label Grid.Column="0" Text="PRODUCT NAME" TextColor="{StaticResource Slate700}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="ARTIST/CREATOR" TextColor="{StaticResource Slate700}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="2" Text="CATEGORY" TextColor="{StaticResource Slate700}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="3" Text="PRICE" TextColor="{StaticResource Slate700}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="4" Text="STOCK" TextColor="{StaticResource Slate700}" FontSize="11" FontAttributes="Bold" />
                            <Label Grid.Column="5" Text="ACTIONS" TextColor="{StaticResource Slate700}" FontSize="11" FontAttributes="Bold" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Slate200}" />

                        <VerticalStackLayout x:Name="ProductsList" BindableLayout.ItemsSource="{Binding .}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout>
                                        <Grid ColumnDefinitions="2.5*, 1.5*, 1*, 1*, 1*, 1.4*" Padding="24, 20" VerticalOptions="Center">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup x:Name="CommonStates">
                                                    <VisualState x:Name="Normal" />
                                                    <VisualState x:Name="PointerOver">
                                                        <VisualState.Setters>
                                                            <Setter Property="BackgroundColor" Value="{StaticResource Slate50}" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <HorizontalStackLayout Grid.Column="0" Spacing="16" VerticalOptions="Center">
                                                <Border HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 6" StrokeThickness="1" Stroke="{StaticResource Slate200}">
                                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                                </Border>
                                                <Label Text="{Binding Name}" TextColor="{StaticResource Slate900}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <Label Grid.Column="1" Text="Artyom V." TextColor="{StaticResource Slate600}" FontSize="13" VerticalOptions="Center" />
                                            <Border Grid.Column="2" BackgroundColor="#E0E7FF" Padding="12,4" StrokeShape="RoundRectangle 12" StrokeThickness="0" HorizontalOptions="Start" VerticalOptions="Center">
                                                <Label Text="{Binding Category}" TextColor="#4338CA" FontSize="11" FontAttributes="Bold" />
                                            </Border>
                                            <Label Grid.Column="3" Text="{Binding Price, StringFormat='{0:C}'}" TextColor="{StaticResource Slate900}" FontSize="14" VerticalOptions="Center" />
                                            <HorizontalStackLayout Grid.Column="4" Spacing="6" VerticalOptions="Center">
                                                <Path Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z" Fill="#059669" Aspect="Uniform" HeightRequest="8" WidthRequest="8" VerticalOptions="Center" />
                                                <Label Text="{Binding Stock}" TextColor="{StaticResource Slate900}" FontSize="13" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <!-- Actions: Eye + Edit + Delete -->
                                            <HorizontalStackLayout Grid.Column="5" Spacing="0" VerticalOptions="Center">
                                                <Path Data="M12,4.5C7,4.5 2.73,7.61 1,12c1.73,4.39 6,7.5 11,7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12,17c-2.76,0-5-2.24-5-5s2.24-5 5-5 5,2.24 5,5-2.24,5-5,5zm0-8c-1.66,0-3,1.34-3,3s1.34,3 3,3 3-1.34 3-3-1.34-3-3-3z" 
                                                      Fill="#0D9488" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center">
                                                    <Path.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnViewDetailsClicked" CommandParameter="{Binding .}" />
                                                    </Path.GestureRecognizers>
                                                </Path>
                                                <Label Text="Edit" TextColor="{StaticResource DashboardTeal}" FontSize="12" FontAttributes="Bold" Margin="10,0,0,0" VerticalOptions="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnEditProductClicked" CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                                <Label Text="|" TextColor="{StaticResource Slate300}" FontSize="14" Margin="10,0" VerticalOptions="Center" />
                                                <Path Data="M6,19c0,1.1,0.9,2,2,2h8c1.1,0,2-0.9,2-2V7H6V19z M19,4h-3.5l-1-1h-5l-1,1H5v2h14V4z" 
                                                      Fill="#EF4444" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center">
                                                    <Path.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnDeleteProductClicked" CommandParameter="{Binding .}" />
                                                    </Path.GestureRecognizers>
                                                </Path>
                                                <Label Text="Delete" TextColor="#EF4444" FontSize="12" FontAttributes="Bold" Margin="6,0,0,0" VerticalOptions="Center">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnDeleteProductClicked" CommandParameter="{Binding .}" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </Grid>
                                        <BoxView HeightRequest="1" Color="{StaticResource Slate100}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource Slate200}" />

                        <!-- Footer Pagination -->
                        <Grid ColumnDefinitions="*, Auto" Padding="24, 16">
                            <Border Padding="16, 8" StrokeShape="RoundRectangle 6" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White" HorizontalOptions="Start">
                                <Label Text="Previous" TextColor="{StaticResource Slate700}" FontSize="13" />
                            </Border>
                            
                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Border BackgroundColor="{StaticResource DashboardTeal}" Padding="16, 8" StrokeShape="RoundRectangle 6" StrokeThickness="0">
                                    <Label Text="1" TextColor="White" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="2" TextColor="{StaticResource Slate700}" FontSize="14" VerticalOptions="Center" Padding="12,0" />
                                <Label Text="3" TextColor="{StaticResource Slate700}" FontSize="14" VerticalOptions="Center" Padding="12,0" />
                                <Border Padding="16, 8" StrokeShape="RoundRectangle 6" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="White">
                                    <Label Text="Next" TextColor="{StaticResource Slate700}" FontSize="13" />
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <!-- Add/Edit Product Modal -->
        <Grid x:Name="ProductModal" Grid.RowSpan="2" Grid.ColumnSpan="2" BackgroundColor="#80000000" IsVisible="False">
            <Border VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="750" BackgroundColor="White" StrokeShape="RoundRectangle 24" Padding="0" StrokeThickness="0">
                <Border.Shadow><Shadow Brush="Black" Opacity="0.2" Offset="0,10" Radius="30"/></Border.Shadow>
                
                <VerticalStackLayout>
                    <!-- Header -->
                    <Grid ColumnDefinitions="Auto, *" Padding="32, 32, 32, 24">
                        <Border BackgroundColor="#F0FDFA" HeightRequest="56" WidthRequest="56" StrokeShape="RoundRectangle 16" StrokeThickness="0">
                            <Path Data="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z" Fill="#0D9488" Aspect="Uniform" HeightRequest="24" WidthRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Margin="20, 0, 0, 0" VerticalOptions="Center">
                            <Label x:Name="ModalTitle" Text="Add New Product" TextColor="{StaticResource Slate900}" FontSize="20" FontAttributes="Bold" />
                            <Label Text="Manage your digital asset catalog details" TextColor="{StaticResource Slate500}" FontSize="13" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Slate100}" />

                    <Grid ColumnDefinitions="180, *" ColumnSpacing="32" Padding="32, 24, 32, 32">
                        <!-- Left: Image Preview -->
                        <VerticalStackLayout Grid.Column="0" Spacing="16">
                            <Label Text="PRODUCT IMAGE" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                            <Border StrokeShape="RoundRectangle 16" StrokeThickness="1" Stroke="{StaticResource Slate200}" HeightRequest="180" BackgroundColor="{StaticResource Slate50}">
                                <Grid>
                                    <!-- Fallback Icon -->
                                    <Path Data="M21,19V5C21,3.9 20.1,3 19,3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19M8.5,13.5L11,16.5L14.5,12L19,18H5L8.5,13.5Z" 
                                          Fill="{StaticResource Slate200}" Aspect="Uniform" HeightRequest="48" WidthRequest="48" HorizontalOptions="Center" VerticalOptions="Center" />
                                    
                                    <Image x:Name="ProductImagePreview" Source="product_placeholder.png" Aspect="AspectFill" />
                                    
                                    <Border BackgroundColor="#CCFFFFFF" Padding="8,4" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,12" StrokeShape="RoundRectangle 8">
                                        <Label Text="Preview" TextColor="{StaticResource Slate700}" FontSize="10" FontAttributes="Bold" />
                                    </Border>
                                </Grid>
                            </Border>
                            <Button Text="Upload Image" Clicked="OnUploadImageClicked" BackgroundColor="White" TextColor="{StaticResource DashboardTeal}" BorderColor="{StaticResource DashboardTeal}" BorderWidth="1" CornerRadius="8" HeightRequest="36" FontSize="12" />
                        </VerticalStackLayout>

                        <!-- Right: Form Fields -->
                        <VerticalStackLayout Grid.Column="1" Spacing="20">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="PRODUCT NAME" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="{StaticResource Slate50}" Padding="16, 12">
                                    <Entry x:Name="ProductNameEntry" Placeholder="e.g. Neon Cyberpunk Pack" TextColor="{StaticResource Slate900}" />
                                </Border>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                                <VerticalStackLayout Grid.Column="0" Spacing="8">
                                    <Label Text="CATEGORY" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="{StaticResource Slate50}" Padding="12, 0">
                                        <Picker x:Name="ProductCategoryPicker" Title="Select category" TextColor="{StaticResource Slate900}" FontSize="14" VerticalOptions="Center">
                                            <Picker.ItemsSource>
                                                <x:Array Type="{x:Type x:String}">
                                                    <x:String>Digital Art</x:String>
                                                    <x:String>3D Assets</x:String>
                                                    <x:String>UI Kits</x:String>
                                                    <x:String>Icons</x:String>
                                                </x:Array>
                                            </Picker.ItemsSource>
                                        </Picker>
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="8">
                                    <Label Text="PRICE (USD)" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="{StaticResource Slate50}" Padding="16, 12">
                                        <Entry x:Name="ProductPriceEntry" Keyboard="Numeric" Placeholder="0.00" TextColor="{StaticResource Slate900}" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="IMAGE SOURCE URL" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="{StaticResource Slate50}" Padding="16, 12">
                                    <Entry x:Name="ProductImageUrlEntry" Placeholder="e.g. product_hero.png" TextColor="{StaticResource Slate900}" TextChanged="OnProductImageUrlChanged" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="PRODUCT DESCRIPTION" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="{StaticResource Slate50}" Padding="16, 12">
                                    <Editor x:Name="ProductDescriptionEditor" Placeholder="Describe the features and benefits of this product..." TextColor="{StaticResource Slate900}" AutoSize="TextChanges" MinimumHeightRequest="100" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="STOCK QUANTITY" TextColor="{StaticResource Slate500}" FontSize="11" FontAttributes="Bold" />
                                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{StaticResource Slate200}" BackgroundColor="{StaticResource Slate50}" Padding="16, 12">
                                    <Entry x:Name="ProductStockEntry" Keyboard="Numeric" Placeholder="0" TextColor="{StaticResource Slate900}" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Actions -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="16" Padding="32, 0, 32, 40">
                        <Button Text="Cancel" Clicked="OnCancelClicked" BackgroundColor="White" TextColor="{StaticResource Slate600}" BorderWidth="1" BorderColor="{StaticResource Slate200}" CornerRadius="12" HeightRequest="48" />
                        <Button x:Name="SaveProductBtn" Grid.Column="1" Text="Save Product" Clicked="OnSaveProductClicked" BackgroundColor="{StaticResource DashboardTeal}" TextColor="White" CornerRadius="12" HeightRequest="48" FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- View Details Modal -->
        <Grid x:Name="DetailsModal" Grid.RowSpan="2" Grid.ColumnSpan="2" IsVisible="False" BackgroundColor="#990F172A">
            <Border VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="600" BackgroundColor="White" StrokeShape="RoundRectangle 24" Padding="0" StrokeThickness="0">
                <Border.Shadow><Shadow Brush="Black" Opacity="0.3" Offset="0,20" Radius="40"/></Border.Shadow>
                
                <VerticalStackLayout>
                    <Grid HeightRequest="300">
                        <Image x:Name="DetailImage" Source="product1.png" Aspect="AspectFill" />
                        <Border BackgroundColor="#CCFBF1" Padding="12, 6" StrokeShape="RoundRectangle 8" HorizontalOptions="End" VerticalOptions="Start" Margin="24">
                            <Label x:Name="DetailStatus" Text="VISIBLE" TextColor="#0D9488" FontSize="11" FontAttributes="Bold" />
                        </Border>
                        <Button Text="✕" Clicked="OnCloseDetailsClicked" BackgroundColor="#80000000" TextColor="White" WidthRequest="40" HeightRequest="40" CornerRadius="20" HorizontalOptions="Start" VerticalOptions="Start" Margin="24" FontSize="18" />
                    </Grid>

                    <VerticalStackLayout Padding="32" Spacing="24">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Spacing="4">
                                <Label x:Name="DetailName" Text="Product Name" TextColor="{StaticResource Slate900}" FontSize="24" FontAttributes="Bold" />
                                <Label x:Name="DetailCategory" Text="Category" TextColor="{StaticResource Slate500}" FontSize="14" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" x:Name="DetailPrice" Text="$0.00" TextColor="{StaticResource DashboardTeal}" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Slate100}" />

                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="20">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="STOCK LEVEL" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" />
                                <Label x:Name="DetailStock" Text="0 Units" TextColor="{StaticResource Slate900}" FontSize="16" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="8">
                                <Label Text="PRODUCT ID" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" />
                                <Label x:Name="DetailID" Text="#PRD-000" TextColor="{StaticResource Slate900}" FontSize="16" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="8">
                                <Label Text="TOTAL SALES" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" />
                                <Label Text="1,240 Sales" TextColor="{StaticResource Slate900}" FontSize="16" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="12">
                            <Label Text="DESCRIPTION" TextColor="{StaticResource Slate400}" FontSize="11" FontAttributes="Bold" />
                            <Label x:Name="DetailDescription" Text="This premium digital asset has been curated by our lead creative team. High-resolution textures and optimized vector paths ensure compatibility across all major design software including Figma, Photoshop, and Illustrator." 
                                   TextColor="{StaticResource Slate600}" FontSize="14" LineHeight="1.5" />
                        </VerticalStackLayout>
                        
                        <Button Text="Edit Product Details" Clicked="OnEditFromDetailsClicked" BackgroundColor="{StaticResource DashboardTeal}" TextColor="White" HeightRequest="48" CornerRadius="12" FontAttributes="Bold" Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Custom Confirmation Modal -->
        <Grid x:Name="ConfirmationModal" Grid.RowSpan="2" Grid.ColumnSpan="2" IsVisible="False" BackgroundColor="#80000000" Padding="20">
            <Border VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="400" BackgroundColor="White" StrokeShape="RoundRectangle 24" Padding="32" StrokeThickness="0">
                <Border.Shadow><Shadow Brush="Black" Opacity="0.2" Offset="0,10" Radius="30"/></Border.Shadow>
                <VerticalStackLayout Spacing="24" HorizontalOptions="Center">
                    <Border BackgroundColor="#FEF2F2" HeightRequest="80" WidthRequest="80" StrokeShape="RoundRectangle 40" HorizontalOptions="Center">
                        <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Fill="#EF4444" Aspect="Uniform" HeightRequest="32" WidthRequest="32" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="Delete Product?" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Slate900}" HorizontalOptions="Center" />
                        <Label Text="This action cannot be undone. Are you sure you want to remove this product from the catalog?" FontSize="14" TextColor="{StaticResource Slate500}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="16" WidthRequest="340">
                        <Button Text="Cancel" Clicked="OnCancelConfirmClicked" BackgroundColor="Transparent" TextColor="{StaticResource Slate600}" HeightRequest="48" CornerRadius="12" BorderWidth="1" BorderColor="{StaticResource Slate200}" />
                        <Button Grid.Column="1" Text="Delete" Clicked="OnFinalConfirmClicked" BackgroundColor="#EF4444" TextColor="White" FontAttributes="Bold" HeightRequest="48" CornerRadius="12" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>
