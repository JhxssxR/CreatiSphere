<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CreatiSphere.Views.Sales.SalesCrmPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <ContentPage.Resources>
        <Style x:Key="HoverCardStyle" TargetType="Border">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="#E2E8F0" />
                                <Setter Property="BackgroundColor" Value="White" />
                                <Setter Property="TranslationY" Value="0" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="#0D9488" />
                                <Setter Property="BackgroundColor" Value="#F8FAFC" />
                                <Setter Property="TranslationY" Value="-4" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>
    <Grid ColumnDefinitions="260, *">

        <!-- ===== SALES SIDEBAR ===== -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" BackgroundColor="#1E293B">
            <VerticalStackLayout Grid.Row="0" Padding="24,32" Spacing="4">
                <HorizontalStackLayout Spacing="12">
                    <Border BackgroundColor="#0D9488" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 8">
                        <Label Text="◈" TextColor="White" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="Sales Portal" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="CREATISPHERE" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" Margin="44,0,0,0" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="12,0">
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDashboardClicked"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M3,13h8V3H3V13z M3,21h8v-6H3V21z M13,21h8V11h-8V21z M13,3v6h8V3H13z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Dashboard" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCustomersClicked"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M12,12c2.21,0,4-1.79,4-4s-1.79-4-4-4s-4,1.79-4,4S9.79,12,12,12z M12,14c-2.67,0-8,1.34-8,4v2h16v-2C20,15.34,14.67,14,12,14z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Customers" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTransactionsClicked"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M14,2H6C4.9,2,4,2.9,4,4v16c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V8L14,2z M13,9V3.5L18.5,9H13z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Transactions" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPerformanceClicked"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20.38,8.57l-1.23,1.85a8,8,0,0,1-.22,7.58H5.07A8,8,0,0,1,15.58,6.85l1.85-1.23A10,10,0,0,0,3.35,19a2,2,0,0,0,1.72,1H18.93a2,2,0,0,0,1.72-1A10,10,0,0,0,20.38,8.57ZM12,18a1,1,0,1,1,1-1A1,1,0,0,1,12,18Zm5-7a1,1,0,1,1,1-1A1,1,0,0,1,17,11ZM7,11a1,1,0,1,1,1-1A1,1,0,0,1,7,11Zm5-5a1,1,0,1,1,1-1A1,1,0,0,1,12,6Z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Performance" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- CRM (Active) -->
                <Border BackgroundColor="#334155" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M12,2c1.1,0,2,0.9,2,2s-0.9,2-2,2s-2-0.9-2-2S10.9,2,12,2z M12,22c-1.1,0-2-0.9-2-2h4C14,21.1,13.1,22,12,22z M18,16v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-0.83-0.67-1.5-1.5-1.5s-1.5,0.67-1.5,1.5v0.68C7.63,5.36,6,7.92,6,11v5l-2,2v1h16v-1L18,16z" Fill="#0D9488" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="CRM" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnReportsClicked"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M19,19H5V5h14V19z M17,17h-2V7h2V17z M13,17h-2v-4h2V17z M9,17H7v-7h2V17z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Reports" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="2" Padding="20" Spacing="16">
                
                <BoxView HeightRequest="1" Color="#334155" Margin="0,4" />
                
                <VerticalStackLayout Spacing="16" Margin="0,4">
                    <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                        <HorizontalStackLayout Spacing="14">
                            <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                            <Label Text="Settings" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                    <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLogoutClicked" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="14">
                            <Path Data="M10.09,15.59L11.5,17l5-5l-5-5l-1.41,1.41L12.67,11H3v2h9.67L10.09,15.59z M19,3H5C3.89,3,3,3.9,3,5v4h2V5h14v14H5v-4H3v4 c0,1.1,0.89,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.11,3,19,3z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                            <Label Text="Logout" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
                
                <BoxView HeightRequest="1" Color="#334155" Margin="0,4" />

                <Grid ColumnDefinitions="Auto, *" Margin="0,4,0,0">
                    <Border HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                        <Image Source="staff_avatar.png" Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="12,0">
                        <Label Text="Alex Sterling" TextColor="White" FontSize="14" FontAttributes="Bold" />
                        <Label Text="Senior Associate" TextColor="#94A3B8" FontSize="11" />
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Grid>

        <!-- ===== MAIN CONTENT ===== -->
        <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="40" Spacing="32">
                
                <VerticalStackLayout Spacing="8">
                    <Label Text="Customer Relationship Management (CRM)" TextColor="#0F172A" FontSize="28" FontAttributes="Bold" />
                    <Label Text="Manage your customer pipeline and relationships" TextColor="#64748B" FontSize="14" />
                </VerticalStackLayout>

                <!-- CRM Metrics Row -->
                <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="20">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="20" Style="{StaticResource HoverCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Total Customers" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                                <Path Grid.Column="1" Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" Fill="#6366F1" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" />
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label x:Name="TotalCustomersLabel" Text="248" TextColor="#0F172A" FontSize="24" FontAttributes="Bold" />
                                <Label Text="Active database" TextColor="#94A3B8" FontSize="12" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="20" Style="{StaticResource HoverCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Active Engagements" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                                <Path Grid.Column="1" Data="M11.71 1.25C11.64.91 11.28.69 10.93.76c-.36.07-.63.38-.63.74 0 0 0 .19-.01.55-.02 1.35-.37 3.69-2.55 5.56-1.5 1.29-3.09 3.03-3.69 5.8-.31 1.45-.14 3.01.62 4.31C5.35 18.9 6.64 20 8.08 20.66c1.45.66 3.12.87 4.7.53 1.58-.33 2.98-1.25 3.99-2.54C17.78 17.36 18.33 15.65 18 14c-.05-.28-.31-.46-.59-.41-.28.05-.46.31-.41.59.27 1.35-.18 2.76-1 3.82-.83 1.05-1.98 1.8-3.27 2.07-1.29.28-2.65.11-3.83-.43s-2.07-1.46-2.56-2.56c-.61-1.37-.5-2.87-.03-4.11.45-1.18 1.15-2.18 1.95-3.08 1.63-1.83 2.89-3.76 3.39-5.83.21-1.02.24-1.87.19-2.57l-.02-.24z M13.88 7.39c-.19-.21-.5-.25-.74-.1-.24.16-.31.47-.16.71l.03.04c.73 1.11 1.19 2.5 1.19 3.96 0 1.93-1.57 3.5-3.5 3.5-1.12 0-2.12-.53-2.77-1.35-.17-.22-.49-.26-.71-.09-.22.17-.26.49-.09.71.79.99 1.99 1.63 3.33 1.63 2.37 0 4.3-1.93 4.3-4.3 0-1.63-.52-3.13-1.4-4.3l-.04-.05z" Fill="#F97316" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" />
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="45" TextColor="#0F172A" FontSize="24" FontAttributes="Bold" />
                                <Label Text="High-priority leads" TextColor="#94A3B8" FontSize="12" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="20" Style="{StaticResource HoverCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Avg Response Time" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                                <Path Grid.Column="1" Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" Fill="#8B5CF6" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" />
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="1.2h" TextColor="#0F172A" FontSize="24" FontAttributes="Bold" />
                                <Label Text="Improved by 15 mins" TextColor="#94A3B8" FontSize="12" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="3" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="20" Style="{StaticResource HoverCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Satisfaction Score" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                                <Path Grid.Column="1" Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" Fill="#EAB308" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" />
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="4.8/5" TextColor="#0F172A" FontSize="24" FontAttributes="Bold" />
                                <Label Text="Based on recent surveys" TextColor="#94A3B8" FontSize="12" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <HorizontalStackLayout Spacing="8">
                    <Border BackgroundColor="#F8FAFC" StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#E2E8F0" Padding="16,8">
                        <Label Text="All Contacts" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" />
                    </Border>
                    <Label Text="Leads" TextColor="#64748B" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" Margin="8,0" />
                    <Label Text="VIP Customers" TextColor="#64748B" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" Margin="8,0" />
                </HorizontalStackLayout>

                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="24">
                    <VerticalStackLayout Spacing="20">
                        <Label Text="Customer Database" TextColor="#0F172A" FontSize="16" FontAttributes="Bold" />
                        
                        <VerticalStackLayout Spacing="16" x:Name="CustomersLayout">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="16" Style="{StaticResource HoverCardStyle}">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <Border HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" BackgroundColor="#0D9488" StrokeThickness="0">
                                                <Label Text="{Binding Initials}" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Margin="16,0,0,0" VerticalOptions="Center">
                                                <Label Text="{Binding Username}" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                                                <Label Text="{Binding Email}" TextColor="#64748B" FontSize="13" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="2" Text="View Profile" BackgroundColor="#F8FAFC" TextColor="#0F172A" BorderColor="#E2E8F0" BorderWidth="1" CornerRadius="6" HeightRequest="32" Padding="12,0" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Text="© 2026 CreatiSphere Inc. All rights reserved. Professional Grade Sales Management." 
                       TextColor="#94A3B8" FontSize="11" HorizontalOptions="Center" Margin="0,0,0,20" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>


