                    </Border>
                    <Path Grid.Column="2" Data="M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-0.83-0.67-1.5-1.5-1.5 s-1.5,0.67-1.5,1.5v0.68C7.64,5.36,6,7.92,6,11v5l-2,2v1h16v-1L18,16z" Fill="#64748B" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                    <Label Grid.Column="3" Text="?" TextColor="#64748B" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
                </Grid>

                <!-- Top Stats Row -->
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="20">
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="24" Style="{StaticResource HoverCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="Auto, *">
                                <Border BackgroundColor="#DBEAFE" HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 8">
                                    <Path Data="{StaticResource IconClipboard}" Fill="#3B82F6" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1" Text="+12% vs last week" TextColor="#0D9488" FontSize="11" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Start" />
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Pending Approval" TextColor="#64748B" FontSize="13" />
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="24" TextColor="#0F172A" FontSize="32" FontAttributes="Bold" />
                                    <Label Text="orders" TextColor="#64748B" FontSize="14" VerticalOptions="End" Margin="0,0,0,6" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Label Text="Avg. wait time: 4.2 hours" TextColor="#94A3B8" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="24" Style="{StaticResource HoverCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="Auto, *">
                                <Border BackgroundColor="#DCFCE7" HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 8">
                                    <Path Data="{StaticResource IconSync}" Fill="#0D9488" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1" Text="Active now" TextColor="#0D9488" FontSize="11" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Start" />
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Processing" TextColor="#64748B" FontSize="13" />
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="156" TextColor="#0F172A" FontSize="32" FontAttributes="Bold" />
                                    <Label Text="orders" TextColor="#64748B" FontSize="14" VerticalOptions="End" Margin="0,0,0,6" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Label Text="84% within delivery window" TextColor="#94A3B8" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#EF4444" BackgroundColor="White" Padding="24" Style="{StaticResource HoverCardStyle}">
                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="Auto, *">
                                <Border BackgroundColor="#FEE2E2" HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 8">
                                    <Path Data="{StaticResource IconUndo}" Fill="#EF4444" Aspect="Uniform" HeightRequest="20" WidthRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Grid.Column="1" Text="Requires attention" TextColor="#EF4444" FontSize="11" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Start" />
                            </Grid>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Refund Requests" TextColor="#64748B" FontSize="13" />
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="08" TextColor="#0F172A" FontSize="32" FontAttributes="Bold" />
                                    <Label Text="claims" TextColor="#64748B" FontSize="14" VerticalOptions="End" Margin="0,0,0,6" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                            <Label Text="3 flagged as high priority" TextColor="#94A3B8" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Transactions Table -->
                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="0">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*, Auto, Auto" Padding="24,20">
                            <Label Text="Recent Transactions" TextColor="#0F172A" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Filter" BackgroundColor="White" TextColor="#0F172A" BorderColor="#E2E8F0" BorderWidth="1" HeightRequest="36" Padding="16,0" Margin="0,0,12,0" />
                            <Button Grid.Column="2" Text="Export" BackgroundColor="White" TextColor="#0F172A" BorderColor="#E2E8F0" BorderWidth="1" HeightRequest="36" Padding="16,0" />
                        </Grid>
                        
                        <Grid ColumnDefinitions="*, 2*, *, *, *, Auto" Padding="24,12" BackgroundColor="#F8FAFC">
                            <Label Text="ORDER ID" TextColor="#64748B" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label Grid.Column="1" Text="CUSTOMER" TextColor="#64748B" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label Grid.Column="2" Text="AMOUNT" TextColor="#64748B" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label Grid.Column="3" Text="DATE" TextColor="#64748B" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label Grid.Column="4" Text="STATUS" TextColor="#64748B" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label Grid.Column="5" Text="ACTIONS" TextColor="#64748B" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" WidthRequest="100" HorizontalOptions="Center" />
                        </Grid>

                        <CollectionView x:Name="TransactionsList" Margin="0" HeightRequest="450">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*, 2*, *, *, *, Auto" Padding="24,16" Style="{StaticResource HoverRowStyle}">
                                        <Label Text="{Binding TransactionID}" TextColor="#0D9488" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Column="1" Spacing="12">
                                            <Border HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 16" BackgroundColor="#E2E8F0">
                                                <Label Text="{Binding Initials}" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout VerticalOptions="Center">
                                                <Label Text="{Binding CustomerName}" TextColor="#0F172A" FontSize="13" FontAttributes="Bold" />
                                                <Label Text="{Binding CustomerEmail}" TextColor="#94A3B8" FontSize="11" />
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding Amount, StringFormat='${0:N2}'}" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                        <Label Grid.Column="3" Text="{Binding Date}" TextColor="#64748B" FontSize="13" VerticalOptions="Center" />
                                        
                                        <Border Grid.Column="4" Padding="12,4" StrokeShape="RoundRectangle 12" HorizontalOptions="Start" VerticalOptions="Center">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="BackgroundColor" Value="#DCFCE7" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="BackgroundColor" Value="#DBEAFE" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Refunded">
                                                    <Setter Property="BackgroundColor" Value="#FEE2E2" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <HorizontalStackLayout Spacing="6">
                                                <Ellipse WidthRequest="6" HeightRequest="6">
                                                    <Ellipse.Triggers>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Fill" Value="#0D9488" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="Fill" Value="#3B82F6" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Ellipse" Binding="{Binding Status}" Value="Refunded">
                                                            <Setter Property="Fill" Value="#EF4444" />
                                                        </DataTrigger>
                                                    </Ellipse.Triggers>
                                                </Ellipse>
                                                <Label Text="{Binding Status, Converter={StaticResource StringToUpperConverter}}" FontSize="9" FontAttributes="Bold">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="TextColor" Value="#065F46" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Pending">
                                                            <Setter Property="TextColor" Value="#1E40AF" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Refunded">
                                                            <Setter Property="TextColor" Value="#B91C1C" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </Border>

                                        <HorizontalStackLayout Grid.Column="5" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Path Data="{StaticResource IconEye}" Fill="#64748B" WidthRequest="18" HeightRequest="18" Aspect="Uniform" />
                                            <Path Data="{StaticResource IconMail}" Fill="#64748B" WidthRequest="18" HeightRequest="18" Aspect="Uniform" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Grid ColumnDefinitions="*, Auto" Padding="24,20" BackgroundColor="#F8FAFC">
                            <Label Text="Showing 1 to 4 of 128 transactions" TextColor="#64748B" FontSize="13" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <Label Text="&lt;" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#94A3B8" Margin="0,0,12,0" />
                                <Border BackgroundColor="#0D9488" StrokeShape="RoundRectangle 8" StrokeThickness="0" HeightRequest="36" WidthRequest="36">
                                    <Label Text="1" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontAttributes="Bold" />
                                </Border>
                                <Label Text="2" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#64748B" WidthRequest="36" />
                                <Label Text="3" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#64748B" WidthRequest="36" />
                                <Label Text="&gt;" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#64748B" Margin="12,0,0,0" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Label Text="© 2026 CreatiSphere Inc. All rights reserved. Professional Grade Sales Management." 
                       TextColor="#94A3B8" FontSize="11" HorizontalOptions="Center" Margin="0,0,0,20" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>


