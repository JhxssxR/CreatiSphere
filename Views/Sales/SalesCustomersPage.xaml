<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CreatiSphere.Views.Sales.SalesCustomersPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <ContentPage.Resources>
        <Style x:Key="HoverCardStyle" TargetType="Border">
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="#E2E8F0" />
                                <Setter Property="BackgroundColor" Value="White" />
                                <Setter Property="TranslationY" Value="0" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="Stroke" Value="#0D9488" />
                                <Setter Property="BackgroundColor" Value="#F8FAFC" />
                                <Setter Property="TranslationY" Value="-4" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="260, *">

        <!-- ===== SALES SIDEBAR ===== -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" BackgroundColor="#1E293B">
            <VerticalStackLayout Grid.Row="0" Padding="24,32" Spacing="4">
                <HorizontalStackLayout Spacing="12">
                    <Border BackgroundColor="#0D9488" HeightRequest="32" WidthRequest="32" StrokeShape="RoundRectangle 8">
                        <Label Text="◈" TextColor="White" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="Sales Portal" TextColor="White" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="CREATISPHERE" TextColor="#94A3B8" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" Margin="44,0,0,0" />
            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="12,0">
                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDashboardClicked"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M3,13h8V3H3V13z M3,21h8v-6H3V21z M13,21h8V11h-8V21z M13,3v6h8V3H13z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Dashboard" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Customers (Active) -->
                <Border BackgroundColor="#334155" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M12,12c2.21,0,4-1.79,4-4s-1.79-4-4-4s-4,1.79-4,4S9.79,12,12,12z M12,14c-2.67,0-8,1.34-8,4v2h16v-2C20,15.34,14.67,14,12,14z" Fill="#0D9488" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Customers" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnTransactionsClicked"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M14,2H6C4.9,2,4,2.9,4,4v16c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V8L14,2z M13,9V3.5L18.5,9H13z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Transactions" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPerformanceClicked"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M20.38,8.57l-1.23,1.85a8,8,0,0,1-.22,7.58H5.07A8,8,0,0,1,15.58,6.85l1.85-1.23A10,10,0,0,0,3.35,19a2,2,0,0,0,1.72,1H18.93a2,2,0,0,0,1.72-1A10,10,0,0,0,20.38,8.57ZM12,18a1,1,0,1,1,1-1A1,1,0,0,1,12,18Zm5-7a1,1,0,1,1,1-1A1,1,0,0,1,17,11ZM7,11a1,1,0,1,1,1-1A1,1,0,0,1,7,11Zm5-5a1,1,0,1,1,1-1A1,1,0,0,1,12,6Z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Performance" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCrmClicked"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M12,2c1.1,0,2,0.9,2,2s-0.9,2-2,2s-2-0.9-2-2S10.9,2,12,2z M12,22c-1.1,0-2-0.9-2-2h4C14,21.1,13.1,22,12,22z M18,16v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-0.83-0.67-1.5-1.5-1.5s-1.5,0.67-1.5,1.5v0.68C7.63,5.36,6,7.92,6,11v5l-2,2v1h16v-1L18,16z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="CRM" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0" Padding="16,12">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnReportsClicked"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14">
                        <Path Data="M19,3H5C3.9,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.1,3,19,3z M19,19H5V5h14V19z M17,17h-2V7h2V17z M13,17h-2v-4h2V17z M9,17H7v-7h2V17z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                        <Label Text="Reports" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="2" Padding="20" Spacing="16">
                
                <BoxView HeightRequest="1" Color="#334155" Margin="0,4" />
                
                <VerticalStackLayout Spacing="16" Margin="0,4">
                    <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                        <HorizontalStackLayout Spacing="14">
                            <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                            <Label Text="Settings" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                    <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 8" StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLogoutClicked" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="14">
                            <Path Data="M10.09,15.59L11.5,17l5-5l-5-5l-1.41,1.41L12.67,11H3v2h9.67L10.09,15.59z M19,3H5C3.89,3,3,3.9,3,5v4h2V5h14v14H5v-4H3v4 c0,1.1,0.89,2,2,2h14c1.1,0,2-0.9,2-2V5C21,3.9,20.11,3,19,3z" Fill="#94A3B8" Aspect="Uniform" HeightRequest="18" WidthRequest="18" VerticalOptions="Center"/>
                            <Label Text="Logout" TextColor="#94A3B8" FontSize="14" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>
                </VerticalStackLayout>
                
                <BoxView HeightRequest="1" Color="#334155" Margin="0,4" />

                <Grid ColumnDefinitions="Auto, *" Margin="0,4,0,0">
                    <Border HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" StrokeThickness="0">
                        <Image Source="staff_avatar.png" Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="12,0">
                        <Label Text="Alex Sterling" TextColor="White" FontSize="14" FontAttributes="Bold" />
                        <Label Text="Senior Associate" TextColor="#94A3B8" FontSize="11" />
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Grid>

        <!-- ===== MAIN CONTENT ===== -->
        <ScrollView Grid.Column="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="40" Spacing="32">
                
                <!-- Header -->
                <Grid ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Sales Operations" TextColor="#0D9488" FontSize="18" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" Padding="12,0" HeightRequest="40" WidthRequest="300">
                        <Grid ColumnDefinitions="20, *">
                            <Path Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16 c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5 S11.99,14,9.5,14z" Fill="#64748B" Aspect="Uniform" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="Search directory..." PlaceholderColor="#64748B" TextColor="#0F172A" FontSize="13" Margin="8,0,0,0" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Path Grid.Column="2" Data="M12,22c1.1,0,2-0.9,2-2h-4C10,21.1,10.9,22,12,22z M18,16v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-0.83-0.67-1.5-1.5-1.5 s-1.5,0.67-1.5,1.5v0.68C7.64,5.36,6,7.92,6,11v5l-2,2v1h16v-1L18,16z" Fill="#64748B" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                    <Label Grid.Column="3" Text="?" TextColor="#64748B" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
                </Grid>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Customer Directory" TextColor="#0F172A" FontSize="32" FontAttributes="Bold" />
                    <Label Text="Manage and monitor your regional accounts and leads." TextColor="#64748B" FontSize="14" />
                </VerticalStackLayout>

                <!-- Stats Cards -->
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="20">
                    <Border Grid.Column="0" Style="{StaticResource HoverCardStyle}" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="24">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="TOTAL CUSTOMERS" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding TotalCustomers}" TextColor="#0F172A" FontSize="28" FontAttributes="Bold" />
                                <Label Text="+12%" TextColor="#0D9488" FontSize="13" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource HoverCardStyle}" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#0D9488" BackgroundColor="White" Padding="24">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="ACTIVE CONTRACTS" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding ActiveContracts}" TextColor="#0F172A" FontSize="28" FontAttributes="Bold" />
                                <Label Text="+5%" TextColor="#0D9488" FontSize="13" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource HoverCardStyle}" StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="24">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="AT RISK" TextColor="#64748B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" />
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding AtRisk}" TextColor="#0F172A" FontSize="28" FontAttributes="Bold" />
                                <Label Text="Critical" TextColor="#EF4444" FontSize="13" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*, Auto" Padding="0,20">
                    <HorizontalStackLayout Spacing="12">
                        <Border BackgroundColor="#F0FDFA" StrokeShape="RoundRectangle 20" Padding="20,10">
                            <Label Text="All Contacts" TextColor="#0D9488" FontAttributes="Bold" FontSize="14" />
                        </Border>
                        <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#E2E8F0" Padding="20,10">
                            <Label Text="Active" TextColor="#64748B" FontSize="14" />
                        </Border>
                        <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#E2E8F0" Padding="20,10">
                            <Label Text="Lead" TextColor="#64748B" FontSize="14" />
                        </Border>
                        <Border BackgroundColor="Transparent" StrokeShape="RoundRectangle 20" StrokeThickness="1" Stroke="#E2E8F0" Padding="20,10">
                            <Label Text="Inactive" TextColor="#64748B" FontSize="14" />
                        </Border>
                    </HorizontalStackLayout>
                    
                    <HorizontalStackLayout Grid.Column="1" Spacing="16">
                        <Border BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" Padding="16,8" WidthRequest="200">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Last 30 Days" TextColor="#0F172A" FontSize="14" VerticalOptions="Center" />
                                <Path Grid.Column="1" Data="M7,10l5,5l5-5H7z" Fill="#64748B" Aspect="Uniform" HeightRequest="12" WidthRequest="12" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Border BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" Padding="12,8">
                            <HorizontalStackLayout Spacing="8">
                                <Path Data="M3,18h6v-2H3V18z M3,6v2h18V6H3z M3,13h12v-2H3V13z" Fill="#64748B" Aspect="Uniform" HeightRequest="16" WidthRequest="16" VerticalOptions="Center" />
                                <Label Text="More Filters" TextColor="#0F172A" FontSize="14" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Button Text="Add New Customer" BackgroundColor="#065F46" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="44" Padding="20,0">
                            <Button.ImageSource>
                                <FontImageSource Glyph="👤+" Size="16" Color="White" />
                            </Button.ImageSource>
                        </Button>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Customer Table -->
                <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="#E2E8F0" BackgroundColor="White" Padding="0">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="2*, *, 2*, Auto" Padding="24,16" BackgroundColor="#F8FAFC">
                            <Label Text="CUSTOMER &amp; COMPANY" TextColor="#64748B" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label Grid.Column="1" Text="STATUS" TextColor="#64748B" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label Grid.Column="2" Text="RECENT ACTIVITY" TextColor="#64748B" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" />
                            <Label Grid.Column="3" Text="ACTIONS" TextColor="#64748B" FontSize="10" FontAttributes="Bold" CharacterSpacing="1" WidthRequest="100" HorizontalOptions="Center" />
                        </Grid>
                        
                        <CollectionView x:Name="CustomersList" Margin="0" HeightRequest="450">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="2*, *, 2*, Auto" Padding="24,16">
                                        <HorizontalStackLayout Spacing="16">
                                            <Border HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" BackgroundColor="#E2E8F0">
                                                <Label Text="{Binding Initials}" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout VerticalOptions="Center">
                                                <Label Text="{Binding Username}" TextColor="#0F172A" FontSize="14" FontAttributes="Bold" />
                                                <Label Text="{Binding Email}" TextColor="#94A3B8" FontSize="12" />
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>
                                        <Border Grid.Column="1" BackgroundColor="#F0FDFA" Padding="12,4" StrokeShape="RoundRectangle 12" HorizontalOptions="Start" VerticalOptions="Center">
                                            <Label Text="{Binding Status}" TextColor="#0D9488" FontSize="10" FontAttributes="Bold" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                            <Label Text="Account Active" TextColor="#0F172A" FontSize="13" />
                                            <Label Text="{Binding LastActive}" TextColor="#94A3B8" FontSize="11" />
                                        </VerticalStackLayout>
                                        <HorizontalStackLayout Grid.Column="3" Spacing="16" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="✎" TextColor="#64748B" FontSize="18" />
                                            <Label Text="⋮" TextColor="#64748B" FontSize="20" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Grid ColumnDefinitions="*, Auto" Padding="24,20" BackgroundColor="#F8FAFC">
                            <Label Text="{Binding TotalCustomers, StringFormat='Showing 1 to 4 of {0} customers'}" TextColor="#64748B" FontSize="13" VerticalOptions="Center" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <Border BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" HeightRequest="36" WidthRequest="36">
                                    <Label Text="&lt;" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#64748B" />
                                </Border>
                                <Border BackgroundColor="#0D9488" StrokeShape="RoundRectangle 8" StrokeThickness="0" HeightRequest="36" WidthRequest="36">
                                    <Label Text="1" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontAttributes="Bold" />
                                </Border>
                                <Border BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" HeightRequest="36" WidthRequest="36">
                                    <Label Text="2" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#64748B" />
                                </Border>
                                <Border BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" HeightRequest="36" WidthRequest="36">
                                    <Label Text="3" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#64748B" />
                                </Border>
                                <Border BackgroundColor="White" StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="#E2E8F0" HeightRequest="36" WidthRequest="36">
                                    <Label Text="&gt;" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#64748B" />
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Label Text="© 2026 CreatiSphere Inc. All rights reserved. Professional Grade Sales Management." 
                       TextColor="#94A3B8" FontSize="11" HorizontalOptions="Center" Margin="0,0,0,20" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>


