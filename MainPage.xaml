<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CreatiSphere.MainPage"
             Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Background Layer with Gradient Overlay -->
        <Image Source="redesign_bg.png" Aspect="AspectFill" />
        <BoxView BackgroundColor="{StaticResource Slate900}" Opacity="0.4" Style="{x:Null}" />

        <ScrollView VerticalScrollBarVisibility="Never">
            <Grid Padding="40" HorizontalOptions="Fill" VerticalOptions="Center" MinimumHeightRequest="600">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Login Card -->
                <Border Grid.Column="1"
                        WidthRequest="500"
                        Padding="32,40"
                        StrokeShape="RoundRectangle 24"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource GlassBackground}"
                        VerticalOptions="Center">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,30" Radius="60" Opacity="0.4" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="24">
                        <!-- Brand Header -->
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Border BackgroundColor="{StaticResource DashboardTeal}"
                                    HeightRequest="64" WidthRequest="64"
                                    StrokeShape="RoundRectangle 16"
                                    HorizontalOptions="Center">
                                <Label Text="◈" TextColor="White" FontSize="40" 
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="CreatiSphere" 
                                   TextColor="{StaticResource Slate900}" 
                                   FontSize="28" FontAttributes="Bold" 
                                   HorizontalOptions="Center" />
                            <Label Text="Enter your credentials to access the console" 
                                   TextColor="{StaticResource Slate500}" 
                                   FontSize="16" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <!-- Form Fields -->
                        <VerticalStackLayout Spacing="20">
                            <!-- Email -->
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Email Address" TextColor="{StaticResource Slate900}" 
                                       FontSize="14" FontAttributes="Bold" />
                                <Border StrokeShape="RoundRectangle 16" 
                                        Stroke="{StaticResource Slate200}"
                                        BackgroundColor="{StaticResource InputBackground}"
                                        Padding="16,4" HeightRequest="52">
                                    <Grid ColumnDefinitions="24, *">
                                        <Path Data="M20,4H4C2.9,4,2,4.9,2,6v12c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V6C22,4.9,21.1,4,20,4z M20,18H4V8l8,5l8,-5V18z M12,11L4,6h16L12,11z"
                                              Fill="{StaticResource Slate400}" Aspect="Uniform"
                                              VerticalOptions="Center" />
                                         <Entry x:Name="UsernameEntry"
                                                Grid.Column="1" 
                                                Placeholder="admin@creatisphere.com" 
                                                TextColor="{StaticResource Slate900}"
                                                BackgroundColor="Transparent"
                                                Margin="16,0,0,0"
                                                VerticalOptions="Fill"
                                                HorizontalOptions="Fill" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- Password -->
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="Password" TextColor="{StaticResource Slate900}" 
                                           FontSize="14" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="Forgot password?" 
                                           TextColor="{StaticResource DashboardTeal}" 
                                           FontSize="13" FontAttributes="Bold" />
                                </Grid>
                                <Border StrokeShape="RoundRectangle 16" 
                                        Stroke="{StaticResource Slate200}"
                                        BackgroundColor="{StaticResource InputBackground}"
                                        Padding="16,4" HeightRequest="52">
                                    <Grid ColumnDefinitions="24, *, 24">
                                        <Path Data="M18,8h-1V6c0-2.8-2.2-5-5-5S7,3.2,7,6v2H6c-1.1,0-2,0.9-2,2v10c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V10C20,8.9,19.1,8,18,8z M9,6c0-1.7,1.3-3,3-3s3,1.3,3,3v2H9V6z M18,20H6V10h12V20z"
                                              Fill="{StaticResource Slate400}" Aspect="Uniform"
                                              VerticalOptions="Center" />
                                        <Entry x:Name="PasswordEntry"
                                               Grid.Column="1" 
                                               IsPassword="True"
                                               Placeholder="••••••••••••" 
                                               TextColor="{StaticResource Slate900}"
                                               BackgroundColor="Transparent"
                                               Margin="16,0,0,0"
                                               VerticalOptions="Fill"
                                               HorizontalOptions="Fill" />
                                        <Grid Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End" Padding="0" BackgroundColor="Transparent">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnTogglePasswordClicked" />
                                            </Grid.GestureRecognizers>
                                            <Path x:Name="EyeIconPath"
                                                  Data="M12,4.5C7,4.5,2.7,7.6,1,12c1.7,4.4,6,7.5,11,7.5s9.3-3.1,11-7.5C21.3,7.6,17,4.5,12,4.5z M12,17c-2.8,0-5-2.2-5-5s2.2-5,5-5s5,2.2,5,5S14.8,17,12,17z M12,9c-1.7,0-3,1.3-3,3s1.3,3,3,3s3-1.3,3-3S13.7,9,12,9z"
                                                  Fill="{StaticResource Slate400}" 
                                                  Aspect="Uniform" 
                                                  HeightRequest="20" WidthRequest="20" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        <!-- Remember Me & Extra Options -->
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <CheckBox x:Name="RememberMeCheckBox" Color="{StaticResource DashboardTeal}" VerticalOptions="Center" />
                                <Label Text="Remember me" TextColor="{StaticResource Slate900}" FontSize="14" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                        <!-- Action Button -->
                        <Button Text="Sign In" 
                                BackgroundColor="{StaticResource DashboardTeal}" 
                                TextColor="White" 
                                HeightRequest="56" 
                                CornerRadius="12" 
                                FontAttributes="Bold" 
                                FontSize="18"
                                Clicked="OnLoginClicked">
                            <Button.Shadow>
                                <Shadow Brush="{StaticResource DashboardTeal}" Offset="0,10" Radius="20" Opacity="0.5" />
                            </Button.Shadow>
                        </Button>

                        <!-- Footer -->
                        <VerticalStackLayout Spacing="16" Margin="0,8,0,0">
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                <Label Text="New admin?" TextColor="{StaticResource Slate500}" FontSize="15" />
                                <Label Text="Request access" TextColor="{StaticResource DashboardTeal}" 
                                       FontSize="15" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            
                            <HorizontalStackLayout HorizontalOptions="Center" Spacing="24">
                                <Label Text="Support" TextColor="{StaticResource Slate400}" FontSize="12" />
                                <Label Text="Security Policy" TextColor="{StaticResource Slate400}" FontSize="12" />
                                <Label Text="Status" TextColor="{StaticResource Slate400}" FontSize="12" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>
    </Grid>

</ContentPage>
